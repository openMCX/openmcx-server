#!/bin/sh
# Download one pinned archive during an image build and verify its SHA-256 (OpenMCX build tooling, no 3GPP behaviour).
#
#   fetch FILE URL SHA256 OUTPUT
#
# With DEPS_MIRROR set (docker build --build-arg DEPS_MIRROR=https://mirror.example/deps), FILE is taken from that
# mirror instead of URL, for offline or air-gapped builds. The versions, URLs and hashes are the build arguments of
# the Dockerfiles; tools/check-dependencies.py keeps them equal to dependencies.lock.json.
set -eu
file=$1 url=$2 sha256=$3 output=$4
if [ -n "${DEPS_MIRROR:-}" ]; then url="${DEPS_MIRROR%/}/$file"; fi
curl --fail --silent --show-error --location --retry 3 --output "$output" "$url"
echo "$sha256  $output" | sha256sum --check --strict -

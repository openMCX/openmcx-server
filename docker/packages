#!/bin/sh
# The Ubuntu packages of one image part, by Ubuntu release, for docker/Dockerfile.dev and docker/Dockerfile
# (docs/BUILD.md). Library package names follow each release's ABI (t64 names, libxml2-16, freeDiameter 7).
#   docker/packages <ubuntu release> <part>      e.g. docker/packages 26.04 mcptt
# Parts: dev, dev-autotools, dev-openh264, runtime, mcptt (also MCVideo), mcdata, common, http-proxy, user-db,
# kamailio (the SIP core's run-time libraries and nc for its health check), kamailio-dev (the build libraries of the
# SIP core's IMS modules that dev lacks).
set -eu
release=$1
part=$2

case "$release" in
24.04)
  xml=libxml2
  diameter="libfdcore6 libfdproto6"
  openh264=libopenh264-dev=2.4.1+dfsg-1
  ;;
26.04)
  xml=libxml2-16
  diameter="libfdcore7 libfdproto7"
  openh264=libopenh264-dev=2.6.0+dfsg-2build1
  ;;
*)
  echo "docker/packages: no package list for Ubuntu $release (24.04 or 26.04)" >&2
  exit 1
  ;;
esac

server="libcurl4t64 libnghttp2-14 $xml libsrtp2-1 libssl3t64 libuuid1"
case "$part" in
dev)
  echo build-essential cmake pkg-config ca-certificates curl bison flex \
    uuid-dev libssl-dev libxml2-dev libcurl4-openssl-dev libnghttp2-dev nlohmann-json3-dev \
    libopencore-amrwb-dev libvo-amrwbenc-dev libsrtp2-dev libsctp-dev \
    libfreediameter-dev libmariadb-dev libpcre2-dev libunistring-dev \
    python3 python3-pytest python3-yaml openssl ffmpeg espeak-ng tcpdump \
    iproute2 netcat-openbsd
  ;;
dev-autotools) echo autoconf automake libtool ;;
dev-openh264) echo "$openh264" ;;
runtime) echo ca-certificates curl python3 ;;
mcptt) echo "$server libsctp1 $diameter libopencore-amrwb0 libvo-amrwbenc0" ;;
mcdata) echo "$server" ;;
common) echo "$xml libsrtp2-1 libssl3t64" ;;
http-proxy) echo "$xml" ;;
user-db) echo "libsctp1 $diameter" ;;
kamailio) echo "ca-certificates libssl3t64 libcurl4t64 libmariadb3 netcat-openbsd $xml libgcrypt20 libmnl0" ;;
kamailio-dev) echo libmnl-dev ;;
*)
  echo "docker/packages: unknown part $part" >&2
  exit 1
  ;;
esac

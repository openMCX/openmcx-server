# The Ubuntu release (UBUNTU) and its pinned image (BASE_IMAGE) come from dependencies/lock.json; tools/build-images
# --ubuntu passes both. The package names of each release are in docker/packages.
ARG BASE_IMAGE=ubuntu:24.04@sha256:008173c23f95b170204355c12626cb5a965d779a7e1283b09e9cffbb1bf33ca3
FROM ${BASE_IMAGE}
ARG UBUNTU=24.04
ENV DEBIAN_FRONTEND=noninteractive
COPY docker/packages /usr/local/bin/packages
RUN apt-get update && apt-get install -y --no-install-recommends $(packages "$UBUNTU" dev) \
    && rm -rf /var/lib/apt/lists/*
# Pinned sources and toolchains, fetched and verified by the build (docker/fetch; DEPS_MIRROR for offline builds).
# tools/check-dependencies.py keeps these arguments equal to dependencies/lock.json.
ARG DEPS_MIRROR=
ARG GO_FILE=go1.27.1.linux-amd64.tar.gz
ARG GO_URL=https://go.dev/dl/go1.27.1.linux-amd64.tar.gz
ARG GO_SHA256=63d339f0da5ab53635a56f2490a7984dfe12dfcff22ad749f63edaf590168445
ARG RESIPROCATE_FILE=resiprocate-openmcx-1.14.0-1.tar.gz
ARG RESIPROCATE_URL=https://github.com/openMCX/resiprocate/archive/refs/tags/openmcx-1.14.0-1.tar.gz
ARG RESIPROCATE_SHA256=a04a018a1e6be6321f979b0aa9f3abb9c30daddf7936b5caa853db650a7dc1e8
ARG LIBSRTP_FILE=libsrtp-2.8.1.tar.gz
ARG LIBSRTP_URL=https://github.com/cisco/libsrtp/archive/6ff02afa8d2dc3f2e8896af391d137c1c66ff6fa.tar.gz
ARG LIBSRTP_SHA256=1ef3e6315e0ea3cd05f4980c8b5f7a9df369e3d586f5e0616e6cc4c778401d4c
ARG LIBSRTP_PATCH=0001-srtcp-index-zero.patch
ARG LIBSRTP_PATCH_SHA256=965965cd8718165a3617ebaf8e0744d79d9b7d367cf3eff25d5b60246168fc58
COPY docker/fetch /usr/local/bin/fetch
RUN fetch "$GO_FILE" "$GO_URL" "$GO_SHA256" /tmp/go.tar.gz \
    && tar -C /usr/local -xzf /tmp/go.tar.gz && rm /tmp/go.tar.gz
ENV PATH="/usr/local/go/bin:${PATH}"
# libsrtp from its pinned source with OpenMCX's patch (dependencies/libsrtp/README.md): the first SRTCP index is zero
# (RFC 3711 section 3.4). A static library in /usr/local, used by the OpenMCX programs; its licence is
# kept for the runtime images.
COPY dependencies/libsrtp/${LIBSRTP_PATCH} /tmp/libsrtp-patches/
RUN fetch "$LIBSRTP_FILE" "$LIBSRTP_URL" "$LIBSRTP_SHA256" /tmp/libsrtp.tar.gz \
    && echo "$LIBSRTP_PATCH_SHA256  /tmp/libsrtp-patches/$LIBSRTP_PATCH" | sha256sum --check --strict - \
    && mkdir /tmp/libsrtp && tar -xzf /tmp/libsrtp.tar.gz -C /tmp/libsrtp --strip-components=1 \
    && cd /tmp/libsrtp && patch -p1 --forward < /tmp/libsrtp-patches/$LIBSRTP_PATCH \
    && grep -q SRTP_OPENMCX_SRTCP_INDEX_ZERO include/srtp.h \
    && ./configure --prefix=/usr/local --enable-openssl CFLAGS='-O2 -fPIC' \
    && make -j4 && make install \
    && install -D -m 644 LICENSE /usr/local/share/doc/libsrtp/LICENSE \
    && rm -rf /tmp/libsrtp /tmp/libsrtp.tar.gz /tmp/libsrtp-patches
# reSIProcate from OpenMCX's fork, with its patches (dependencies/resiprocate/README.md), the SIP stack of the SIP
# engine: static rutil, resip and dum in /opt/resiprocate, found by CMakeLists.txt.
COPY dependencies/resiprocate/ /tmp/resiprocate/
RUN mkdir -p /tmp/resiprocate-work \
    && fetch "$RESIPROCATE_FILE" "$RESIPROCATE_URL" "$RESIPROCATE_SHA256" /tmp/resiprocate-work/$RESIPROCATE_FILE \
    && bash /tmp/resiprocate/build.sh /opt/resiprocate /tmp/resiprocate-work \
    && rm -rf /tmp/resiprocate /tmp/resiprocate-work
RUN apt-get update && apt-get install -y --no-install-recommends $(packages "$UBUNTU" dev-autotools) \
    && rm -rf /var/lib/apt/lists/*
# H.264 for MCVideo (TS 26.281 4.1.1): Cisco's BSD-licensed OpenH264 encoder and
# decoder, which the client uses for its test pattern and for decoding received video.
RUN apt-get update && apt-get install -y --no-install-recommends $(packages "$UBUNTU" dev-openh264) \
    && rm -rf /var/lib/apt/lists/*
WORKDIR /workspace
CMD ["bash"]

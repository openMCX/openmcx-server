+      qos_flow_item.setQosFlowLevelQosParameters(
+          get_qos_flow_level_qos_parameters(qos_flow));
+      qos_flow_list.addItem(qos_flow_item);
+    }
+    transfer.setQosFlowAddOrModifyRequestList(qos_flow_list);
+  }
+
+  uint8_t buffer[BUF_LEN];
+  int encoded_size = transfer.encode(buffer, BUF_LEN);
+  if (encoded_size < 0) {
+    Logger::smf_n2().warn(
+        "NGAP PDU Session Resource Modify Request Transfer encode failed");
+    return false;
+  }
+  // aper_encode_to_buffer returns the number of encoded bits
+  encoded_size = (encoded_size + 7) / 8;

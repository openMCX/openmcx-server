 #include "smf_pfcp_association.hpp"
 
+#include <set>
+
 #include "common_defs.h"
 #include "logger.hpp"
 #include "smf_n4.hpp"
@@ -1436,3 +1438,89 @@ uint8_t upf_graph::generate_qfi() {
 void upf_graph::release_qfi(uint8_t qfi) {
   qfi_generator.free_uid(qfi);
 }
+
+//---------------------------------------------------------------------------------------------
+std::shared_ptr<pfcp_association> upf_graph::get_upf_for_edge(
+    const std::shared_ptr<qos_upf_edge>& edge) const {
+  std::shared_lock graph_lock(graph_mutex);
+  for (const auto& [upf, edges] : adjacency_list) {
+    for (const auto& e : edges) {
+      if (e == edge) return upf;
+    }
+  }
+  return nullptr;
+}
+
+//---------------------------------------------------------------------------------------------
+size_t upf_graph::get_upf_count() const {
+  std::shared_lock graph_lock(graph_mutex);
+  return adjacency_list.size();
+}
+
+//---------------------------------------------------------------------------------------------
+uint8_t upf_graph::allocate_qfi() {
+  std::set<uint8_t> used;
+  for (const auto& edge : get_access_edges()) {
+    used.insert(edge->qfi.qfi);
+  }
+  std::unique_lock graph_lock(graph_mutex);
+  // QFI range is 1..63 (TS 38.415)
+  for (int i = 0; i < 64; i++) {
+    uint8_t qfi = qfi_generator.get_uid();
+    if (qfi >= 1 && qfi <= 63 && used.count(qfi) == 0) {
+      qfi_count++;
+      return qfi;
+    }
+  }
+  return 0;
+}
+
+//---------------------------------------------------------------------------------------------
+void upf_graph::free_qfi(uint8_t qfi) {
+  std::unique_lock graph_lock(graph_mutex);
+  qfi_generator.free_uid(qfi);
+  if (qfi_count > 0) qfi_count--;
+}
+
+//---------------------------------------------------------------------------------------------
+void upf_graph::add_qos_flow_edges(
+    const std::shared_ptr<pfcp_association>& upf,
+    const std::shared_ptr<qos_upf_edge>& n3_edge,
+    const std::shared_ptr<qos_upf_edge>& n6_edge) {
+  n3_edge->associated_edge = n6_edge;
+  n6_edge->associated_edge = n3_edge;
+  add_upf_graph_edge(upf, n3_edge);
+  add_upf_graph_edge(upf, n6_edge);
+  std::unique_lock graph_lock(graph_mutex);
+  access_edge_count++;
+  exit_edge_count++;
+  total_edge_count += 2;
+  associated_edge_count += 2;
+}
+
+//---------------------------------------------------------------------------------------------
+std::vector<std::shared_ptr<qos_upf_edge>> upf_graph::remove_qos_flow_edges(
+    uint8_t qfi) {
+  std::vector<std::shared_ptr<qos_upf_edge>> removed;
+  std::unique_lock graph_lock(graph_mutex);
+  UPInterfaceType n3_type;
+  n3_type.setEnumValue(UPInterfaceType_anyOf::eUPInterfaceType_anyOf::N3);
+  for (auto& [upf, edges] : adjacency_list) {
+    for (auto it = edges.begin(); it != edges.end();) {
+      if ((*it)->qfi.qfi == qfi) {
+        if ((*it)->type == n3_type) {
+          if (access_edge_count > 0) access_edge_count--;
+        } else {
+          if (exit_edge_count > 0) exit_edge_count--;
+        }
+        if (total_edge_count > 0) total_edge_count--;
+        if (associated_edge_count > 0) associated_edge_count--;
+        removed.push_back(*it);
+        it = edges.erase(it);
+      } else {
+        ++it;
+      }
+    }
+  }
+  return removed;
+}

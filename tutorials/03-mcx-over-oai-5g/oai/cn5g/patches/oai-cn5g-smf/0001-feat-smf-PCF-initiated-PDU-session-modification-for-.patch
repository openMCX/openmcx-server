+//------------------------------------------------------------------------------
+bool smf_context::handle_pcf_initiated_policy_update(
+    std::shared_ptr<itti_sbi_update_sm_context_request>& smreq,
+    std::shared_ptr<itti_sbi_update_sm_context_response>& sm_context_resp,
+    std::shared_ptr<smf_pdu_session>& sp) {
+  Logger::smf_app().info(
+      "Handle PCF-initiated SM Policy Association Modification (PDU session "
+      "ID %d)",
+      sp->get_pdu_session_id());
+
+  if (!sp->policy_ptr) {
+    Logger::smf_app().warn(
+        "PDU session has no SM policy association, ignore the notification");
+    smf_app_inst->trigger_http_response(
+        http_status_code::NOT_FOUND, smreq->pid,
+        N11_SESSION_UPDATE_SM_CONTEXT_RESPONSE);
+    return true;
+  }
+
+  nlohmann::json notification = {};
+  smreq->req.get_json_data(notification);
+  nlohmann::json decision_json = nlohmann::json::object();
+  if (notification.contains("smPolicyDecision") &&
+      notification["smPolicyDecision"].is_object()) {
+    decision_json = notification["smPolicyDecision"];
+  }
+  Logger::smf_app().debug(
+      "SmPolicyDecision received from PCF: %s", decision_json.dump());
+
+  auto sh = sp->get_session_handler();
+  oai::model::pcf::SmPolicyDecision& decision = sp->policy_ptr->decision;
+  const oai::model::pcf::SmPolicyDecision old_decision = decision;
+
+  auto old_rules = decision.getPccRules();
+  auto rules     = old_rules;
+  auto qos_decs  = decision.getQosDecs();
+  std::set<std::string> changed_qos_ids;
+  pcf_policy_change change;
+
+  try {
+    // QoS decisions (null = removed, TS 29.512)
+    if (decision_json.contains("qosDecs") &&
+        decision_json["qosDecs"].is_object()) {
+      for (const auto& [id, value] : decision_json["qosDecs"].items()) {
+        if (value.is_null()) {
+          qos_decs.erase(id);
+        } else {
+          qos_decs[id] = value.get<oai::model::pcf::QosData>();
+        }
+        changed_qos_ids.insert(id);
+      }
+    }
+
+    std::map<std::string, oai::model::pcf::PccRule> updated_rules;
+    if (decision_json.contains("pccRules") &&
+        decision_json["pccRules"].is_object()) {
+      for (const auto& [id, value] : decision_json["pccRules"].items()) {
+        if (value.is_null()) {
+          rules.erase(id);
+          auto qfi = sh->get_dynamic_flow(id);
+          if (qfi.has_value()) {
+            pcf_qos_flow_change c;
+            c.pcc_rule_id = id;
+            c.qfi         = qfi.value();
+            change.to_release.push_back(c);
+          } else {
+            Logger::smf_app().info(
+                "Removal of PCC rule %s ignored: no dynamic QoS flow", id);
+          }
+        } else {
+          auto rule          = value.get<oai::model::pcf::PccRule>();
+          rules[id]          = rule;
+          updated_rules[id] = rule;
+        }
+      }
+    }
+
+    // rules whose QoS decision changed (without the rule itself being sent)
+    for (const auto& [id, qfi] : sh->get_dynamic_flows()) {
+      if (updated_rules.count(id) > 0 || rules.count(id) == 0) continue;
+      const auto& rule = rules[id];
+      if (!rule.getRefQosData().empty() &&
+          changed_qos_ids.count(rule.getRefQosData()[0]) > 0) {
+        updated_rules[id] = rule;
+      }
+    }
+
+    for (const auto& [id, rule] : updated_rules) {
+      if (rule.getRefQosData().empty() ||
+          qos_decs.count(rule.getRefQosData()[0]) == 0) {
+        Logger::smf_app().warn(
+            "PCC rule %s does not reference a known QoS decision, ignored", id);
+        continue;
+      }
+      const auto& qos = qos_decs[rule.getRefQosData()[0]];
+      auto qfi        = sh->get_dynamic_flow(id);
+
+      if (qfi.has_value()) {
+        // existing dynamic QoS flow
+        bool flows_changed =
+            old_rules.count(id) == 0 ||
+            !(old_rules[id].getFlowInfos() == rule.getFlowInfos()) ||
+            old_rules[id].getPrecedence() != rule.getPrecedence();
+        if (flows_changed) {
+          // packet filters changed: release and re-create the QoS flow
+          pcf_qos_flow_change rel;
+          rel.pcc_rule_id = id;
+          rel.qfi         = qfi.value();
+          change.to_release.push_back(rel);
+          pcf_qos_flow_change add;
+          add.pcc_rule_id = id;
+          add.pcc_rule    = rule;
+          add.qos         = qos;
+          change.to_add.push_back(add);
+        } else {
+          auto edges = sh->get_access_edges_for_qfi(qfi.value());
+          if (!edges.empty() && edges[0]->qos_profile == qos) {
+            Logger::smf_app().debug("PCC rule %s unchanged", id);
+            continue;
+          }
+          pcf_qos_flow_change mod;
+          mod.pcc_rule_id = id;
+          mod.pcc_rule    = rule;
+          mod.qos         = qos;
+          mod.qfi         = qfi.value();
+          change.to_modify.push_back(mod);
+        }
+      } else if (old_rules.count(id) > 0) {
+        Logger::smf_app().info(
+            "PCC rule %s was installed at PDU session establishment, "
+            "modification is not supported, ignored",
+            id);
+      } else {
+        // new PCC rule -> new QoS flow
+        bool has_filter = false;
+        for (const auto& flow : rule.getFlowInfos()) {
+          if (flow.flowDescriptionIsSet() &&
+              flow.getFlowDescription() != DEFAULT_FLOW_DESCRIPTION) {
+            has_filter = true;
+          }
+        }
+        if (!has_filter) {
+          Logger::smf_app().warn(
+              "PCC rule %s has no specific flow description, no dedicated QoS "
+              "flow created",
+              id);
+          continue;
+        }
+        pcf_qos_flow_change add;
+        add.pcc_rule_id = id;
+        add.pcc_rule    = rule;
+        add.qos         = qos;
+        change.to_add.push_back(add);
+      }
+    }
+
+    // Traffic control / session rules: stored only
+    if (decision_json.contains("traffContDecs") &&
+        decision_json["traffContDecs"].is_object()) {
+      auto tcs = decision.getTraffContDecs();
+      for (const auto& [id, value] : decision_json["traffContDecs"].items()) {
+        if (value.is_null()) {
+          tcs.erase(id);
+        } else {
+          tcs[id] = value.get<oai::model::pcf::TrafficControlData>();
+        }
+      }
+      decision.setTraffContDecs(tcs);
+    }
+  } catch (std::exception& e) {
+    Logger::smf_app().warn(
+        "Cannot process the SM policy decision from the PCF: %s", e.what());
+    decision = old_decision;
+    smf_app_inst->trigger_http_response(
+        http_status_code::BAD_REQUEST, smreq->pid,
+        N11_SESSION_UPDATE_SM_CONTEXT_RESPONSE);
+    return true;
+  }
+
+  decision.setPccRules(rules);
+  decision.setQosDecs(qos_decs);
+
+  if (change.empty()) {
+    Logger::smf_app().info(
+        "PCF-initiated modification: no QoS flow change for this PDU session");
+    smf_app_inst->trigger_http_response(
+        http_status_code::OK, smreq->pid,
+        N11_SESSION_UPDATE_SM_CONTEXT_RESPONSE);
+    return true;
+  }
+
+  auto proc = std::make_shared<session_update_sm_context_procedure>(sp);
+  std::shared_ptr<smf_procedure> sproc = proc;
+  proc->session_procedure_type         = session_management_procedures_type_e::
+      PDU_SESSION_MODIFICATION_PCF_INITIATED;
+  proc->pcf_change = change;
+  insert_procedure(sproc);
+  if (proc->run(smreq, sm_context_resp, shared_from_this()) ==
+      smf_procedure_code::ERROR) {
+    Logger::smf_app().warn("PCF-initiated PDU Session Modification failed");
+    remove_procedure(sproc.get());
+    decision = old_decision;
+    smf_app_inst->trigger_http_response(
+        http_status_code::INTERNAL_SERVER_ERROR, smreq->pid,
+        N11_SESSION_UPDATE_SM_CONTEXT_RESPONSE);
+  }
+  return true;
+}

+    Ngap_PDUSessionResourceModifyRequestTransfer_t* asn_msg = nullptr;
+    asn_dec_rval_t rc                                        = asn_decode(
+        nullptr, ATS_ALIGNED_CANONICAL_PER,
+        &asn_DEF_Ngap_PDUSessionResourceModifyRequestTransfer,
+        (void**) &asn_msg, buffer, encoded_size);
+    if (rc.code != RC_OK || !asn_msg) {
+      Logger::smf_n2().warn("Cannot decode PDU Session Resource Modify Request "
+                            "Transfer to add the QoS Flow to Release List");
+      ASN_STRUCT_FREE(
+          asn_DEF_Ngap_PDUSessionResourceModifyRequestTransfer, asn_msg);
+      return false;

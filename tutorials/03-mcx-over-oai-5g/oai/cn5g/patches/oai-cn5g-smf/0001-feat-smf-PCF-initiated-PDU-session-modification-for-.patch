+  msg.get_all_qos_flow_context_updateds(qos_flows);
+  if (!qos_flows.empty()) {
+    QosFlowAddOrModifyRequestList qos_flow_list = {};
+    for (const auto& [qfi, qos_flow] : qos_flows) {
+      if ((qfi < QOS_FLOW_IDENTIFIER_FIRST) or

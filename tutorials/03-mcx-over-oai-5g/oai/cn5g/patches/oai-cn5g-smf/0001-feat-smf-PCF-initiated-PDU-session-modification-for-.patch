+    // add QoS rule(s) to flow. A dynamic QoS flow (PCF-initiated) may consist
+    // of several access edges with the same QFI (one per flow information of
+    // the PCC rule): one QoS rule with one packet filter is created per edge
+    // (TS 24.501 allows several QoS rules per QoS flow)
+    std::vector<std::shared_ptr<qos_upf_edge>> rule_edges = {edge};
+    if (!edge->default_qos) {
+      for (const auto& other : get_access_edges_for_qfi(edge->qfi.qfi)) {
+        if (other != edge && !other->default_qos) rule_edges.push_back(other);
+      }
+    }
+    for (const auto& rule_edge : rule_edges) {
+      auto rule = qos_rule_from_edge(rule_edge);
+      if (rule.GetNumberOfPacketFilters() != 0) {
+        flow.add_qos_rule(rule);
+      } else {
+        Logger::smf_n1().warn(
+            "QoS rule %u does not have a packet filter. This rule is not sent "
+            "to UE (NAS). Please set packetFilterUsage to true in the PCC "
+            "rules.",
+            rule_edge->qos_rule_id);
+      }

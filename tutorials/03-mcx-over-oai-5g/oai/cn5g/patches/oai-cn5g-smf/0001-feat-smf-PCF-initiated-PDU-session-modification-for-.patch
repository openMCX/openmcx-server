+    uint8_t qfi = graph->allocate_qfi();
+    if (qfi == 0) {
+      Logger::smf_app().warn("No QFI available for PCC rule %s",
+                             change.pcc_rule_id.c_str());
+      return smf_procedure_code::ERROR;
+    }
+    change.qfi = qfi;
+    pcf_added_qfis.push_back(qfi);
+
+    pfcp::qer_id_t ul_qer = {};
+    pfcp::qer_id_t dl_qer = {};
+    for (auto flow : change.pcc_rule.getFlowInfos()) {
+      if (!flow.flowDirectionIsSet()) {
+        FlowDirectionRm flow_direction;
+        flow_direction.setEnumValue(
+            FlowDirection_anyOf::eFlowDirection_anyOf::BIDIRECTIONAL);
+        flow.setFlowDirection(flow_direction);
+      }
+      auto n3 = std::make_shared<qos_upf_edge>(*template_n3);
+      auto n6 = std::make_shared<qos_upf_edge>(*template_n6);
+      for (const auto& edge : {n3, n6}) {
+        edge->qfi.qfi              = qfi;
+        edge->qos_profile          = change.qos;
+        edge->flow_information     = flow;
+        edge->precedence           = change.pcc_rule.getPrecedence();
+        edge->default_qos          = false;
+        edge->correlation_id       = change.pcc_rule_id;
+        edge->redirect_information = {};
+        edge->pdr_id               = {};
+        edge->far_id               = {};
+        edge->qer_id               = {};
+        edge->qos_rule_id          = 0;
+        edge->n4_update_necessary  = false;
+      }
+      // N3 edge keeps the UPF N3 F-TEID (fteid) and the gNB F-TEID
+      // (next_hop_fteid) of the PDU session: same N3 tunnel, new QFI
+      n3->qer_id = dl_qer;
+      n6->qer_id = ul_qer;
+      graph->add_qos_flow_edges(upf, n3, n6);
+
+      bool ul = session_handler::is_uplink_flow_direction(flow);
+      bool dl = session_handler::is_downlink_flow_direction(flow);
+      if (ul) {
+        // UL: PDR (source access, F-TEID + QFI + SDF) -> FAR/QER on N6 edge
+        n4_triggered->pfcp_ies.set(pfcp_create_far(n6));
+        if (upf_cfg.enable_qers() && ul_qer.qer_id == 0) {
+          n4_triggered->pfcp_ies.set(pfcp_create_qer(n6));
+          ul_qer = n6->qer_id;
+        }
+        n4_triggered->pfcp_ies.set(pfcp_create_pdr(n3));
+      }
+      if (dl) {
+        // DL: PDR (source core, UE IP + SDF) -> FAR (GTP-U to gNB, QFI) / QER
+        n4_triggered->pfcp_ies.set(create_dl_far(n3));
+        if (upf_cfg.enable_qers() && dl_qer.qer_id == 0) {
+          n4_triggered->pfcp_ies.set(pfcp_create_qer(n3));
+          dl_qer = n3->qer_id;
+        }
+        n4_triggered->pfcp_ies.set(pfcp_create_pdr(n6));
+      }
+      Logger::smf_app().info(
+          "Add QoS flow QFI %d (PCC rule %s, precedence %d): %s [UL %d, DL "
+          "%d]",
+          qfi, change.pcc_rule_id.c_str(), n3->precedence,
+          flow.getFlowDescription().c_str(), ul, dl);
+    }
+  }
+
+  graph->print_graph();
+
+  Logger::smf_app().info(
+      "Sending ITTI message %s to task TASK_SMF_N4",
+      n4_triggered->get_msg_name());
+  int ret = itti_inst->send_msg(n4_triggered);
+  if (RETURNok != ret) {
+    Logger::smf_app().error(
+        "Could not send ITTI message %s to task TASK_SMF_N4",
+        n4_triggered->get_msg_name());
+    return smf_procedure_code::ERROR;
+  }
+  return smf_procedure_code::OK;
+}
+
+//------------------------------------------------------------------------------
+smf_procedure_code
+session_update_sm_context_procedure::handle_pcf_initiated_n4_response(
+    itti_n4_session_modification_response& resp,
+    const std::shared_ptr<oai::app::smf::smf_context>& sc) {
+  pfcp::cause_t cause = {};
+  resp.pfcp_ies.get(cause);
+  auto sh    = sps->get_session_handler();
+  auto graph = sh->get_session_graph();
+
+  auto release_edges = [&](uint8_t qfi) {
+    if (!graph) return;
+    std::set<uint32_t> released_qers;
+    for (const auto& edge : graph->remove_qos_flow_edges(qfi)) {
+      if (edge->pdr_id.rule_id != 0) sh->release_pdr_id(edge->pdr_id);
+      if (edge->far_id.far_id != 0) sh->release_far_id(edge->far_id);
+      if (edge->qer_id.qer_id != 0 &&
+          released_qers.count(edge->qer_id.qer_id) == 0) {
+        sh->release_qer_id(edge->qer_id);
+        released_qers.insert(edge->qer_id.qer_id);
+      }
+      if (edge->qos_rule_id != 0) sh->free_qos_rule_id(edge->qos_rule_id);
+    }
+    graph->free_qfi(qfi);
+  };
+
+  if (cause.cause_value != CAUSE_VALUE_REQUEST_ACCEPTED) {
+    Logger::smf_app().warn(
+        "PCF-initiated PDU Session Modification: N4 Session Modification "
+        "rejected by the UPF (cause %d), rolling back",
+        cause.cause_value);
+    for (const auto& qfi : pcf_added_qfis) release_edges(qfi);
+    n11_triggered_pending->res.set_cause(k5gsmCauseRequestRejectedUnspecified);
+    n11_triggered_pending->res.set_http_code(
+        oai::common::sbi::http_status_code::INTERNAL_SERVER_ERROR);
+    return smf_procedure_code::ERROR;
+  }
+
+  // QoS flows released: remove the edges from the graph
+  for (const auto& change : pcf_change.to_release) {
+    release_edges(change.qfi);
+    sh->remove_dynamic_flow(change.pcc_rule_id);
+  }
+  for (const auto& change : pcf_change.to_add) {
+    sh->add_dynamic_flow(change.pcc_rule_id, change.qfi);
+  }
+
+  n11_triggered_pending->res.set_cause(k5gsmCauseRequestAccepted);
+  n11_triggered_pending->res.set_http_code(
+      oai::common::sbi::http_status_code::OK);
+
+  // Steps 3-4 of TS 23.502 4.3.3.2: Namf_Communication_N1N2MessageTransfer
+  // (N2 PDU Session Resource Modify Request Transfer, N1 PDU Session
+  // Modification Command)
+  sc->trigger_pcf_initiated_n1n2_message_transfer(sps, pcf_change);
+
+  return smf_procedure_code::OK;
+}

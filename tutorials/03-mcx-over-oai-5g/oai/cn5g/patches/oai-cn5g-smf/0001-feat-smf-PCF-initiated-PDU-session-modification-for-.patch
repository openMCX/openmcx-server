+//------------------------------------------------------------------------------
+smf_procedure_code session_update_sm_context_procedure::run_pcf_initiated(
+    const std::shared_ptr<oai::app::smf::smf_context>& sc) {
+  Logger::smf_app().info(
+      "PCF-initiated PDU Session Modification: %d QoS flow(s) to add, %d to "
+      "modify, %d to release",
+      (int) pcf_change.to_add.size(), (int) pcf_change.to_modify.size(),
+      (int) pcf_change.to_release.size());
+
+  auto sh    = sps->get_session_handler();
+  auto graph = sh->get_session_graph();
+  if (!graph) {
+    Logger::smf_app().warn("PDU session does not have a UPF graph");
+    return smf_procedure_code::ERROR;
+  }
+
+  UPInterfaceType n6_type;
+  n6_type.setEnumValue(UPInterfaceType_anyOf::eUPInterfaceType_anyOf::N6);
+
+  // The new QoS flows are cloned from the default QoS flow (same N3 tunnel,
+  // same UPF), only the QFI, QoS profile and packet filters differ
+  auto template_n3 = sh->get_default_access_edge();
+  if (!template_n3 || !template_n3->associated_edge) {
+    Logger::smf_app().warn("PDU session has no (associated) access edge");
+    return smf_procedure_code::ERROR;
+  }
+  auto template_n6 = template_n3->associated_edge;
+  if (!(template_n6->type == n6_type) || graph->get_upf_count() != 1) {
+    Logger::smf_app().warn(
+        "PCF-initiated QoS flows are only supported for PDU sessions served by "
+        "a single UPF (N3 <-> N6)");
+    return smf_procedure_code::ERROR;
+  }
+  auto upf = graph->get_upf_for_edge(template_n3);
+  if (!upf) {
+    Logger::smf_app().warn("Cannot find the UPF of the PDU session");
+    return smf_procedure_code::ERROR;
+  }
+  oai::config::smf::upf upf_cfg = upf->get_upf_config();
+
+  n4_triggered = std::make_shared<itti_n4_session_modification_request>(
+      TASK_SMF_APP, TASK_SMF_N4);
+  n4_triggered->seid    = sps->up_fseid.seid;
+  n4_triggered->trxn_id = this->trxn_id;
+  n4_triggered->r_endpoint =
+      endpoint(upf->node_id.u1.ipv4_address, pfcp::default_port);
+
+  // FAR towards the access network (DL), always forwarding (the option
+  // enable_dl_pdr_in_session_establishment only applies to the establishment)
+  auto create_dl_far = [&](const std::shared_ptr<qos_upf_edge>& edge) {
+    pfcp::create_far create_far = pfcp_create_far(edge);
+    if (upf_cfg.enable_dl_pdr_in_session_establishment()) {
+      pfcp::create_far far              = {};
+      pfcp::apply_action_t apply_action = {};
+      apply_action.forw                 = 1;
+      pfcp::forwarding_parameters forwarding_parameters   = {};
+      pfcp::destination_interface_t destination_interface = {};
+      destination_interface.interface_value = pfcp::INTERFACE_VALUE_ACCESS;
+      forwarding_parameters.set(destination_interface);
+      if (!edge->nw_instance.empty()) {
+        pfcp::network_instance_t network_instance = {};
+        network_instance.network_instance         = edge->nw_instance;
+        forwarding_parameters.set(network_instance);
+      }
+      pfcp::outer_header_creation_t outer_header_creation = {};
+      if (pfcp_outer_header_creation(edge, outer_header_creation)) {
+        forwarding_parameters.set(outer_header_creation);
+      }
+      far.set(edge->far_id);
+      far.set(apply_action);
+      far.set(forwarding_parameters);
+      return far;
+    }
+    return create_far;
+  };
+
+  //-------------------
+  // QoS flows to be released: remove PDRs, FARs, QERs
+  //-------------------
+  for (auto& change : pcf_change.to_release) {
+    std::set<uint32_t> removed_qers;
+    for (const auto& n3 : sh->get_access_edges_for_qfi(change.qfi)) {
+      if (n3->qos_rule_id != 0) change.qos_rule_ids.push_back(n3->qos_rule_id);
+      for (const auto& edge : {n3, n3->associated_edge}) {
+        if (!edge) continue;
+        if (edge->pdr_id.rule_id != 0) {
+          n4_triggered->pfcp_ies.set(pfcp_remove_pdr(edge));
+        }
+        if (edge->far_id.far_id != 0) {
+          n4_triggered->pfcp_ies.set(pfcp_remove_far(edge));
+        }
+        if (edge->qer_id.qer_id != 0 &&
+            removed_qers.count(edge->qer_id.qer_id) == 0) {
+          n4_triggered->pfcp_ies.set(pfcp_remove_qer(edge));
+          removed_qers.insert(edge->qer_id.qer_id);
+        }
+      }
+    }
+    Logger::smf_app().info(
+        "Release QoS flow QFI %d (PCC rule %s)", change.qfi,
+        change.pcc_rule_id.c_str());
+  }
+
+  //-------------------
+  // QoS flows to be modified: update the QoS profile and the QERs
+  //-------------------
+  for (auto& change : pcf_change.to_modify) {
+    std::set<uint32_t> updated_qers;
+    for (const auto& n3 : sh->get_access_edges_for_qfi(change.qfi)) {
+      for (const auto& edge : {n3, n3->associated_edge}) {
+        if (!edge) continue;
+        edge->qos_profile = change.qos;
+        if (upf_cfg.enable_qers() && edge->qer_id.qer_id != 0 &&
+            updated_qers.count(edge->qer_id.qer_id) == 0) {
+          n4_triggered->pfcp_ies.set(pfcp_update_qer(edge));
+          updated_qers.insert(edge->qer_id.qer_id);
+        }
+      }
+    }
+    Logger::smf_app().info(
+        "Modify QoS flow QFI %d (PCC rule %s): 5QI %d, ARP %d", change.qfi,
+        change.pcc_rule_id.c_str(), change.qos.getR5qi(),
+        change.qos.getArp().getPriorityLevel());
+  }
+
+  //-------------------
+  // QoS flows to be added: new edges (one N3/N6 pair per flow information),
+  // PDRs/FARs/QERs
+  //-------------------

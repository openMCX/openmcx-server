     }
   }
 
+  // dynamic QoS flow (PCF-initiated) with several flow informations: all the
+  // edges share the same QoS profile, use the first one
+  if (!qfi_edges.empty()) {
+    return qfi_edges[0];
+  }
+
+  return nullptr;
+}
+
+//------------------------------------------------------------------------------
+void session_handler::add_dynamic_flow(
+    const std::string& pcc_rule_id, uint8_t qfi) {
+  std::unique_lock lock(m_session_handler_mutex);
+  m_dynamic_flows[pcc_rule_id] = qfi;
+}
+
+//------------------------------------------------------------------------------
+std::optional<uint8_t> session_handler::get_dynamic_flow(
+    const std::string& pcc_rule_id) {
+  std::shared_lock lock(m_session_handler_mutex);
+  auto it = m_dynamic_flows.find(pcc_rule_id);
+  if (it == m_dynamic_flows.end()) return std::nullopt;
+  return it->second;
+}
+
+//------------------------------------------------------------------------------
+void session_handler::remove_dynamic_flow(const std::string& pcc_rule_id) {
+  std::unique_lock lock(m_session_handler_mutex);
+  m_dynamic_flows.erase(pcc_rule_id);
+}
+
+//------------------------------------------------------------------------------
+std::map<std::string, uint8_t> session_handler::get_dynamic_flows() {
+  std::shared_lock lock(m_session_handler_mutex);
+  return m_dynamic_flows;
+}
+
+//------------------------------------------------------------------------------
+std::vector<std::shared_ptr<qos_upf_edge>>
+session_handler::get_access_edges_for_qfi(uint8_t qfi) {
+  std::vector<std::shared_ptr<qos_upf_edge>> edges;
+  if (!m_session_graph) return edges;
+  for (const auto& edge : m_session_graph->get_access_edges()) {
+    if (edge->qfi.qfi == qfi) edges.push_back(edge);
+  }
+  return edges;
+}
+
+//------------------------------------------------------------------------------
+std::shared_ptr<qos_upf_edge> session_handler::get_default_access_edge() {
+  if (!m_session_graph) return nullptr;
+  auto edges = m_session_graph->get_access_edges();
+  for (const auto& edge : edges) {
+    if (edge->default_qos) return edge;
+  }
+  if (!edges.empty()) return edges[0];
   return nullptr;
 }
 
+//------------------------------------------------------------------------------
+uint8_t session_handler::allocate_qos_rule_id() {
+  return generate_qos_rule_id();
+}
+
+//------------------------------------------------------------------------------
+void session_handler::free_qos_rule_id(uint8_t rule_id) {
+  release_qos_rule_id(rule_id);
+}

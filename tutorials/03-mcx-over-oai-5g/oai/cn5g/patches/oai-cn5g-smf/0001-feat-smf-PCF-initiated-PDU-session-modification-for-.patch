+    auto* ie = (Ngap_PDUSessionResourceModifyRequestTransferIEs_t*) calloc(
+        1, sizeof(Ngap_PDUSessionResourceModifyRequestTransferIEs_t));
+    ie->id          = Ngap_ProtocolIE_ID_id_QosFlowToReleaseList;
+    ie->criticality = Ngap_Criticality_reject;
+    ie->value.present =
+        Ngap_PDUSessionResourceModifyRequestTransferIEs__value_PR_QosFlowListWithCause;
+    if (!release_list.encode(ie->value.choice.QosFlowListWithCause) ||
+        ASN_SEQUENCE_ADD(&asn_msg->protocolIEs.list, ie) != 0) {
+      Logger::smf_n2().warn("Cannot encode the QoS Flow to Release List");
+      ASN_STRUCT_FREE(
+          asn_DEF_Ngap_PDUSessionResourceModifyRequestTransfer, asn_msg);
+      return false;
+    }
+
+    asn_enc_rval_t er = aper_encode_to_buffer(
+        &asn_DEF_Ngap_PDUSessionResourceModifyRequestTransfer, nullptr,
+        asn_msg, buffer, BUF_LEN);
+    ASN_STRUCT_FREE(
+        asn_DEF_Ngap_PDUSessionResourceModifyRequestTransfer, asn_msg);
+    if (er.encoded < 0) {
+      Logger::smf_n2().warn(
+          "NGAP PDU Session Resource Modify Request Transfer (with QoS Flow to "
+          "Release List) encode failed");
+      return false;
+    }
+    encoded_size = (er.encoded + 7) / 8;
+  }
 
+  oai::utils::output_wrapper::print_buffer(
+      {}, "N2 SM Buffer Data:", buffer, encoded_size);
+  ngap_msg_str.assign((char*) buffer, encoded_size);
   return true;
 }
 

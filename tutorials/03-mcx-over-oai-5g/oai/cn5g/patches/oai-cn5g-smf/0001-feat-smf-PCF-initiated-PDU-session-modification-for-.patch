+//------------------------------------------------------------------------------
+void smf_context::trigger_pcf_initiated_n1n2_message_transfer(
+    const std::shared_ptr<smf_pdu_session>& sp,
+    const pcf_policy_change& change) {
+  Logger::smf_app().info(
+      "PCF-initiated PDU Session Modification: send N1N2MessageTransfer");
+
+  std::shared_ptr<itti_nx_trigger_pdu_session_modification> itti_msg =
+      std::make_shared<itti_nx_trigger_pdu_session_modification>(
+          TASK_SMF_APP, TASK_SMF_SBI);
+  itti_msg->http_version = smf_cfg->get_http_version();
+  auto& msg              = itti_msg->msg;
+  msg.set_supi(supi);
+  msg.set_dnn(sp->get_dnn());
+  msg.set_pdu_session_id(sp->get_pdu_session_id());
+  msg.set_snssai(sp->get_snssai());
+  msg.pcf_initiated = true;
+  // network-initiated procedure: no procedure transaction identity assigned
+  procedure_transaction_id_t pti = {};
+  pti.procedure_transaction_id   = 0;
+  msg.set_pti(pti);
+
+  auto sh = sp->get_session_handler();
+  for (const auto& c : change.to_add) {
+    pfcp::qfi_t qfi(c.qfi);
+    msg.add_qfi(qfi);
+    msg.add_qos_flow_context_updated(sh->build_qos_flow_context(qfi));
+  }
+  for (const auto& c : change.to_modify) {
+    pfcp::qfi_t qfi(c.qfi);
+    msg.add_qfi(qfi);
+    msg.qfis_modified.insert(c.qfi);
+    msg.add_qos_flow_context_updated(sh->build_qos_flow_context(qfi));
+  }
+  for (const auto& c : change.to_release) {
+    // a released + re-added rule (packet filter change) is both in to_release
+    // and to_add with different QFIs
+    msg.qfis_to_release.push_back(c.qfi);
+    for (const auto& rule_id : c.qos_rule_ids) {
+      msg.qos_rules_to_delete.push_back(std::make_pair(rule_id, c.qfi));
+    }
+  }
+
+  std::string n1_sm_msg, n1_sm_msg_hex, n2_sm_info, n2_sm_info_hex;
+  // N1: PDU SESSION MODIFICATION COMMAND (PTI 0: network-initiated)
+  if (!smf_n1::get_instance().create_n1_pdu_session_modification_command(
+          msg, n1_sm_msg, k5gsmCauseRegularDeactivation)) {
+    Logger::smf_app().warn("Cannot create PDU Session Modification Command");
+  }
+  conv::convert_string_2_hex(n1_sm_msg, n1_sm_msg_hex);
+  msg.set_n1_sm_message(n1_sm_msg_hex);
+
+  // N2: PDU Session Resource Modify Request Transfer
+  if (!smf_n2::get_instance()
+           .create_n2_pdu_session_resource_modify_request_transfer(
+               msg, n2_sm_info_type_e::PDU_RES_MOD_REQ, n2_sm_info)) {
+    Logger::smf_app().warn(
+        "Cannot create PDU Session Resource Modify Request Transfer");
+    return;
+  }
+  conv::convert_string_2_hex(n2_sm_info, n2_sm_info_hex);
+  msg.set_n2_sm_information(n2_sm_info_hex);
+
+  std::string url = get_amf_addr() +
+                    oai::smf::api::smf_sbi_helper::
+                        get_amf_comm_ue_context_n1_n2_message_base_uri(supi);
+  msg.set_amf_url(url);
+  Logger::smf_app().debug(
+      "N1N2MessageTransfer will be sent to AMF with URL: %s", url.c_str());
+
+  nlohmann::json json_data = {};
+  json_data["n1MessageContainer"]["n1MessageClass"] =
+      oai::utils::N1N2_MESSAGE_CLASS;
+  json_data["n1MessageContainer"]["n1MessageContent"]["contentId"] =
+      oai::utils::N1_SM_CONTENT_ID;
+  json_data["n2InfoContainer"]["n2InformationClass"] =
+      oai::utils::N1N2_MESSAGE_CLASS;
+  json_data["n2InfoContainer"]["smInfo"]["pduSessionId"] =
+      sp->get_pdu_session_id();
+  json_data["n2InfoContainer"]["smInfo"]["n2InfoContent"]["ngapIeType"] =
+      "PDU_RES_MOD_REQ";
+  json_data["n2InfoContainer"]["smInfo"]["n2InfoContent"]["ngapData"]
+           ["contentId"] = N2_SM_CONTENT_ID;
+  json_data["n2InfoContainer"]["smInfo"]["sNssai"]["sst"] =
+      sp->get_snssai().sst;
+  json_data["n2InfoContainer"]["smInfo"]["sNssai"]["sd"] = sp->get_snssai().sd;
+  json_data["pduSessionId"] = sp->get_pdu_session_id();
+  msg.set_json_data(json_data);
+
+  Logger::smf_app().info(
+      "Sending ITTI message %s to task TASK_SMF_SBI", itti_msg->get_msg_name());
+  int ret = itti_inst->send_msg(itti_msg);
+  if (RETURNok != ret) {
+    Logger::smf_app().error(
+        "Could not send ITTI message %s to task TASK_SMF_SBI",
+        itti_msg->get_msg_name());
+  }
+}

     if ((*it)->pdr_id.rule_id == pdr_id.rule_id) {
       Logger::upf_n4().info(
           "pfcp_session::remove(pdr) seid " SEID_FMT " ", seid);
+      // Also drop it from the switch lookups: otherwise a removed DL PDR keeps
+      // matching the UE IP and its (removed) FAR blackholes downlink traffic.
+      const auto& pdi = (*it)->pdi;
+      if (pdi.first && pdi.second.source_interface.first) {
+        const auto iface = pdi.second.source_interface.second.interface_value;
+        if (iface == INTERFACE_VALUE_ACCESS && pdi.second.local_fteid.first) {
+          pfcp_switch_inst->remove_pfcp_ul_pdr_by_up_teid(
+              pdi.second.local_fteid.second.teid, **it);
+        } else if (
+            iface == INTERFACE_VALUE_CORE && pdi.second.ue_ip_address.first &&
+            pdi.second.ue_ip_address.second.v4) {
+          pfcp_switch_inst->remove_pfcp_dl_pdr_by_ue_ip(
+              be32toh(pdi.second.ue_ip_address.second.ipv4_address.s_addr),
+              **it);
+        }
+      }
       pdrs.erase(it);
       return true;
     }

+void pfcp_switch::remove_pfcp_ul_pdr_by_up_teid(
+    const teid_t teid, const pfcp::pfcp_pdr& pdr) {
+  auto pit = ul_n3_teid2pfcp_pdr.find(teid);
+  if (pit == ul_n3_teid2pfcp_pdr.end()) return;
+  auto pdrs = without_pdr(pit->second, pdr);
+  ul_n3_teid2pfcp_pdr.erase(teid);
+  if (!pdrs->empty()) ul_n3_teid2pfcp_pdr.insert(std::make_pair(teid, pdrs));
+}

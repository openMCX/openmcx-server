+namespace {
+using pdr_list_t = std::vector<std::shared_ptr<pfcp::pfcp_pdr>>;
+
+bool same_pdr(const pfcp::pfcp_pdr& a, const pfcp::pfcp_pdr& b) {
+  if (&a == &b) return true;
+  uint64_t sa = 0, sb = 0;
+  a.get(sa);
+  b.get(sb);
+  return sa == sb && a.pdr_id.rule_id == b.pdr_id.rule_id;
+}
+
+// Copy of a lookup list with "pdr" (re)inserted: any entry for the same session
+// and PDR ID is replaced, and the list stays ordered by precedence (lowest value
+// first), which is the order the packet path evaluates PDRs in (TS 29.244 5.2.1).
+std::shared_ptr<pdr_list_t> with_pdr(
+    const std::shared_ptr<pdr_list_t>& current,
+    const std::shared_ptr<pfcp::pfcp_pdr>& pdr) {
+  auto pdrs = std::make_shared<pdr_list_t>();
+  if (current)
+    for (const auto& p : *current)
+      if (!same_pdr(*p, *pdr)) pdrs->push_back(p);
+  auto pos = std::upper_bound(
+      pdrs->begin(), pdrs->end(), pdr,
+      [](const std::shared_ptr<pfcp::pfcp_pdr>& a,
+         const std::shared_ptr<pfcp::pfcp_pdr>& b) { return *a < *b; });
+  pdrs->insert(pos, pdr);
+  return pdrs;
+}
+
+// Copy of a lookup list without "pdr" (same session and PDR ID).
+std::shared_ptr<pdr_list_t> without_pdr(
+    const std::shared_ptr<pdr_list_t>& current, const pfcp::pfcp_pdr& pdr) {
+  auto pdrs = std::make_shared<pdr_list_t>();
+  if (current)
+    for (const auto& p : *current)
+      if (!same_pdr(*p, pdr)) pdrs->push_back(p);
+  return pdrs;
+}
+}  // namespace
+
+//------------------------------------------------------------------------------
+// Lookup lists are replaced, never edited in place, so that the packet path,
+// which holds its own reference to a list, never sees one being modified.

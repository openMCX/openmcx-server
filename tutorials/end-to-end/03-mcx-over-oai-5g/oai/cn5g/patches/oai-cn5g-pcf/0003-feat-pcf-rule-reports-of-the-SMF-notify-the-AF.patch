diff --git a/src/pcf_app/pcf_policy_authorization.hpp b/src/pcf_app/pcf_policy_authorization.hpp
index 8d7d7c6..3e5e720 100644
--- a/src/pcf_app/pcf_policy_authorization.hpp
+++ b/src/pcf_app/pcf_policy_authorization.hpp
@@ -101,8 +101,19 @@ class pcf_policy_authorization {
       const std::string& app_session_id, const nlohmann::json& raw_context,
       oai::model::pcf::SmPolicyDecision& decision);
 
+  /**
+   * PCC rules the SMF reported as no longer active: for each app session they
+   * belong to, Npcf_PolicyAuthorization_Notify (EventsNotification with
+   * FAILED_RESOURCES_ALLOCATION, TS 29.514 4.2.5.4) to the AF, if it
+   * subscribed to that event
+   */
+  void handle_rule_report(
+      const std::vector<std::string>& pcc_rule_ids,
+      const std::string& failure_code);
+
   // for Event Handling
   pcf_event& m_event_sub;
+  bs2::connection m_rule_report_connection;
 };
 
 }  // namespace oai::pcf::app
diff --git a/src/pcf_app/pcf_sm_policy_control.cpp b/src/pcf_app/pcf_sm_policy_control.cpp
index 466f31c..171a121 100644
--- a/src/pcf_app/pcf_sm_policy_control.cpp
+++ b/src/pcf_app/pcf_sm_policy_control.cpp
@@ -383,10 +383,55 @@ sm_policy::status_code pcf_smpc::update_sm_policy_handler(
         update_context.getIpv4Address(), id);
   }
 
-  SmPolicyDecision new_decision;
+  // Rule reports (TS 29.512 4.2.4.1, 5.6.2.7): PCC rules the SMF could not
+  // install or keep (e.g. the NG-RAN refused their QoS flow, RES_ALLO_FAIL)
+  // are no longer part of the decision; the AF of their app session is told
+  // (TS 29.514 4.2.5), after the association lock is released
+  std::vector<std::string> inactive_rules;
+  std::string failure_code;
+  {
+    nlohmann::json update_json;
+    to_json(update_json, update_context);
+    if (update_json.contains("ruleReports") &&
+        update_json["ruleReports"].is_array()) {
+      for (const auto& report : update_json["ruleReports"]) {
+        if (report.value("ruleStatus", "") != "INACTIVE" ||
+            !report.contains("pccRuleIds"))
+          continue;
+        if (report.contains("failureCode") &&
+            report["failureCode"].is_string())
+          failure_code = report["failureCode"].get<std::string>();
+        for (const auto& id : report["pccRuleIds"])
+          if (id.is_string()) inactive_rules.push_back(id.get<std::string>());
+      }
+    }
+  }
+  if (!inactive_rules.empty()) {
+    auto current = iter->second.get_sm_policy_decision_dto();
+    auto rules   = current.getPccRules();
+    auto qos     = current.getQosDecs();
+    for (const auto& id : inactive_rules) {
+      Logger::pcf_app().warn(
+          "SMF reports PCC rule %s inactive (%s)", id.c_str(),
+          failure_code.c_str());
+      auto it = rules.find(id);
+      if (it == rules.end()) continue;
+      for (const auto& ref : it->second.getRefQosData()) qos.erase(ref);
+      rules.erase(it);
+    }
+    current.setPccRules(rules);
+    current.setQosDecs(qos);
+    // the SMF has already removed them: no notification back
+    iter->second.set_sm_policy_decision(current);
+  }
+
+  auto status =
+      iter->second.redecide_policy(update_context, decision, problem_details);
+  lock_associations.unlock();
 
-  return iter->second.redecide_policy(
-      update_context, decision, problem_details);
+  if (!inactive_rules.empty())
+    m_event_sub.pa_rule_report(inactive_rules, failure_code);
+  return status;
 }
 

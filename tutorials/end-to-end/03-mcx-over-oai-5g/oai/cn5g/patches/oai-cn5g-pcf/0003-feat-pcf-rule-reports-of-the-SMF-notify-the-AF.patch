diff --git a/src/pcf_app/pcf_policy_authorization.cpp b/src/pcf_app/pcf_policy_authorization.cpp
index 971e947..54d0e6b 100644
--- a/src/pcf_app/pcf_policy_authorization.cpp
+++ b/src/pcf_app/pcf_policy_authorization.cpp
@@ -12,7 +12,10 @@
 #include "AppSessionContextUpdateDataPatch.h"
 #include "policy_auth/app_session.hpp"
 #include "policy_auth/mcx_qos.hpp"
+#include "3gpp_29.500.h"
+#include "http_client.hpp"
 
+#include <boost/bind/bind.hpp>
 #include <boost/uuid/uuid_io.hpp>
 #include <unordered_map>
 #include <map>
@@ -28,6 +31,7 @@ using namespace oai::model::pcf;
 using namespace std;
 
 extern std::unique_ptr<oai::config::pcf::pcf_config> pcf_cfg;
+extern std::shared_ptr<oai::http::http_client> http_client_inst;
 
 namespace {
 std::optional<std::string> json_opt_string(
@@ -51,7 +55,86 @@ std::set<int32_t> used_precedences(
 
 //------------------------------------------------------------------------------
 pcf_policy_authorization::pcf_policy_authorization(pcf_event& ev)
-    : m_event_sub(ev) {}
+    : m_event_sub(ev) {
+  m_rule_report_connection = m_event_sub.subscribe_pa_rule_report(boost::bind(
+      &pcf_policy_authorization::handle_rule_report, this,
+      boost::placeholders::_1, boost::placeholders::_2));
+}
+
+//------------------------------------------------------------------------------
+void pcf_policy_authorization::handle_rule_report(
+    const std::vector<std::string>& pcc_rule_ids,
+    const std::string& failure_code) {
+  // PCC rule "mcx-<app session ID>-<media component number>" (mcx_qos.cpp)
+  std::map<std::string, std::set<int>> media_components;
+  for (const auto& id : pcc_rule_ids) {
+    if (!mcx::is_mcx_id(id)) continue;
+    const auto rest = id.substr(mcx::kMcxPccRulePrefix.size());
+    const auto dash = rest.rfind('-');
+    if (dash == std::string::npos) continue;
+    try {
+      media_components[rest.substr(0, dash)].insert(
+          std::stoi(rest.substr(dash + 1)));
+    } catch (const std::exception&) {
+    }
+  }
+
+  const auto sbi = pcf_cfg->local().get_sbi();
+  for (const auto& [app_session_id, med_comp_ns] : media_components) {
+    nlohmann::json subscription;
+    {
+      std::shared_lock lock(m_app_sessions_mutex);
+      auto it = m_app_sessions.find(app_session_id);
+      if (it == m_app_sessions.end()) continue;
+      const auto& raw = it->second.get_raw_context();
+      if (raw.contains("evSubsc") && raw["evSubsc"].is_object())
+        subscription = raw["evSubsc"];
+    }
+    bool subscribed = false;
+    if (subscription.contains("events") && subscription["events"].is_array())
+      for (const auto& ev : subscription["events"])
+        if (ev.is_object() &&
+            ev.value("event", "") == "FAILED_RESOURCES_ALLOCATION")
+          subscribed = true;
+    const std::string notif_uri = subscription.value("notifUri", "");
+    if (!subscribed || notif_uri.empty()) {
+      Logger::pcf_app().info(
+          "App session %s: resources of media components not allocated, the "
+          "AF did not subscribe to FAILED_RESOURCES_ALLOCATION",
+          app_session_id.c_str());
+      continue;
+    }
+
+    nlohmann::json flows = nlohmann::json::array();
+    for (int n : med_comp_ns) flows.push_back({{"medCompN", n}});
+    // EventsNotification (TS 29.514 5.6.2.5): the media components whose
+    // resources are no longer allocated, as ResourcesAllocationInfo
+    nlohmann::json notification = {
+        {"evSubsUri",
+         sbi.get_url() + "/npcf-policyauthorization/" +
+             sbi.get_api_version() + "/app-sessions/" + app_session_id +
+             "/events-subscription"},
+        {"evNotifs",
+         nlohmann::json::array(
+             {{{"event", "FAILED_RESOURCES_ALLOCATION"}, {"flows", flows}}})},
+        {"failedResourcAllocReports",
+         nlohmann::json::array(
+             {{{"mcResourcStatus", "INACTIVE"}, {"flows", flows}}})}};
+    Logger::pcf_app().info(
+        "Npcf_PolicyAuthorization_Notify to %s/notify: app session %s, "
+        "FAILED_RESOURCES_ALLOCATION (%s)",
+        notif_uri.c_str(), app_session_id.c_str(), failure_code.c_str());
+    auto req = http_client_inst->prepare_json_request(
+        notif_uri + "/notify", notification.dump());
+    auto resp = http_client_inst->send_http_request(
+        oai::common::sbi::method_e::POST, req);
+    if (resp.status_code != oai::common::sbi::http_status_code::NO_CONTENT &&
+        resp.status_code != oai::common::sbi::http_status_code::OK)
+      Logger::pcf_app().warn(
+          "Npcf_PolicyAuthorization_Notify: the AF answered %d",
+          (int) resp.status_code);
+  }
+}
 
 //------------------------------------------------------------------------------
 handler_result pcf_policy_authorization::apply_media_components(
@@ -410,5 +493,6 @@ policy_auth::status_code pcf_policy_authorization::get_app_session_handler(
 
 //------------------------------------------------------------------------------
 pcf_policy_authorization::~pcf_policy_authorization() {
+  m_rule_report_connection.disconnect();
   Logger::pcf_app().debug("Delete PCF PA instance...");
 }

+++ b/src/pcf_app/policy_auth/mcx_qos.cpp
@@ -0,0 +1,392 @@
+/*
+ * SPDX-License-Identifier: LicenseRef-CSSL-1.0
+ */
+
+#include "mcx_qos.hpp"
+
+#include <algorithm>
+#include <regex>
+#include <sstream>
+
+#include "logger.hpp"
+
+namespace oai::pcf::app::policy_auth::mcx {
+
+using namespace oai::model::pcf;
+
+namespace {
+
+// 5QIs with a GBR resource type (TS 23.501, table 5.7.4-1)
+const std::set<int> kGbr5qis = {1,  2,  3,  4,  65, 66, 67, 71, 72, 73,
+                                74, 75, 76, 82, 83, 84, 85, 86, 87, 88,
+                                89, 90};
+
+std::vector<std::string> split_ws(const std::string& in) {
+  std::istringstream iss(in);
+  std::vector<std::string> out;
+  std::string tok;
+  while (iss >> tok) out.push_back(tok);
+  return out;
+}
+
+std::string strip_mask(const std::string& addr) {
+  auto pos = addr.find('/');
+  if (pos == std::string::npos) return addr;
+  // a /32 mask still designates the UE address
+  return addr.substr(0, pos);
+}
+
+std::string build_description(
+    const std::string& proto, const std::string& from_addr,
+    const std::string& from_ports, const std::string& to_addr,
+    const std::string& to_ports) {
+  std::string out = "permit out " + proto + " from " + from_addr;
+  if (!from_ports.empty()) out.append(" ").append(from_ports);
+  out.append(" to ").append(to_addr);
+  if (!to_ports.empty()) out.append(" ").append(to_ports);
+  return out;
+}
+
+std::string json_string(
+    const nlohmann::json& j, const std::string& key,
+    const std::string& def = "") {
+  if (j.is_object() && j.contains(key) && j[key].is_string()) {
+    return j[key].get<std::string>();
+  }
+  return def;
+}
+
+bool flow_status_enabled(const nlohmann::json& j) {
+  // fStatus absent means ENABLED (TS 29.514, 5.6.3.x FlowStatus)
+  std::string status = json_string(j, "fStatus", "ENABLED");
+  return status != "DISABLED" && status != "REMOVED";
+}
+
+std::string upper(std::string s) {
+  std::transform(s.begin(), s.end(), s.begin(), ::toupper);
+  return s;
+}
+
+}  // namespace
+
+//------------------------------------------------------------------------------
+bool is_mcx_id(const std::string& id) {
+  return id.rfind(kMcxPccRulePrefix, 0) == 0;
+}
+
+//------------------------------------------------------------------------------
+std::optional<parsed_flow_description> parse_flow_description(
+    const std::string& fdesc) {
+  auto toks = split_ws(fdesc);
+  // permit out <proto> from <addr> [ports] to <addr> [ports]
+  if (toks.size() < 7) return std::nullopt;
+  if (toks[0] != "permit" || toks[1] != "out") return std::nullopt;
+
+  auto from_it = std::find(toks.begin(), toks.end(), "from");
+  auto to_it   = std::find(toks.begin(), toks.end(), "to");
+  if (from_it == toks.end() || to_it == toks.end() || to_it < from_it) {
+    return std::nullopt;
+  }
+  size_t from_idx = std::distance(toks.begin(), from_it);
+  size_t to_idx   = std::distance(toks.begin(), to_it);
+  if (from_idx != 3 || from_idx + 1 >= to_idx || to_idx + 1 >= toks.size()) {
+    return std::nullopt;
+  }
+
+  parsed_flow_description out;
+  out.protocol = toks[2];
+  out.src_addr = toks[from_idx + 1];
+  for (size_t i = from_idx + 2; i < to_idx; i++) {
+    if (!out.src_ports.empty()) out.src_ports.append(" ");
+    out.src_ports.append(toks[i]);
+  }
+  out.dst_addr = toks[to_idx + 1];
+  for (size_t i = to_idx + 2; i < toks.size(); i++) {
+    if (!out.dst_ports.empty()) out.dst_ports.append(" ");
+    out.dst_ports.append(toks[i]);
+  }
+  return out;
+}
+
+//------------------------------------------------------------------------------
+std::vector<mcx_flow> derive_flows(
+    const std::vector<std::string>& fdescs, const std::string& ue_ipv4) {
+  std::vector<mcx_flow> flows;
+
+  for (const auto& fdesc : fdescs) {
+    auto parsed = parse_flow_description(fdesc);
+    if (!parsed.has_value()) {
+      Logger::pcf_app().warn(
+          "MCX: cannot parse flow description '%s', using it unchanged as "
+          "BIDIRECTIONAL",
+          fdesc.c_str());
+      flows.push_back(mcx_flow{fdesc, "BIDIRECTIONAL"});
+      continue;
+    }
+    const auto& p = parsed.value();
+    mcx_flow flow;
+    if (!ue_ipv4.empty() && strip_mask(p.dst_addr) == ue_ipv4) {
+      // from <remote> to <UE>: downlink, already in the TS 29.512 notation
+      flow.flow_description = build_description(
+          p.protocol, p.src_addr, p.src_ports, p.dst_addr, p.dst_ports);
+      flow.flow_direction = "DOWNLINK";
+    } else if (!ue_ipv4.empty() && strip_mask(p.src_addr) == ue_ipv4) {
+      // from <UE> to <remote>: uplink. TS 29.512/29.513: the flow description
+      // is expressed from the remote to the UE, direction in flowDirection
+      flow.flow_description = build_description(
+          p.protocol, p.dst_addr, p.dst_ports, p.src_addr, p.src_ports);
+      flow.flow_direction = "UPLINK";
+    } else {
+      flow.flow_description = build_description(
+          p.protocol, p.src_addr, p.src_ports, p.dst_addr, p.dst_ports);
+      flow.flow_direction = "BIDIRECTIONAL";
+    }
+
+    // merge UL + DL of the same 5-tuple into one bidirectional flow
+    auto existing = std::find_if(
+        flows.begin(), flows.end(), [&flow](const mcx_flow& f) {
+          return f.flow_description == flow.flow_description;
+        });
+    if (existing != flows.end()) {
+      if (existing->flow_direction != flow.flow_direction) {
+        existing->flow_direction = "BIDIRECTIONAL";
+      }
+      continue;
+    }
+    flows.push_back(flow);
+  }
+  return flows;
+}
+
+//------------------------------------------------------------------------------
+int arp_priority_from_res_prio(
+    const std::optional<std::string>& res_prio,
+    const oai::config::pcf::mcx_qos_config& cfg) {
+  // absent (or removed with a null merge-patch) -> default
+  if (!res_prio.has_value()) return cfg.default_arp_priority;
+  static const std::regex prio_re("^PRIO_([0-9]{1,2})$");
+  std::smatch m;
+  if (!std::regex_match(res_prio.value(), m, prio_re)) {
+    Logger::pcf_app().warn(
+        "MCX: unknown resPrio value '%s', using default ARP %d",
+        res_prio.value().c_str(), cfg.default_arp_priority);
+    return cfg.default_arp_priority;
+  }
+  auto it = cfg.res_prio_arp.find(res_prio.value());
+  if (it == cfg.res_prio_arp.end()) return cfg.default_arp_priority;
+  return std::clamp(it->second, 1, 15);
+}
+
+//------------------------------------------------------------------------------
+std::optional<mcx_decision> build_mcx_decision(
+    const nlohmann::json& asc_req_data, const std::string& app_session_id,
+    const std::set<int32_t>& used_precedences,
+    const oai::config::pcf::mcx_qos_config& cfg, std::string& error) {
+  mcx_decision decision;
+
+  if (!asc_req_data.contains("medComponents") ||
+      !asc_req_data["medComponents"].is_object()) {
+    // nothing to do (e.g. app session only for event subscription)
+    return decision;
+  }
+
+  std::string ue_ipv4 = json_string(asc_req_data, "ueIpv4");
+  std::optional<std::string> session_res_prio = std::nullopt;
+  if (asc_req_data.contains("resPrio") && asc_req_data["resPrio"].is_string()) {
+    session_res_prio = asc_req_data["resPrio"].get<std::string>();
+  }
+
+  std::set<int32_t> precedences = used_precedences;
+  int32_t next_precedence       = cfg.precedence_base;
+  auto allocate_precedence      = [&]() {
+    while (precedences.count(next_precedence) > 0) next_precedence++;
+    precedences.insert(next_precedence);
+    return next_precedence;
+  };
+
+  // order the media components by medCompN to have deterministic precedences
+  std::map<int, nlohmann::json> med_comps;
+  for (const auto& [key, med_comp] : asc_req_data["medComponents"].items()) {
+    if (med_comp.is_null()) continue;  // removed by merge-patch
+    if (!med_comp.is_object()) {
+      error = "medComponents." + key + " is not an object";
+      return std::nullopt;
+    }
+    int med_comp_n = 0;
+    if (med_comp.contains("medCompN") && med_comp["medCompN"].is_number()) {
+      med_comp_n = med_comp["medCompN"].get<int>();
+    } else {
+      try {
+        med_comp_n = std::stoi(key);
+      } catch (...) {
+        error = "medComponents." + key + ": missing medCompN";
+        return std::nullopt;
+      }
+    }
+    med_comps[med_comp_n] = med_comp;
+  }
+
+  for (const auto& [med_comp_n, med_comp] : med_comps) {
+    if (!flow_status_enabled(med_comp)) {
+      Logger::pcf_app().info(
+          "MCX: media component %d is disabled/removed, no PCC rule",
+          med_comp_n);
+      continue;
+    }
+
+    // Collect the flow descriptions of all the (enabled) media sub components
+    std::vector<std::string> fdescs;
+    std::string sub_mar_bw_ul, sub_mar_bw_dl;
+    if (med_comp.contains("medSubComps") &&
+        med_comp["medSubComps"].is_object()) {
+      std::map<int, nlohmann::json> sub_comps;
+      for (const auto& [skey, sub] : med_comp["medSubComps"].items()) {
+        if (!sub.is_object()) continue;
+        int f_num = 0;
+        if (sub.contains("fNum") && sub["fNum"].is_number()) {
+          f_num = sub["fNum"].get<int>();
+        } else {
+          try {
+            f_num = std::stoi(skey);
+          } catch (...) {
+            f_num = static_cast<int>(sub_comps.size()) + 1000;
+          }
+        }
+        sub_comps[f_num] = sub;
+      }
+      for (const auto& [f_num, sub] : sub_comps) {
+        if (!flow_status_enabled(sub)) continue;
+        if (sub.contains("fDescs") && sub["fDescs"].is_array()) {
+          for (const auto& fd : sub["fDescs"]) {
+            if (fd.is_string()) fdescs.push_back(fd.get<std::string>());
+          }
+        }
+        if (sub_mar_bw_ul.empty()) sub_mar_bw_ul = json_string(sub, "marBwUl");
+        if (sub_mar_bw_dl.empty()) sub_mar_bw_dl = json_string(sub, "marBwDl");
+      }
+    }
+
+    std::vector<mcx_flow> flows = derive_flows(fdescs, ue_ipv4);
+    if (flows.empty()) {
+      Logger::pcf_app().warn(
+          "MCX: media component %d has no flow description, no PCC rule",
+          med_comp_n);
+      continue;
+    }
+
+    // 5QI from the media type
+    std::string med_type = upper(json_string(med_comp, "medType", "AUDIO"));
+    int r5qi             = cfg.other_5qi;
+    if (med_type == "AUDIO") {
+      r5qi = cfg.audio_5qi;
+    } else if (med_type == "VIDEO") {
+      r5qi = cfg.video_5qi;
+    }
+    bool gbr = kGbr5qis.count(r5qi) > 0;
+
+    // ARP (TS 29.513, 7.3.x: derived from the reservation priority)
+    std::optional<std::string> res_prio = session_res_prio;
+    if (med_comp.contains("resPrio") && med_comp["resPrio"].is_string()) {
+      res_prio = med_comp["resPrio"].get<std::string>();
+    }
+    int arp_prio = arp_priority_from_res_prio(res_prio, cfg);
+    std::string preempt_cap =
+        json_string(med_comp, "preemptCap", "MAY_PREEMPT");
+    std::string preempt_vuln = json_string(
+        med_comp, "preemptVuln",
+        arp_prio <= cfg.emergency_arp_threshold ? "NOT_PREEMPTABLE" :
+                                                  "PREEMPTABLE");
+
+    std::string mar_bw_ul = json_string(med_comp, "marBwUl", sub_mar_bw_ul);
+    std::string mar_bw_dl = json_string(med_comp, "marBwDl", sub_mar_bw_dl);
+    if (mar_bw_ul.empty()) mar_bw_ul = cfg.default_bandwidth;
+    if (mar_bw_dl.empty()) mar_bw_dl = cfg.default_bandwidth;
+
+    std::string suffix =
+        app_session_id + "-" + std::to_string(med_comp_n);
+    std::string rule_id = kMcxPccRulePrefix + suffix;
+    std::string qos_id  = kMcxQosDataPrefix + suffix;
+
+    nlohmann::json qos_json = {
+        {"qosId", qos_id},
+        {"5qi", r5qi},
+        {"arp",
+         {{"priorityLevel", arp_prio},
+          {"preemptCap", preempt_cap},
+          {"preemptVuln", preempt_vuln}}}};
+    if (gbr) {
+      qos_json["gbrUl"]   = mar_bw_ul;
+      qos_json["gbrDl"]   = mar_bw_dl;
+      qos_json["maxbrUl"] = mar_bw_ul;
+      qos_json["maxbrDl"] = mar_bw_dl;
+    }
+
+    nlohmann::json flow_infos = nlohmann::json::array();
+    int pf_id                 = 1;
+    for (const auto& flow : flows) {
+      flow_infos.push_back(
+          {{"flowDescription", flow.flow_description},
+           {"flowDirection", flow.flow_direction},
+           {"packFiltId", std::to_string(pf_id++)},
+           {"packetFilterUsage", true}});
+    }
+
+    nlohmann::json rule_json = {
+        {"pccRuleId", rule_id},
+        {"flowInfos", flow_infos},
+        {"precedence", allocate_precedence()},
+        {"refQosData", {qos_id}}};
+
+    try {
+      PccRule rule = rule_json.get<PccRule>();
+      QosData qos  = qos_json.get<QosData>();
+      decision.pcc_rules[rule_id] = rule;
+      decision.qos_decs[qos_id]   = qos;
+    } catch (std::exception& e) {
+      error = std::string("Cannot build PCC rule: ") + e.what();
+      return std::nullopt;
+    }
+
+    Logger::pcf_app().info(
+        "MCX: media component %d (%s) -> PCC rule %s, 5QI %d, ARP %d (%s/%s), "
+        "MBR/GBR UL %s DL %s, %d flow(s)",
+        med_comp_n, med_type.c_str(), rule_id.c_str(), r5qi, arp_prio,
+        preempt_cap.c_str(), preempt_vuln.c_str(), mar_bw_ul.c_str(),
+        mar_bw_dl.c_str(), static_cast<int>(flows.size()));
+    for (const auto& flow : flows) {
+      Logger::pcf_app().debug(
+          "MCX:   %s [%s]", flow.flow_description.c_str(),
+          flow.flow_direction.c_str());
+    }
+  }
+  return decision;
+}
+
+//------------------------------------------------------------------------------
+void remove_app_session_rules(
+    const std::string& app_session_id, SmPolicyDecision& decision) {
+  std::string rule_prefix = kMcxPccRulePrefix + app_session_id + "-";
+  std::string qos_prefix  = kMcxQosDataPrefix + app_session_id + "-";
+
+  auto rules = decision.getPccRules();
+  for (auto it = rules.begin(); it != rules.end();) {
+    if (it->first.rfind(rule_prefix, 0) == 0) {
+      it = rules.erase(it);
+    } else {
+      ++it;
+    }
+  }
+  decision.setPccRules(rules);
+
+  auto qos_decs = decision.getQosDecs();
+  for (auto it = qos_decs.begin(); it != qos_decs.end();) {
+    if (it->first.rfind(qos_prefix, 0) == 0) {
+      it = qos_decs.erase(it);
+    } else {
+      ++it;
+    }
+  }
+  decision.setQosDecs(qos_decs);
+}
+
+}  // namespace oai::pcf::app::policy_auth::mcx

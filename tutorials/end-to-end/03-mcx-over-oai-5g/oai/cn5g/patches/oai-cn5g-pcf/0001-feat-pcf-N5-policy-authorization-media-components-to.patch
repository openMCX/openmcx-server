diff --git a/docker/install_odb_2.5.sh b/docker/install_odb_2.5.sh
new file mode 100755
index 0000000..b0d9b96
--- /dev/null
+++ b/docker/install_odb_2.5.sh
@@ -0,0 +1,32 @@
+#!/bin/bash
+# SPDX-License-Identifier: LicenseRef-CSSL-1.0
+#
+# Workaround for the PCF image build: the build2 0.17.0 toolchain used by
+# build/common-build/installation/build_helper.odb can no longer be installed
+# (its source packages were removed from pkg.cppget.org), so libodb is not
+# installed and the PCF does not build. Install the libodb / libodb-mysql 2.5.0
+# runtime libraries with the build2 0.18.1 toolchain instead.
+# Does nothing if libodb 2.5 is already installed.
+set -ex
+
+if [ -f /usr/local/lib/libodb-2.5.so ] && [ -f /usr/local/lib/libodb-mysql-2.5.so ]; then
+  echo "libodb 2.5 already installed"
+  exit 0
+fi
+
+BUILD2_VERSION=0.18.1
+rm -f /usr/local/bin/b-stage /usr/local/bin/bpkg-stage /usr/local/bin/bdep-stage
+rm -rf /tmp/build2-odb && mkdir -p /tmp/build2-odb && cd /tmp/build2-odb
+curl -sSfO https://download.build2.org/${BUILD2_VERSION}/build2-install-${BUILD2_VERSION}.sh
+sh build2-install-${BUILD2_VERSION}.sh --yes --no-bdep --no-modules --trust yes
+
+bpkg create -d libodb-gcc cc config.cxx=g++ config.cc.coptions=-O3 \
+  config.install.root=/usr/local
+cd libodb-gcc
+bpkg add https://pkg.cppget.org/1/beta
+bpkg fetch --trust-yes
+bpkg build --yes libodb/2.5.0 libodb-mysql/2.5.0
+bpkg install --all --recursive
+ldconfig
+ls -la /usr/local/lib/libodb*
+cd / && rm -rf /tmp/build2-odb /tmp/build2

 namespace oai::pcf::api {
 
+namespace {
+// Map the PA status code to the HTTP status code (TS 29.514 / TS 29.500)
+uint16_t pa_status_to_http(oai::pcf::app::policy_auth::status_code res) {
+  using oai::pcf::app::policy_auth::status_code;
+  switch (res) {
+    case status_code::CREATED:
+      return oai::common::sbi::http_status_code::CREATED;
+    case status_code::OK:
+      return oai::common::sbi::http_status_code::OK;
+    case status_code::NO_CONTENT:
+      return oai::common::sbi::http_status_code::NO_CONTENT;
+    case status_code::NOT_FOUND:
+    case status_code::PDU_SESSION_NOT_AVAILABLE:
+      return oai::common::sbi::http_status_code::NOT_FOUND;
+    case status_code::BAD_REQUEST:
+    case status_code::INVALID_PARAMETERS:
+      return oai::common::sbi::http_status_code::BAD_REQUEST;
+    case status_code::FORBIDDEN:
+    case status_code::CONTEXT_DENIED:
+    case status_code::REQUESTED_SERVICE_NOT_AUTHORIZED:
+      return oai::common::sbi::http_status_code::FORBIDDEN;
+    default:
+      return oai::common::sbi::http_status_code::INTERNAL_SERVER_ERROR;
+  }
+}
+
+api_response problem_response(uint16_t http_code, const std::string& cause) {
+  api_response response;
+  oai::model::common::ProblemDetails problem_details;
+  problem_details.setStatus(http_code);
+  problem_details.setCause(cause.empty() ? "UNSPECIFIED" : cause);
+  nlohmann::json json_data;
+  to_json(json_data, problem_details);
+  response.headers.add<Pistache::Http::Header::ContentType>(
+      Pistache::Http::Mime::MediaType("application/problem+json"));
+  response.body        = json_data.dump();
+  response.status_code = http_code;
+  return response;
+}
+}  // namespace
+

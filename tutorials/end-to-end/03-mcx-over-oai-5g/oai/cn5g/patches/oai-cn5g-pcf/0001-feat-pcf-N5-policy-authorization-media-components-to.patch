+
+void mcx_qos_config::from_yaml(const YAML::Node& node) {
+  if (node["audio_5qi"]) audio_5qi = node["audio_5qi"].as<int>();
+  if (node["video_5qi"]) video_5qi = node["video_5qi"].as<int>();
+  if (node["other_5qi"]) other_5qi = node["other_5qi"].as<int>();
+  if (node["default_arp_priority"])
+    default_arp_priority = node["default_arp_priority"].as<int>();
+  if (node["res_prio_arp"] && node["res_prio_arp"].IsMap()) {
+    res_prio_arp.clear();
+    for (const auto& it : node["res_prio_arp"]) {
+      res_prio_arp[it.first.as<std::string>()] = it.second.as<int>();
+    }
+  }
+  if (node["emergency_arp_threshold"])
+    emergency_arp_threshold = node["emergency_arp_threshold"].as<int>();
+  if (node["precedence_base"])
+    precedence_base = node["precedence_base"].as<int>();
+  if (node["default_bandwidth"])
+    default_bandwidth = node["default_bandwidth"].as<std::string>();
+}
+
+std::string mcx_qos_config::to_string(const std::string& indent) const {
+  std::string out;
+  out.append(indent).append("MCX QoS (N5 media component mapping):\n");
+  out.append(indent).append(fmt::format(
+      "  audio_5qi: {}, video_5qi: {}, other_5qi: {}\n", audio_5qi, video_5qi,
+      other_5qi));
+  std::string res_prio;
+  for (const auto& [prio, arp] : res_prio_arp) {
+    res_prio.append(fmt::format("{}->{} ", prio, arp));
+  }
+  out.append(indent).append(fmt::format(
+      "  default_arp_priority: {}, emergency_arp_threshold: {}\n",
+      default_arp_priority, emergency_arp_threshold));
+  out.append(indent).append(fmt::format("  res_prio_arp: {}\n", res_prio));
+  out.append(indent).append(fmt::format(
+      "  precedence_base: {}, default_bandwidth: {}\n", precedence_base,
+      default_bandwidth));
+  return out;
+}

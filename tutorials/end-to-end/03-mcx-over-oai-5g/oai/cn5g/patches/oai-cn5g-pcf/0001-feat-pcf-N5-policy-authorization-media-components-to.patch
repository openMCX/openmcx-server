+/*
+ * SPDX-License-Identifier: LicenseRef-CSSL-1.0
+ */
+
+/*
+ * Mapping of Npcf_PolicyAuthorization (TS 29.514) media components to PCC
+ * rules and QoS decisions (TS 29.512), following the principles of TS 29.513
+ * (chapter 7.3 "QoS parameter mapping"). Used for MCX (MCPTT) AF requests.
+ *
+ * The mapping works on the raw JSON representation of the
+ * AppSessionContextReqData because some of the generated OpenAPI models used
+ * by the PCF (e.g. ReservPriority, MediaType) are empty stubs and would lose
+ * the values sent by the AF.
+ */
+
+#ifndef FILE_PCF_MCX_QOS_SEEN
+#define FILE_PCF_MCX_QOS_SEEN
+
+#include <map>
+#include <optional>
+#include <set>
+#include <string>
+#include <vector>
+
+#include "PccRule.h"
+#include "QosData.h"
+#include "SmPolicyDecision.h"
+#include "nlohmann/json.hpp"
+#include "pcf_config_types.hpp"
+
+namespace oai::pcf::app::policy_auth::mcx {
+
+const std::string kMcxPccRulePrefix = "mcx-";
+const std::string kMcxQosDataPrefix = "mcx-qos-";
+
+struct parsed_flow_description {
+  std::string protocol;
+  std::string src_addr;
+  std::string src_ports;
+  std::string dst_addr;
+  std::string dst_ports;
+};
+
+/**
+ * Parse an IPFilterRule ("permit out 17 from 1.2.3.4 5000 to 5.6.7.8 6000").
+ * @return std::nullopt if the string can not be parsed
+ */
+std::optional<parsed_flow_description> parse_flow_description(
+    const std::string& fdesc);
+
+/**
+ * Derived flow information (TS 29.513, 7.3.1 / TS 29.512 FlowInformation):
+ * the flow description is always written from the network to the UE
+ * ("from <remote> to <UE>") and the direction is carried in flowDirection.
+ */
+struct mcx_flow {
+  std::string flow_description;
+  std::string flow_direction;  // UPLINK, DOWNLINK or BIDIRECTIONAL
+};
+
+/**
+ * Convert the fDescs of the media sub components into flow information.
+ * Uplink and downlink descriptions of the same 5-tuple are merged into one
+ * BIDIRECTIONAL flow.
+ */
+std::vector<mcx_flow> derive_flows(
+    const std::vector<std::string>& fdescs, const std::string& ue_ipv4);
+
+/**
+ * Map a ReservPriority ("PRIO_1".."PRIO_16") to an ARP priority level (1..15)
+ */
+int arp_priority_from_res_prio(
+    const std::optional<std::string>& res_prio,
+    const oai::config::pcf::mcx_qos_config& cfg);
+
+struct mcx_decision {
+  std::map<std::string, oai::model::pcf::PccRule> pcc_rules;
+  std::map<std::string, oai::model::pcf::QosData> qos_decs;
+};
+
+/**
+ * Build the PCC rules and QoS decisions for all the media components of an
+ * AppSessionContextReqData (raw JSON).
+ * @param asc_req_data: AppSessionContextReqData as JSON
+ * @param app_session_id: ID of the application session (used in rule IDs)
+ * @param used_precedences: precedences already in use in the SM policy
+ * decision (MCX rules of this app session must not be part of it)
+ * @param cfg: mapping configuration
+ * @param error: human readable error
+ * @return the decision, std::nullopt in case the service information is
+ * invalid
+ */
+std::optional<mcx_decision> build_mcx_decision(
+    const nlohmann::json& asc_req_data, const std::string& app_session_id,
+    const std::set<int32_t>& used_precedences,
+    const oai::config::pcf::mcx_qos_config& cfg, std::string& error);
+
+/**
+ * Remove all the PCC rules / QoS decisions belonging to an app session from
+ * the given decision
+ */
+void remove_app_session_rules(
+    const std::string& app_session_id,
+    oai::model::pcf::SmPolicyDecision& decision);
+
+/**
+ * Return true if the PCC rule / QoS data ID is a dynamic MCX one
+ */
+bool is_mcx_id(const std::string& id);
+
+}  // namespace oai::pcf::app::policy_auth::mcx
+
+#endif

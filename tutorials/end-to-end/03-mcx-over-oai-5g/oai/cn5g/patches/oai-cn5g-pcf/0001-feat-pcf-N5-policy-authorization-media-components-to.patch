+//------------------------------------------------------------------------------
+nlohmann::json pcf_smpc::compute_decision_delta(
+    const SmPolicyDecision& old_decision,
+    const SmPolicyDecision& new_decision) {
+  nlohmann::json delta = nlohmann::json::object();
+
+  auto diff_map = [&delta](
+                      const std::string& name, const auto& old_map,
+                      const auto& new_map) {
+    nlohmann::json j = nlohmann::json::object();
+    for (const auto& [key, value] : new_map) {
+      auto it = old_map.find(key);
+      if (it == old_map.end() || !(it->second == value)) {
+        nlohmann::json v;
+        to_json(v, value);
+        j[key] = v;
+      }
+    }
+    for (const auto& [key, value] : old_map) {
+      if (new_map.find(key) == new_map.end()) {
+        // TS 29.512: removal of a PCC rule / decision is indicated with null
+        j[key] = nullptr;
+      }
+    }
+    if (!j.empty()) delta[name] = j;
+  };
+
+  diff_map(
+      "pccRules", old_decision.getPccRules(), new_decision.getPccRules());
+  diff_map("qosDecs", old_decision.getQosDecs(), new_decision.getQosDecs());
+  diff_map(
+      "traffContDecs", old_decision.getTraffContDecs(),
+      new_decision.getTraffContDecs());
+  diff_map(
+      "sessRules", old_decision.getSessRules(), new_decision.getSessRules());
+  return delta;
 }
 

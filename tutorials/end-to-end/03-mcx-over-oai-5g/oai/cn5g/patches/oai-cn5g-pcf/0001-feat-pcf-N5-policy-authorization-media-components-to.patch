+//------------------------------------------------------------------------------
+handler_result pcf_policy_authorization::apply_media_components(
+    const std::string& app_session_id, const nlohmann::json& raw_context,
+    oai::model::pcf::SmPolicyDecision& decision) {
+  // remove previous rules of this app session (update case)
+  mcx::remove_app_session_rules(app_session_id, decision);
+
+  std::string error;
+  auto mcx_decision = mcx::build_mcx_decision(
+      raw_context, app_session_id, used_precedences(decision),
+      pcf_cfg->get_mcx_qos_config(), error);
+  if (!mcx_decision.has_value()) {
+    Logger::pcf_app().warn(
+        "Invalid media component information: %s", error.c_str());
+    return handler_result{
+        .status          = status_code::FORBIDDEN,
+        .problem_details = "INVALID_SERVICE_INFORMATION"};
+  }
+
+  auto pcc_rules = decision.getPccRules();
+  for (const auto& [id, rule] : mcx_decision->pcc_rules) {
+    pcc_rules.insert_or_assign(id, rule);
+  }
+  decision.setPccRules(pcc_rules);
+
+  auto qos_decs = decision.getQosDecs();
+  for (const auto& [id, qos] : mcx_decision->qos_decs) {
+    qos_decs.insert_or_assign(id, qos);
+  }
+  decision.setQosDecs(qos_decs);
+
+  return handler_result{.status = status_code::OK};
+}

     pcc_rules_path: /openair-pcf/policies/pcc_rules
     traffic_rules_path: /openair-pcf/policies/traffic_rules
+  # Optional: Npcf_PolicyAuthorization (N5) media components -> PCC rules / QoS
+  # (used e.g. by an MCPTT AF). All values below are the defaults.
+  mcx_qos:
+    audio_5qi: 65        # medType AUDIO (GBR, mission critical PTT voice)
+    video_5qi: 67        # medType VIDEO (GBR, mission critical video)
+    other_5qi: 69        # other media types (non-GBR)
+    default_arp_priority: 3      # resPrio absent (or removed with null)
+    res_prio_arp:        # TS 29.514 ReservPriority (PRIO_16 = highest) -> ARP
+      PRIO_16: 1
+      PRIO_15: 2
+      PRIO_14: 2
+      PRIO_13: 2
+      PRIO_12: 2
+    emergency_arp_threshold: 1   # ARP <= threshold -> NOT_PREEMPTABLE
+    precedence_base: 10  # must be lower than the default "match all" PCC rule
+    default_bandwidth: "64 Kbps" # GBR/MBR when marBwUl/Dl are absent
 
 nssf:
   slice_config_path: /openair-nssf/etc/nssf_slice_config.yaml

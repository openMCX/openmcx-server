+//------------------------------------------------------------------------------
+bool smf_context::handle_ran_rejected_qos_flows(
+    std::shared_ptr<itti_sbi_update_sm_context_request>& smreq,
+    std::shared_ptr<itti_sbi_update_sm_context_response>& sm_context_resp,
+    std::shared_ptr<smf_pdu_session>& sp,
+    const std::map<std::string, uint8_t>& failed, const std::string& cause) {
+  pcf_policy_change change;
+  for (const auto& [pcc_rule_id, qfi] : failed) {
+    Logger::smf_app().warn(
+        "NG-RAN refused QoS flow QFI %d (PCC rule %s, %s): release it at the "
+        "UPF and report the PCC rule to the PCF",
+        qfi, pcc_rule_id.c_str(), cause.c_str());
+    pcf_qos_flow_change c;
+    c.pcc_rule_id = pcc_rule_id;
+    c.qfi         = qfi;
+    change.to_release.push_back(c);
+  }
+
+  auto proc = std::make_shared<session_update_sm_context_procedure>(sp);
+  std::shared_ptr<smf_procedure> sproc = proc;
+  proc->session_procedure_type         = session_management_procedures_type_e::
+      PDU_SESSION_MODIFICATION_PCF_INITIATED;
+  proc->pcf_change   = change;
+  proc->ran_rejected = true;
+  proc->ran_cause    = cause;
+  insert_procedure(sproc);
+  if (proc->run(smreq, sm_context_resp, shared_from_this()) ==
+      smf_procedure_code::ERROR) {
+    Logger::smf_app().warn(
+        "Release of the QoS flows refused by the NG-RAN failed");
+    remove_procedure(sproc.get());
+    smf_app_inst->trigger_http_response(
+        http_status_code::INTERNAL_SERVER_ERROR, smreq->pid,
+        N11_SESSION_UPDATE_SM_CONTEXT_RESPONSE);
+  }
+  return true;
+}
+
+//------------------------------------------------------------------------------
+void smf_context::report_failed_pcc_rules(
+    const std::shared_ptr<smf_pdu_session>& sp,
+    const std::vector<pcf_qos_flow_change>& failed, const std::string& cause) {
+  if (!sp->policy_ptr || failed.empty()) return;
+
+  // The PCC rules are no longer active in this SMF
+  auto rules = sp->policy_ptr->decision.getPccRules();
+  std::vector<std::string> ids;
+  for (const auto& change : failed) {
+    rules.erase(change.pcc_rule_id);
+    ids.push_back(change.pcc_rule_id);
+  }
+  sp->policy_ptr->decision.setPccRules(rules);
+
+  nlohmann::json update = {
+      {"ruleReports",
+       nlohmann::json::array(
+           {{{"pccRuleIds", ids},
+             {"ruleStatus", "INACTIVE"},
+             {"failureCode", "RES_ALLO_FAIL"}}})}};
+  oai::model::pcf::SmPolicyUpdateContextData update_data;
+  try {
+    from_json(update, update_data);
+  } catch (std::exception& e) {
+    Logger::smf_n7().warn("Cannot build the rule report: %s", e.what());
+    return;
+  }
+  Logger::smf_n7().info(
+      "Npcf_SMPolicyControl_Update: PCC rule(s) %s INACTIVE, RES_ALLO_FAIL "
+      "(%s)",
+      nlohmann::json(ids).dump().c_str(), cause.c_str());
+  // The response carries the PCF's decision, which the N7 client stores as
+  // the association's decision; the SMF's own view of its PCC rules stays
+  const auto decision = sp->policy_ptr->decision;
+  auto status = n7::smf_n7::get_instance().update_sm_policy_association(
+      update_data, sp->policy_ptr);
+  sp->policy_ptr->decision = decision;
+  if (status != n7::sm_policy_status_code::OK) {
+    Logger::smf_n7().warn("The PCF did not accept the rule report");
+  }
+}

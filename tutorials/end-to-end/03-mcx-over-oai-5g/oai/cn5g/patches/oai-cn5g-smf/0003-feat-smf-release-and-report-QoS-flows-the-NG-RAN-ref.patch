+//------------------------------------------------------------------------------
+// The QoS Flow Failed to Add or Modify List of a PDU Session Resource Modify
+// Response Transfer (TS 38.413 9.3.4.2): QFI and cause of each QoS flow
+static std::vector<std::pair<uint8_t, std::string>>
+failed_qos_flows_of_modify_response(const std::string& n2_sm_information) {
+  std::vector<std::pair<uint8_t, std::string>> failed;
+  auto decoded =
+      std::make_shared<oai::ngap::PduSessionResourceModifyResponseTransfer>();
+  if (smf_n2::get_instance().decode_n2_sm_information(
+          decoded, n2_sm_information) == KEncodeDecodeError)
+    return failed;
+  std::optional<oai::ngap::QosFlowListWithCause> list = {};
+  decoded->getQosFlowFailedToAddOrModifyList(list);
+  if (!list.has_value()) return failed;
+  std::vector<oai::ngap::QosFlowWithCauseItem> items;
+  list.value().get(items);
+  for (const auto& item : items) {
+    oai::ngap::QosFlowIdentifier qfi = {};
+    oai::ngap::Cause cause           = {};
+    item.get(qfi, cause);
+    failed.emplace_back(
+        static_cast<uint8_t>(qfi.get()),
+        fmt::format(
+            "NGAP cause group {} value {}",
+            static_cast<int>(cause.getChoiceOfCause()), cause.get()));
+  }
+  return failed;
+}

+//------------------------------------------------------------------------------
+void session_handler::set_pending_flows(
+    const std::map<std::string, uint8_t>& flows) {
+  std::unique_lock lock(m_session_handler_mutex);
+  m_pending_flows = flows;
+}
+
+//------------------------------------------------------------------------------
+std::map<std::string, uint8_t> session_handler::take_pending_flows() {
+  std::unique_lock lock(m_session_handler_mutex);
+  auto flows = std::move(m_pending_flows);
+  m_pending_flows.clear();
+  return flows;
+}

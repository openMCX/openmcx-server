diff --git a/ngap/ngap_msgs/PduSessionResourceModifyResponse.cpp b/ngap/ngap_msgs/PduSessionResourceModifyResponse.cpp
index 183eff7e..c3bffd5e 100644
--- a/ngap/ngap_msgs/PduSessionResourceModifyResponse.cpp
+++ b/ngap/ngap_msgs/PduSessionResourceModifyResponse.cpp
@@ -30,6 +30,7 @@ namespace oai::ngap {
 PduSessionResourceModifyResponseMsg::PduSessionResourceModifyResponseMsg()
     : NgapUeMessage() {
   m_PduSessionResourceModifyList = std::nullopt;
+  m_FailedToModifyList           = nullptr;
   setMessageType(NgapMessageType::PDU_SESSION_RESOURCE_MODIFY_RESPONSE);
   initialize();
 }
@@ -168,6 +169,23 @@ bool PduSessionResourceModifyResponseMsg::
   return true;
 }
 
+//------------------------------------------------------------------------------
+bool PduSessionResourceModifyResponseMsg::
+    getPduSessionResourceFailedToModifyList(
+        std::vector<PDUSessionResourceModifyResponseItem_t>& list) const {
+  if (!m_FailedToModifyList) return false;
+  for (int i = 0; i < m_FailedToModifyList->list.count; i++) {
+    const auto* item = m_FailedToModifyList->list.array[i];
+    if (!item) continue;
+    PDUSessionResourceModifyResponseItem_t failed = {};
+    failed.pduSessionId = static_cast<uint8_t>(item->pDUSessionID);
+    failed.pduSessionResourceModifyUnsuccessfulTransfer =
+        item->pDUSessionResourceModifyUnsuccessfulTransfer;
+    list.push_back(failed);
+  }
+  return true;
+}

# This computer's IPv4 address on the Wi-Fi, which the phones reach (as in tutorial 1).
HOST_IP=
# OpenMCX images from Docker Hub (empty prefix: locally built images).
OPENMCX_IMAGE_PREFIX=openmcx/
OPENMCX_TAG=1.0.0
# OAI: the AMF, PCF, SMF and UPF patched for N5 (oai/cn5g/; oai-amf:mcx-n5 and so on when built with
# oai/cn5g/build-images.sh), the other core functions and the gNB and nr-UE OAI's, all from Docker Hub.
AMF_IMG=openmcx/oai-amf:mcx-n5
PCF_IMG=openmcx/oai-pcf:mcx-n5
SMF_IMG=openmcx/oai-smf:mcx-n5
UPF_IMG=openmcx/oai-upf:mcx-n5
CN_TAG=v2.2.1
RAN_TAG=2026.w39

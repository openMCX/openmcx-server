# The system of tutorial 1: this computer's address on the Wi-Fi, as in tutorial 1's .env.
HOST_IP=
# The dispatcher's computer, when it is not tutorial 1's (default: HOST_IP).
DISPATCHER_IP=
# The image: openmcx/openmcx-dispatcher:1.0.0 from Docker Hub (empty prefix: a locally built openmcx-dispatcher).
OPENMCX_IMAGE_PREFIX=openmcx/
OPENMCX_TAG=1.0.0
# The debug log, off by default: one line per SIP message and HTTP request in `docker logs` (docs/USAGE.md
# section 7). Uncomment to switch it on, then `docker compose up -d` again.
# MCX_LOG=debug

# Copy to .env and set HOST_IP.

# This computer's IPv4 address on the Wi-Fi the phones use (Linux: `ip -4 route get 1.1.1.1`, the address after
# "src"; macOS: `ipconfig getifaddr en0`). The phones reach every service through it, Keycloak included.
HOST_IP=

# The OpenMCX images: <prefix>openmcx-<program>:<tag>. Images built on this computer: an empty prefix.
# develop: the main branch; Keycloak as IdMS needs a version after 1.0.0.
OPENMCX_IMAGE_PREFIX=openmcx/
OPENMCX_TAG=develop

# Keycloak, the IdMS of this tutorial (tested with 26.3.3).
KEYCLOAK_IMAGE=quay.io/keycloak/keycloak:26.3.3

# The debug log, off by default: one line per SIP message and HTTP request in `docker logs` (docs/USAGE.md
# section 7). Uncomment to switch it on, then `docker compose up -d` again.
# MCX_LOG=debug

From 829f0b0f13685228d59d75f333810dfb3c154b00 Mon Sep 17 00:00:00 2001
From: openMCX <noreply@openmcx.invalid>
Date: Mon, 5 Oct 2026 20:53:50 +0200
Subject: [PATCH 8/8] fix(nas-ue): a released EPS bearer context is removed
 from the bearer table

esm_ebr_release freed the EPS bearer context but left the table entry pointing at it. When the network set up a
bearer with the same EPS bearer identity again, the UE found the freed context ("EPS bearer context already
assigned"), and the bearer's state was read from freed memory.
---
 openair3/NAS/UE/ESM/esm_ebr.c | 3 ++-
 1 file changed, 2 insertions(+), 1 deletion(-)

diff --git a/openair3/NAS/UE/ESM/esm_ebr.c b/openair3/NAS/UE/ESM/esm_ebr.c
index 2c6f48e..d0c0b7a 100644
--- a/openair3/NAS/UE/ESM/esm_ebr.c
+++ b/openair3/NAS/UE/ESM/esm_ebr.c
@@ -1,5 +1,6 @@
 /*
  * SPDX-License-Identifier: LicenseRef-CSSL-1.0
+ * Modified by OpenMCX, 2026-10-05 (MCX over LTE); see the NOTICE file distributed with this software.
  */
 
 /*****************************************************************************
@@ -248,7 +249,7 @@ int esm_ebr_release(esm_ebr_data_t *esm_ebr_data,
 
   /* Release EPS bearer context data */
   free(ebr_ctx);
-  ebr_ctx = NULL;
+  esm_ebr_data->context[ebi - ESM_EBI_MIN] = NULL;
 
   LOG_TRACE(INFO, "ESM-FSM   - EPS bearer context %d released", ebi);
   LOG_FUNC_RETURN (RETURNok);
-- 
2.53.0


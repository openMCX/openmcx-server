From 6504ed76db4df09626b34e87b819499474894d39 Mon Sep 17 00:00:00 2001
From: openMCX <noreply@openmcx.invalid>
Date: Mon, 5 Oct 2026 20:53:50 +0200
Subject: [PATCH 7/8] fix(gtpu): an E-RAB release deletes the bearer's tunnel

gtpv1u_delete_s1u_tunnel removed the incoming TEID of a released E-RAB but kept the bearer in the UE's tunnel list.
When the network set up the E-RAB again, newGtpuCreateTunnel found that bearer and erased the UE's whole tunnel list,
the default bearer's tunnel included: the UE's uplink was dropped ("sending a packet to a non existant UE:RAB").
---
 openair3/ocp-gtpu/gtp_itf.cpp | 2 ++
 1 file changed, 2 insertions(+)

diff --git a/openair3/ocp-gtpu/gtp_itf.cpp b/openair3/ocp-gtpu/gtp_itf.cpp
index 04a1f62..54a5764 100644
--- a/openair3/ocp-gtpu/gtp_itf.cpp
+++ b/openair3/ocp-gtpu/gtp_itf.cpp
@@ -1,5 +1,6 @@
 /*
  * SPDX-License-Identifier: LicenseRef-CSSL-1.0
+ * Modified by OpenMCX, 2026-10-05 (MCX over LTE); see the NOTICE file distributed with this software.
  */
 
 #include <map>
@@ -996,6 +997,7 @@ int gtpv1u_delete_s1u_tunnel(const instance_t instance, const gtpv1u_enb_delete_
             req_pP->eps_bearer_id[i]);
     } else {
       globGtp.te2ue_mapping.erase(ptr2->second.teid_incoming);
+      ptrRNTI->second.bearers.erase(ptr2);
       nb++;
     }
   }

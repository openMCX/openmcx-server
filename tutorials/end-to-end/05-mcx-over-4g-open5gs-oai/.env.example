# Copy to .env and set HOST_IP (tutorial 5, tutorials/end-to-end/05-mcx-over-4g-open5gs-oai/README.md).

# This computer's IPv4 address on the Wi-Fi the phones use (Linux: `ip -4 route get 1.1.1.1`, the address after
# "src"). The phones and the dispatcher reach every service through it.
HOST_IP=

# The OpenMCX images: <prefix>openmcx-<program>:<tag>. Images built on this computer: an empty prefix.
OPENMCX_IMAGE_PREFIX=openmcx/
OPENMCX_TAG=1.0.0

# The EPC (Open5GS v2.8.0 with OpenMCX's PCRF patch, open5gs/), the eNB and the LTE UE (OAI 2026.w39 with OpenMCX's
# patches, oai/ran/). Images built on this computer: open5gs:2.8.0-mcx, oai-enb:2026.w39-mcx and
# oai-lte-ue:2026.w39-mcx.
OPEN5GS_IMG=openmcx/open5gs:2.8.0-mcx
ENB_IMG=openmcx/oai-enb:2026.w39-mcx
UE_IMG=openmcx/oai-lte-ue:2026.w39-mcx

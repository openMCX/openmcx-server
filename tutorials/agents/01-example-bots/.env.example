# Copy to .env and set HOST_IP.

# The system of End-to-End Tutorial 1: its computer's address on the Wi-Fi, as in tutorial 1's .env.
HOST_IP=
# The agent's computer, when it is not tutorial 1's (default: HOST_IP).
AGENT_IP=
# The agent's image, built from openmcx-client (README.md, "What you need").
OPENMCX_AGENT_IMAGE=openmcx-agent:local
# The debug log, off by default: one line per SIP message and HTTP request in `docker logs` (docs/USAGE.md
# section 7). Uncomment to switch it on, then `docker compose up -d` again.
# MCX_LOG=debug

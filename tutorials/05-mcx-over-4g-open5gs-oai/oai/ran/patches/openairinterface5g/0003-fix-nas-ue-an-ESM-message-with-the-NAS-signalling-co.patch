From 7cfa40abc7d39667a91632c40c0158cef8486cad Mon Sep 17 00:00:00 2001
From: openMCX <noreply@openmcx.invalid>
Date: Mon, 5 Oct 2026 18:52:19 +0200
Subject: [PATCH 3/4] fix(nas-ue): an ESM message with the NAS signalling
 connection goes to ESM (TS 24.301 5.3.1)

With a connection set up for a service request, the network can send the NAS message of a dedicated bearer
(Activate Dedicated EPS Bearer Context Request) in the first RRC connection reconfiguration. The UE handled it as an
initial EMM message, found none of Attach Accept, Attach Reject, Detach Accept or TAU Accept, and answered EMM Status
cause 98: the bearer was never accepted. An ESM message received with the connection is now processed by the
downlink NAS transport path, as on an established connection.
---
 openair3/NAS/UE/EMM/SAP/emm_as.c | 18 ++++++++++++++++++
 1 file changed, 18 insertions(+)

diff --git a/openair3/NAS/UE/EMM/SAP/emm_as.c b/openair3/NAS/UE/EMM/SAP/emm_as.c
index 0992b6c..77d17e7 100644
--- a/openair3/NAS/UE/EMM/SAP/emm_as.c
+++ b/openair3/NAS/UE/EMM/SAP/emm_as.c
@@ -1,5 +1,6 @@
 /*
  * SPDX-License-Identifier: LicenseRef-CSSL-1.0
+ * Modified by openMCX, 2026 (MCX over LTE): see NOTICE in https://github.com/openMCX/openmcx-server/tree/main/tutorials/05-mcx-over-4g-open5gs-oai/oai/ran
  */
 
 /*****************************************************************************
@@ -503,6 +504,23 @@ static int _emm_as_establish_cnf(nas_user_t *user, const emm_as_establish_t *msg
     LOG_FUNC_RETURN (decoder_rc);
   }
 
+  /* 3GPP TS 24.301 5.3.1: once the NAS signalling connection is established
+   * the network may send any NAS message with it, for example the ESM
+   * message of a dedicated bearer set up with the connection (an E-RAB
+   * setup after a service request). Such a message is processed as on an
+   * established connection, by the downlink NAS transport path. */
+  if (nas_msg.plain.emm.header.protocol_discriminator ==
+      EPS_SESSION_MANAGEMENT_MESSAGE) {
+    emm_as_data_t data;
+    memset(&data, 0, sizeof(data));
+    data.ueid = msg->ueid;
+    data.sctx = msg->sctx;
+    data.NASmsg = msg->NASmsg;
+    data.delivered = true;
+    rc = _emm_as_data_ind(user, &data, emm_cause);
+    LOG_FUNC_RETURN (rc);
+  }
+
   /* Process initial NAS message */
   EMM_msg *emm_msg = &nas_msg.plain.emm;
 

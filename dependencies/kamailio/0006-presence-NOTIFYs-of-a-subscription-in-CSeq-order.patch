  * with Subscription-State "terminated" and the subscription is then deleted; no empty reason parameter.
+ * Modified by OpenMCX on 2026-11-09 (GPL-2.0 section 2(a)): the NOTIFYs of a subscription leave in CSeq order (a
+ * reentrant lock per subscription hash slot, held by notify() from taking the CSeq to sending the request).
  *
  */
 
@@ -54,6 +56,7 @@
 #include "presence_dmq.h"
 #include "subscribe.h"
 #include "../../core/receive.h"
+#include "../../core/locking.h"
 
 #define ALLOC_SIZE 3000
 #define MAX_FORWARD 70
@@ -1811,9 +1814,41 @@ error:
 }
 
 
+/* NOTIFYs of a subscription in CSeq order: RFC 3261 clause 12.2.1.1, the CSeq
+ * of a request within a dialog "MUST be strictly monotonically increasing";
+ * clause 12.2.2, a UAS rejects a request with a lower CSeq than the last one
+ * received with a 500. notify() takes the next CSeq of the subscription and
+ * then builds and sends the NOTIFY; without a lock, a NOTIFY whose body takes
+ * longer to build (the first one, from the presentity table) left after a
+ * later one of another process (a PUBLISH's, with its body ready). The lock of
+ * the subscription's hash slot is held from taking the CSeq to sending the
+ * request (reentrant: the reply callback may run in the same process). */
+rec_lock_set_t *pres_notify_order_locks = NULL;
+
+static int notify_in_order(subs_t *subs, subs_t *watcher_subs, str *n_body,
+		int force_null_body, aux_body_processing_t *aux_body_processing);
+
 int notify(subs_t *subs, subs_t *watcher_subs, str *n_body, int force_null_body,
 		aux_body_processing_t *aux_body_processing)
 {
+	unsigned int hash_code;
+	int ret;
+
+	if(pres_notify_order_locks == NULL) {
+		return notify_in_order(subs, watcher_subs, n_body, force_null_body,
+				aux_body_processing);
+	}
+	hash_code = core_case_hash(&subs->pres_uri, &subs->event->name, shtable_size);
+	rec_lock_set_get(pres_notify_order_locks, hash_code);
+	ret = notify_in_order(
+			subs, watcher_subs, n_body, force_null_body, aux_body_processing);
+	rec_lock_set_release(pres_notify_order_locks, hash_code);
+	return ret;
+}
+
+static int notify_in_order(subs_t *subs, subs_t *watcher_subs, str *n_body,
+		int force_null_body, aux_body_processing_t *aux_body_processing)
+{
 
 	str *aux_body = NULL;
 

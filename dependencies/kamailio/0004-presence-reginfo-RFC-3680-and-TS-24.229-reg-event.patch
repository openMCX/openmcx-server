+/*!
+ * \brief The record of an address-of-record in a usrloc domain, locked; NULL
+ * (and an RPC fault) when there is none
+ */
+static urecord_t *rpc_record(rpc_t *rpc, void *ctx, str *table, str *aor,
+		udomain_t **domain)
+{
+	urecord_t *record = NULL;
+	char name[64];
+
+	if(table->len <= 0 || table->len >= (int)sizeof(name)) {
+		rpc->fault(ctx, 400, "Invalid usrloc domain");
+		return NULL;
+	}
+	memcpy(name, table->s, table->len);
+	name[table->len] = '\0';
+	if(ul.get_udomain(name, domain) < 0) {
+		rpc->fault(ctx, 404, "Unknown usrloc domain");
+		return NULL;
+	}
+	ul.lock_udomain(*domain, aor);
+	if(ul.get_urecord(*domain, aor, &record) != 0 || record == NULL
+			|| record->contacts == NULL) {
+		ul.unlock_udomain(*domain, aor);
+		rpc->fault(ctx, 404, "No contact registered for the AOR");
+		return NULL;
+	}
+	return record;
+}
+
+/*!
+ * \brief reginfo.shorten <domain> <aor> <seconds>: every contact of the AOR
+ * expires after <seconds> (TS 24.229 clause 5.4.1.6: "shorten the validity of
+ * all registration lifetimes"); one document with the event "shortened" and
+ * the new expiry ("an operator defined value", given by the operator here)
+ */
+static void rpc_shorten(rpc_t *rpc, void *ctx)
+{
+	str table = {0, 0}, aor = {0, 0};
+	int seconds = 0;
+	udomain_t *domain = NULL;
+	urecord_t *record;
+	ucontact_t *c;
+	time_t now = time(0);
+
+	if(rpc->scan(ctx, "SSd", &table, &aor, &seconds) < 3) {
+		rpc->fault(ctx, 400, "Expected: usrloc domain, AOR, seconds");
+		return;
+	}
+	if(seconds <= 0) {
+		rpc->fault(ctx, 400, "The expiry must be positive");
+		return;
+	}
+	record = rpc_record(rpc, ctx, &table, &aor, &domain);
+	if(record == NULL)
+		return;
+	for(c = record->contacts; c; c = c->next) {
+		if(VALID_CONTACT(c, now) && c->expires > now + seconds)
+			c->expires = now + seconds;
+	}
+	reginfo_event_override = "shortened";
+	reginfo_usrloc_cb(record->contacts, UL_CONTACT_UPDATE, NULL);
+	reginfo_event_override = NULL;
+	ul.release_urecord(record);
+	ul.unlock_udomain(domain, &aor);
+	rpc->rpl_printf(ctx, "shortened");
+}
+
+/*!
+ * \brief reginfo.deregister <domain> <aor> <event>: every contact of the AOR
+ * is removed, published as terminated with the event "deactivated" (the user
+ * is expected to register again) or "rejected" (not) (TS 24.229 clause
+ * 5.4.1.5); the release of the user's sessions before it is the caller's
+ */
+static void rpc_deregister(rpc_t *rpc, void *ctx)
+{
+	str table = {0, 0}, aor = {0, 0}, event = {0, 0};
+	udomain_t *domain = NULL;
+	urecord_t *record;
+	ucontact_t *c, *next;
+
+	if(rpc->scan(ctx, "SSS", &table, &aor, &event) < 3) {
+		rpc->fault(ctx, 400, "Expected: usrloc domain, AOR, event");
+		return;
+	}
+	if(!(event.len == 11 && strncmp(event.s, "deactivated", 11) == 0)
+			&& !(event.len == 8 && strncmp(event.s, "rejected", 8) == 0)) {
+		rpc->fault(ctx, 400, "The event must be deactivated or rejected");
+		return;
+	}
+	record = rpc_record(rpc, ctx, &table, &aor, &domain);
+	if(record == NULL)
+		return;
+	reginfo_event_override =
+			event.s[0] == 'd' ? "deactivated" : "rejected";
+	for(c = record->contacts; c; c = next) {
+		next = c->next;
+		ul.delete_ucontact(record, c);
+	}
+	reginfo_event_override = NULL;
+	ul.release_urecord(record);
+	ul.unlock_udomain(domain, &aor);
+	rpc->rpl_printf(ctx, "deregistered");
+}

+/*!
+ * \brief 1 if the reginfo document has at least one registration element and
+ * every registration element has the state "terminated"
+ */
+int reginfo_is_final_body(str *body)
+{
+	xmlDocPtr doc;
+	xmlNodePtr node;
+	xmlChar *state;
+	int registrations = 0, terminated = 0;
+
+	if(body == NULL || body->s == NULL || body->len <= 0)
+		return 0;
+	doc = xmlParseMemory(body->s, body->len);
+	if(doc == NULL)
+		return 0;
+	node = xmlDocGetRootElement(doc);
+	for(node = node ? node->children : NULL; node; node = node->next) {
+		if(node->type != XML_ELEMENT_NODE
+				|| xmlStrcmp(node->name, BAD_CAST "registration") != 0)
+			continue;
+		registrations++;
+		state = xmlGetProp(node, BAD_CAST "state");
+		if(state && xmlStrcmp(state, BAD_CAST "terminated") == 0)
+			terminated++;
+		if(state)
+			xmlFree(state);
+	}
+	xmlFreeDoc(doc);
+	return registrations > 0 && registrations == terminated;
+}

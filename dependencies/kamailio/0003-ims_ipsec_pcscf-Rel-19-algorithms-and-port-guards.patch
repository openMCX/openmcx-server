+ * module parameter ipsec_temp_set_lifetime). */
+static int ipsec_record_set(struct sip_msg *req, tm_cell_t *t, ipsec_t *s, unsigned short parent_uc)
+{
+	str impi = ipsec_register_impi(req);
+	spi_set_t r;
+	int ret;
+
+	ipsec_set_of(&r, &req->rcv.src_ip, s);

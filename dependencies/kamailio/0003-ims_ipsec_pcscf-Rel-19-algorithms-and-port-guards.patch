+				"%sipsec-3gpp;q=0.%d;alg=%.*s;ealg=%.*s;prot=esp;mod=trans;"
+				"spi-c=%u;spi-s=%u;port-c=%u;port-s=%u",
+				i ? ", " : "", q > 0 ? q : 1, ipsec_alg_list[i].len,
+				ipsec_alg_list[i].s, ipsec_ealg_list[i].len,

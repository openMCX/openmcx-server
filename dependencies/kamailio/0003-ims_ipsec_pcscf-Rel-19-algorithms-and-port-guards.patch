+/* OpenMCX, 2026-10-25: deletes a set from its record (destroy_ipsec_tunnel(), which releases its SPI pair and so
+ * its record). */
+static void ipsec_destroy_set(const spi_set_t *r)
+{
+	ipsec_t tmp;
+	char buf[IP_ADDR_MAX_STR_SIZE];
+	str remote;
+
+	memset(&tmp, 0, sizeof(ipsec_t));
+	tmp.spi_uc = r->spi_uc;
+	tmp.spi_us = r->spi_us;
+	tmp.spi_pc = r->spi_pc;
+	tmp.spi_ps = r->spi_ps;
+	tmp.port_uc = r->port_uc;
+	tmp.port_us = r->port_us;
+	tmp.port_pc = r->port_pc;
+	tmp.port_ps = r->port_ps;
+	remote.len = ip_addr2sbuf((struct ip_addr *)&r->ue, buf, sizeof(buf));
+	remote.s = buf;
+	destroy_ipsec_tunnel(remote, &tmp, r->port_uc);
+}
+
+static int ipsec_destroy_set_when_idle(const spi_set_t *r);
+
+/* OpenMCX, 2026-10-25: TS 33.203 V19.1.0 clause 7.4.2a, the P-CSCF creating the new SAs of a challenge: "The
+ * registration SAs shall be deleted if they exist" (the "two existing pairs of SAs from an incomplete
+ * authentication"), and clause 7.3.1.4: "When the P-CSCF receives a challenge from the S-CSCF and creates the
+ * corresponding SAs during a registration procedure, it shall delete any information relating to any previous
+ * registration procedure (including the SAs created during the previous registration procedure)." Called when the
+ * S-CSCF's challenge (the 401 with ck and ik) arrives, before its set is created, for the UE registration of the
+ * REGISTER: the same private user identity and the same UE address ("the UE related SAs"; clause 7.4.1a, "The UE
+ * shall be involved in only one registration procedure at a time"). Its temporary sets (never one whose
+ * registration completed: in use, or old and waiting for its pending transactions) are deleted; the one the challenged REGISTER came over (req's source, on a protected port) once that REGISTER's
+ * transaction has ended, so that the 401 still goes over it (TS 24.229 clause 5.2.2.2, 401 item 5). */
+static void ipsec_delete_registration_sets(struct sip_msg *req)
+{
+	str impi = ipsec_register_impi(req);
+	struct ip_addr *ue = &req->rcv.src_ip;
+	unsigned short port_uc = 0;
+	uint32_t cursor = 0;
+	spi_set_t r;
+
+	if(impi.s == NULL || impi.len <= 0) {
+		return;
+	}
+	if(ipsec_protected_port(req->rcv.dst_port)) {
+		port_uc = req->rcv.src_port;
+	}
+	while(spi_set_next_temporary(&cursor, &impi, ue, port_uc, 0, &r)) {
+		LM_INFO("deleting the registration security associations of %.*s (port_uc %u): a new challenge\n",
+				impi.len, impi.s, r.port_uc);
+		ipsec_destroy_set(&r);
+	}
+	if(port_uc != 0 && spi_set_find(ue, port_uc, &r) && r.temporary) {
+		ipsec_destroy_set_when_idle(&r);
+	}
+}

 static int destroy_ipsec_tunnel(
 		str remote_addr, ipsec_t *s, unsigned short received_port)
 {
+	/* OpenMCX, 2026-10-25: a set already destroyed (its SPIs given back to the pool, below) is not destroyed again:
+	 * the old set of a re-registration is deleted early (ipsec_destroy_by_contact() from the configuration, TS 33.203
+	 * clause 7.4.2a) and once more when its contact expires; a second release_spi() would put the SPIs twice in the
+	 * pool. */
+	if(s->spi_pc == 0 && s->spi_ps == 0) {
+		return 0;
+	}
 	struct mnl_socket *sock = init_mnl_socket();
 	if(sock == NULL) {
 		return -1;
@@ -634,6 +686,18 @@ static int destroy_ipsec_tunnel(
 		return -1;
 	}
 
+	/* OpenMCX, 2026-10-25: a copy of a set's parameters (a contact's) whose set is gone - deleted by a later
+	 * challenge or its lifetime, its SPI pair free or given to another set since - deletes and releases nothing,
+	 * which would hit the other set. */
+	if(spi_set_check(s->spi_pc, s->spi_ps, &ip_addr, s->port_uc, s->spi_uc) < 0) {
+		LM_DBG("security associations spi_pc %u spi_ps %u of %.*s:%u already deleted\n", s->spi_pc,
+				s->spi_ps, remote_addr.len, remote_addr.s, s->port_uc);
+		s->spi_pc = 0;
+		s->spi_ps = 0;
+		close_mnl_socket(sock);
+		return 0;
+	}
+
 	if(ip_addr.af == AF_INET6) {
 		ipsec_addr = ipsec_listen_addr6;
 	} else {
@@ -698,6 +762,8 @@ static int destroy_ipsec_tunnel(
 
 	// Release SPIs
 	release_spi(s->spi_pc, s->spi_ps, s->port_pc, s->port_ps);
+	s->spi_pc = 0;
+	s->spi_ps = 0;
 
 	close_mnl_socket(sock);
 	return 0;
@@ -799,16 +865,31 @@ int add_security_server_header(struct sip_msg *m, ipsec_t *s)
 	}
 	memset(sec_header, 0, sizeof(str));
 
-	// create a temporary buffer and set the value in it
-	char sec_hdr_buf[1024];
+	/* OpenMCX, 2026-10-25: TS 33.203 clause 7.2 SM6: "a list of identifiers for the integrity and encryption
+	 * algorithms, which the PCSCF supports": one mechanism per combination of the P-CSCF's list (ipsec_algorithms),
+	 * by priority (q from 0.9 down), with the P-CSCF's SPIs and ports; the UE takes the first it supports, the one
+	 * the P-CSCF selected (the same rule, RFC 3329 section 2.3.1). Formerly only the selected one was sent. */
+	char sec_hdr_buf[2048];
+	int i, used;
 	memset(sec_hdr_buf, 0, sizeof(sec_hdr_buf));

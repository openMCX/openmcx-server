+				impi.len, impi.s, TS33203_MAX_SAS_PER_DIRECTION);
+	} else if(ret != 0) {
+		LM_ERR("cannot record the security associations (spi_pc %u, spi_ps %u)\n", s->spi_pc, s->spi_ps);
+	}
+	return ret;
+}
+
+/* OpenMCX, 2026-10-25: the port_uc of the completed set the challenged REGISTER (SM1) came over, the old SAs of
+ * clause 7.4.2a; 0 if SM1 was unprotected. Over a temporary set (a REGISTER answering an earlier challenge, itself
+ * challenged), the completed set that set's SM1 came over. */
+static unsigned short ipsec_sm1_set(struct sip_msg *req)
+{
+	spi_set_t r;
+
+	if(!ipsec_protected_port(req->rcv.dst_port) || !spi_set_find(&req->rcv.src_ip, req->rcv.src_port, &r)) {
+		return 0;
+	}
+	return r.temporary ? r.parent_uc : r.port_uc;
+}

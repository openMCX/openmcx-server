+/* OpenMCX, 2026-10-25: the next completed set of the UE registration of the set of (ue, port_uc) from *cursor on,
+ * other than that set: 1 and a copy in out, 0 when there is none left. */
+int spi_set_next_sibling(uint32_t *cursor, struct ip_addr *ue, uint16_t port_uc, spi_set_t *out)
+{
+	spi_slot_t *ref;
+	int found = 0;
+
+	if(!spi_data || spi_data->slots == NULL) {
+		return 0;
+	}
+	lock_get(spi_data->lock);
+	ref = spi_slot_of(ue, port_uc);
+	for(; ref != NULL && *cursor < spi_data->slot_count && !found; (*cursor)++) {
+		spi_slot_t *o = &spi_data->slots[*cursor];
+		if(o != ref && !o->set.temporary && spi_slot_sibling(o, ref)) {
+			*out = o->set;
+			found = 1;
+		}
+	}
+	lock_release(spi_data->lock);
+	return found;
+}
+
+/* OpenMCX, 2026-10-25: TS 33.203 V19.1.0 clause 7.4.2a: the set of (ue, port_uc) is the one its UE registration
+ * uses for outbound messages (the others of the registration no longer); switch_pending: 1 if a newer completed
+ * set waits for the UE's first message over it, 0 if not, -1 unchanged. 1 if the set exists. */
+int spi_set_use_outbound(struct ip_addr *ue, uint16_t port_uc)
+{
+	spi_slot_t *ref;
+	uint32_t j;
+
+	if(!spi_data || spi_data->slots == NULL) {
+		return 0;
+	}
+	lock_get(spi_data->lock);
+	ref = spi_slot_of(ue, port_uc);
+	if(ref != NULL) {
+		for(j = 0; j < spi_data->slot_count; j++) {
+			spi_slot_t *o = &spi_data->slots[j];
+			if(o != ref && spi_slot_sibling(o, ref)) {
+				o->set.outbound = 0;
+			}
+		}
+		ref->set.outbound = 1;
+		ref->set.switch_pending = 0;
+	}
+	lock_release(spi_data->lock);
+	return ref != NULL;
+}
+
+/* OpenMCX, 2026-10-25: marks the completed set of (ue, port_uc) as waiting for the UE's first message over its
+ * inbound SA before it is taken into use for outbound messages (clause 7.4.2a). */
+int spi_set_wait_switch(struct ip_addr *ue, uint16_t port_uc)
+{
+	spi_slot_t *o;
+
+	if(!spi_data || spi_data->slots == NULL) {
+		return 0;
+	}
+	lock_get(spi_data->lock);
+	o = spi_slot_of(ue, port_uc);
+	if(o != NULL) {
+		o->set.switch_pending = 1;
+	}
+	lock_release(spi_data->lock);
+	return o != NULL;
+}
+
+/* OpenMCX, 2026-10-25: TS 33.203 V19.1.0 clause 7.4.2a: the set the UE registration of the set of (ue, port_uc)
+ * uses for outbound messages: the one taken into use (outbound), otherwise the latest completed one (also when the
+ * set in use has gone with its lifetime: "When the old SAs expire without a further SIP message protected by the new
+ * SAs, the new SAs are taken into use for outbound messages"), otherwise the set itself. 1 and a copy in out. */
+int spi_set_outbound_of(struct ip_addr *ue, uint16_t port_uc, spi_set_t *out)
+{
+	spi_slot_t *ref, *best = NULL;
+	uint32_t j;
+
+	if(!spi_data || spi_data->slots == NULL) {
+		return 0;
+	}
+	lock_get(spi_data->lock);
+	ref = spi_slot_of(ue, port_uc);
+	if(ref != NULL) {
+		for(j = 0; j < spi_data->slot_count; j++) {
+			spi_slot_t *o = &spi_data->slots[j];
+			if(o->set.temporary || !(o == ref || spi_slot_sibling(o, ref))) {
+				continue;
+			}
+			if(o->set.outbound) {
+				best = o;
+				break;
+			}
+			if(best == NULL || o->set.seq > best->set.seq) {
+				best = o;
+			}
+		}
+		*out = (best != NULL ? best : ref)->set;
+	}
+	lock_release(spi_data->lock);
+	return ref != NULL;
+}
+
+/* OpenMCX, 2026-10-25: the next temporary set from *cursor on: of impi and ue (not the one of exclude_uc, 0 for
+ * none) if impi is given, otherwise one whose expiry time is not after now. 1 and a copy in out, 0 when there is
+ * none left. */
+int spi_set_next_temporary(uint32_t *cursor, str *impi, struct ip_addr *ue,
+		uint16_t exclude_uc, time_t now, spi_set_t *out)
+{
+	int found = 0;
+
+	if(!spi_data || spi_data->slots == NULL) {
+		return 0;
+	}
+	lock_get(spi_data->lock);
+	for(; *cursor < spi_data->slot_count && !found; (*cursor)++) {
+		spi_slot_t *o = &spi_data->slots[*cursor];
+		if(!o->recorded || !o->set.temporary) {
+			continue;
+		}
+		if(impi != NULL) {
+			found = impi->len > 0 && spi_slot_impi(o, impi) && ip_addr_cmp(&o->set.ue, ue)
+					&& !(exclude_uc != 0 && o->set.port_uc == exclude_uc);
+		} else {
+			found = o->set.expires != 0 && o->set.expires <= now;
+		}
+		if(found) {
+			*out = o->set;
+		}
+	}
+	lock_release(spi_data->lock);
+	return found;
+}

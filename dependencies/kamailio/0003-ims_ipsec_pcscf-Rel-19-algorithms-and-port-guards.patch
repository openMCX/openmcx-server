 }
 
+/* OpenMCX, 2026-10-25: the private user identity of a REGISTER: the username of its Authorization header field
+ * (TS 24.229 clause 5.1.1.2.1 a), "the "username" header field parameter, set to the value of the private user
+ * identity"), as the configuration's $aU gives it; empty if the request has none. */
+static str ipsec_register_impi(struct sip_msg *req)
+{
+	str impi = STR_NULL;
+
+	if(req == NULL || parse_headers(req, HDR_AUTHORIZATION_F, 0) != 0
+			|| req->authorization == NULL) {
+		return impi;
+	}
+	if(parse_credentials(req->authorization) < 0
+			|| req->authorization->parsed == NULL) {
+		return impi;
+	}
+	impi = ((auth_body_t *)req->authorization->parsed)->digest.username.whole;
+	return impi;
+}
+
+/* OpenMCX, 2026-10-25: the parameters of a set as the SA_table holds them. */
+static void ipsec_set_of(spi_set_t *r, const struct ip_addr *ue, const ipsec_t *s)
+{
+	memset(r, 0, sizeof(spi_set_t));

+	r->spi_us = s->spi_us;
+	r->spi_pc = s->spi_pc;
+	r->spi_ps = s->spi_ps;
+	r->port_uc = s->port_uc;
+	r->port_us = s->port_us;
+	r->port_pc = s->port_pc;

+	s[0] = fc;
+	memcpy(s + 1, p0, p0_len);
+	s[1 + p0_len] = (unsigned char)(p0_len >> 8);
+	s[2 + p0_len] = (unsigned char)(p0_len & 0xff);
+	for(i = 0; i < 64; i++)

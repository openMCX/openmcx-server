+/* OpenMCX, 2026-10-25: TS 33.203 V19.1.0 clause 7.1: "No unprotected messages shall be sent from or received on the
+ * ports port_ps and port_pc." For each protected port of addr, an IN policy (any source to addr:port) and an OUT
+ * policy (addr:port to any destination) with action BLOCK at priority 4000, below the 2080 of the SAs' policies of
+ * add_policy(): a packet the SAs do not cover is dropped by the kernel, before Kamailio sees it, and no plaintext
+ * reply leaves the port. Tagged with a selector user other than xfrm_user_selector, so that clean_policy() and
+ * delete_unused_policy() keep them; XFRM_MSG_UPDPOLICY replaces those of an earlier start. */
+#define IPSEC_PORT_GUARD_PRIORITY 4000
+#define IPSEC_PORT_GUARD_USER 0x4f4d4358 /* "OMCX" */
+static int add_port_guard(struct mnl_socket *mnl_socket,
+		const struct ip_addr *addr, int port, int dir)
+{
+	char l_msg_buf[MNL_SOCKET_BUFFER_SIZE];
+	struct nlmsghdr *l_nlh;
+	struct xfrm_userpolicy_info *l_xpinfo;
+
+	memset(l_msg_buf, 0, sizeof(l_msg_buf));
+	l_nlh = mnl_nlmsg_put_header(l_msg_buf);
+	l_nlh->nlmsg_flags = NLM_F_REQUEST | NLM_F_ACK;
+	l_nlh->nlmsg_type = XFRM_MSG_UPDPOLICY;
+	l_nlh->nlmsg_seq = time(NULL);
+	l_xpinfo = (struct xfrm_userpolicy_info *)mnl_nlmsg_put_extra_header(
+			l_nlh, sizeof(struct xfrm_userpolicy_info));
+	l_xpinfo->sel.family = addr->af;
+	if(dir == XFRM_POLICY_IN) {
+		if(addr->af == AF_INET6) {
+			memcpy(l_xpinfo->sel.daddr.a6, addr->u.addr32,
+					sizeof(l_xpinfo->sel.daddr.a6));
+			l_xpinfo->sel.prefixlen_d = 128;
+		} else {
+			l_xpinfo->sel.daddr.a4 = addr->u.addr32[0];
+			l_xpinfo->sel.prefixlen_d = 32;
+		}
+		l_xpinfo->sel.dport = htons(port);
+		l_xpinfo->sel.dport_mask = 0xFFFF;
+	} else {
+		if(addr->af == AF_INET6) {
+			memcpy(l_xpinfo->sel.saddr.a6, addr->u.addr32,
+					sizeof(l_xpinfo->sel.saddr.a6));
+			l_xpinfo->sel.prefixlen_s = 128;
+		} else {
+			l_xpinfo->sel.saddr.a4 = addr->u.addr32[0];
+			l_xpinfo->sel.prefixlen_s = 32;
+		}
+		l_xpinfo->sel.sport = htons(port);
+		l_xpinfo->sel.sport_mask = 0xFFFF;
+	}
+	l_xpinfo->sel.user = htonl(IPSEC_PORT_GUARD_USER);
+	l_xpinfo->lft.soft_byte_limit = XFRM_INF;
+	l_xpinfo->lft.hard_byte_limit = XFRM_INF;
+	l_xpinfo->lft.soft_packet_limit = XFRM_INF;
+	l_xpinfo->lft.hard_packet_limit = XFRM_INF;
+	l_xpinfo->priority = IPSEC_PORT_GUARD_PRIORITY;
+	l_xpinfo->action = XFRM_POLICY_BLOCK;
+	l_xpinfo->share = XFRM_SHARE_ANY;
+	l_xpinfo->dir = dir;
+	if(mnl_socket_sendto(mnl_socket, l_nlh, l_nlh->nlmsg_len) < 0) {
+		LM_ERR("Failed to send the port guard policy: %s\n", strerror(errno));
+		return -1;
+	}
+	return wait_nl_ack(mnl_socket);
+}
+
+int add_port_guards(struct mnl_socket *mnl_socket, const struct ip_addr *addr,
+		int client_port, int server_port, int count)
+{
+	int i;
+	for(i = 0; i < count; i++) {
+		if(add_port_guard(mnl_socket, addr, client_port + i, XFRM_POLICY_IN)
+				|| add_port_guard(
+						mnl_socket, addr, client_port + i, XFRM_POLICY_OUT)
+				|| add_port_guard(
+						mnl_socket, addr, server_port + i, XFRM_POLICY_IN)
+				|| add_port_guard(mnl_socket, addr, server_port + i,
+						XFRM_POLICY_OUT)) {
+			return -1;
+		}
+	}
+	return 0;
+}

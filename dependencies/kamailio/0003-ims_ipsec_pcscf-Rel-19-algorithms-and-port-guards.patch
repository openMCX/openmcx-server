-			s->r_alg.s, s->r_ealg.len, s->r_ealg.s);
+	used = snprintf(sec_hdr_buf, sizeof(sec_hdr_buf) - 1, "Security-Server: ");
+	for(i = 0; i < ipsec_alg_count; i++) {

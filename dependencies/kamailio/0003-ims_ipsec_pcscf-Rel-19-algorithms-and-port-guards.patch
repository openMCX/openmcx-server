+/* OpenMCX, 2026-10-25: TS 33.203 V19.1.0 clause 7.4.2a, the end of an old set (and of a temporary set after a
+ * failed authentication): "The old SAs are then deleted as soon as all pending SIP transactions have been
+ * completed, or have timed out" ("A SIP transaction is called pending if it was started using an old SA"), and
+ * "after processing the failure message, the PCSCF shall delete the new SAs". Each transaction that a request over
+ * a set started is counted on that set: a request from the UE on (UE address, port_uc), one to the UE from
+ * (port_pc). ipsec_destroy_when_idle() deletes a set once its count is 0; transactions that end later bring it to
+ * 0. The SA lifetime (contact expiry, ipsec_on_expire) still deletes a set in any case. */
+
+#define IPSEC_TXN_KEY_LEN 80
+
+static void ipsec_switch_on_inbound(struct sip_msg *msg);
+
+typedef struct ipsec_txn_count
+{
+	char key[IPSEC_TXN_KEY_LEN];
+	int count;
+	int draining; /* the set is being deleted: no new transaction may start on it */
+	struct ipsec_txn_count *next;
+} ipsec_txn_count_t;
+
+typedef struct ipsec_release
+{
+	udomain_t *d;
+	str uri;
+	str host;
+	int port;
+	char key_uc[IPSEC_TXN_KEY_LEN];
+	char key_pc[IPSEC_TXN_KEY_LEN];
+	int by_set; /* OpenMCX, 2026-10-25: the set of 'set', not a contact's */
+	spi_set_t set;
+	struct ipsec_release *next;
+} ipsec_release_t;
+
+/* What one transaction holds: the set it was started on (key_in) and the set its request went to the UE over. */
+typedef struct ipsec_txn_sets
+{
+	char key_in[IPSEC_TXN_KEY_LEN];
+	char key_out[IPSEC_TXN_KEY_LEN];
+} ipsec_txn_sets_t;
+
+static gen_lock_t *ipsec_txn_lock = NULL;
+static ipsec_txn_count_t **ipsec_txn_counts = NULL;
+static ipsec_release_t **ipsec_releases = NULL;
+
+static void ipsec_txn_key(char *key, char role, struct ip_addr *ip, unsigned short port)
+{
+	snprintf(key, IPSEC_TXN_KEY_LEN, "%c|%s|%u", role, ip_addr2a(ip), (unsigned)port);
+}
+
+static int ipsec_txn_key_str(char *key, char role, str *host, unsigned short port)
+{
+	struct ip_addr *ip = str2ip(host);
+	if(ip == NULL)
+		ip = str2ip6(host);
+	if(ip == NULL)
+		return -1;
+	ipsec_txn_key(key, role, ip, port);
+	return 0;
+}
+
+/* Under ipsec_txn_lock. */
+static ipsec_txn_count_t *ipsec_txn_find(const char *key, int create)
+{
+	ipsec_txn_count_t *c;
+	for(c = *ipsec_txn_counts; c; c = c->next) {
+		if(strcmp(c->key, key) == 0)
+			return c;
+	}
+	if(!create)
+		return NULL;
+	c = shm_malloc(sizeof(ipsec_txn_count_t));
+	if(c == NULL) {
+		SHM_MEM_ERROR;
+		return NULL;
+	}
+	memset(c, 0, sizeof(ipsec_txn_count_t));
+	strncpy(c->key, key, IPSEC_TXN_KEY_LEN - 1);
+	c->next = *ipsec_txn_counts;
+	*ipsec_txn_counts = c;
+	return c;
+}
+
+/* Under ipsec_txn_lock. */
+static void ipsec_txn_forget(ipsec_txn_count_t *gone)
+{
+	ipsec_txn_count_t **c;
+	for(c = ipsec_txn_counts; *c; c = &(*c)->next) {
+		if(*c == gone) {
+			*c = gone->next;
+			shm_free(gone);
+			return;
+		}
+	}
+}
+
+/* 1 if counted; 0 if the set is being deleted (the transaction started after the switch to the new set). */
+static int ipsec_txn_start(const char *key)
+{
+	ipsec_txn_count_t *c;
+	int counted = 0;
+	lock_get(ipsec_txn_lock);
+	c = ipsec_txn_find(key, 1);
+	if(c != NULL && !c->draining) {
+		c->count++;
+		counted = 1;
+	}
+	lock_release(ipsec_txn_lock);
+	if(!counted)
+		LM_WARN("transaction started on a set being deleted (%s)\n", key);
+	return counted;
+}
+
+static void ipsec_txn_end(const char *key)
+{
+	ipsec_txn_count_t *c;
+	if(key[0] == '\0')
+		return;
+	lock_get(ipsec_txn_lock);
+	c = ipsec_txn_find(key, 0);
+	if(c != NULL && c->count > 0) {
+		c->count--;
+		if(c->count == 0 && !c->draining)
+			ipsec_txn_forget(c);
+	}
+	lock_release(ipsec_txn_lock);
+}
+
+static void ipsec_txn_cb(struct cell *t, int type, struct tmcb_params *ps)
+{
+	ipsec_txn_sets_t *sets = (ipsec_txn_sets_t *)*ps->param;
+	struct ip_addr ip;
+	char key[IPSEC_TXN_KEY_LEN];
+
+	if(sets == NULL)
+		return;
+	if(type & TMCB_REQUEST_SENT) {
+		/* The first request of the transaction sent to the UE from a protected client port (port_pc). */
+		if(sets->key_out[0] != '\0' || ps->dst == NULL || ps->dst->send_sock == NULL
+				|| (ps->flags & TMCB_RETR_F)
+				|| !ipsec_protected_port(ps->dst->send_sock->port_no))
+			return;
+		su2ip_addr(&ip, &ps->dst->to);
+		ipsec_txn_key(key, 'p', &ip, ps->dst->send_sock->port_no);
+		if(ipsec_txn_start(key))
+			memcpy(sets->key_out, key, IPSEC_TXN_KEY_LEN);
+	}
+	if(type & TMCB_RESPONSE_IN) {
+		/* OpenMCX, 2026-10-25: TS 33.203 clause 7.4.2a, a response of the UE over the new set. */
+		ipsec_switch_on_inbound(ps->rpl);
+	}
+	if(type & TMCB_DESTROY) {
+		ipsec_txn_end(sets->key_in);
+		ipsec_txn_end(sets->key_out);
+	}
+}
+
+static void ipsec_txn_sets_free(void *param)
+{
+	if(param)
+		shm_free(param);
+}
+
+/* TMCB_REQUEST_IN: every new transaction; one from the UE on a protected server port is counted on its set. */
+static void ipsec_txn_in(struct cell *t, int type, struct tmcb_params *ps)
+{
+	struct sip_msg *req = ps->req;
+	ipsec_txn_sets_t *sets;
+
+	if(req == NULL || t == NULL)
+		return;
+	sets = shm_malloc(sizeof(ipsec_txn_sets_t));
+	if(sets == NULL) {
+		SHM_MEM_ERROR;
+		return;
+	}
+	memset(sets, 0, sizeof(ipsec_txn_sets_t));
+	if(ipsec_protected_port(req->rcv.dst_port)) {
+		/* OpenMCX, 2026-10-25: TS 33.203 clause 7.4.2a, a request of the UE over the new set; before its
+		 * transaction is counted, so that a request over the new set is counted on it. */
+		ipsec_switch_on_inbound(req);
+		ipsec_txn_key(sets->key_in, 'u', &req->rcv.src_ip, req->rcv.src_port);
+		if(!ipsec_txn_start(sets->key_in))
+			sets->key_in[0] = '\0';
+	}
+	if(tmb.register_tmcb(req, t, TMCB_REQUEST_SENT | TMCB_RESPONSE_IN | TMCB_DESTROY, ipsec_txn_cb, sets,
+			   ipsec_txn_sets_free)
+			<= 0) {
+		LM_ERR("cannot follow the transaction's security association\n");
+		ipsec_txn_end(sets->key_in);
+		shm_free(sets);
+	}
+}
+
+/* Under ipsec_txn_lock: 1 if neither key of the set has a transaction left. */
+static int ipsec_set_idle(const char *key_uc, const char *key_pc)
+{
+	ipsec_txn_count_t *uc = ipsec_txn_find(key_uc, 0);
+	ipsec_txn_count_t *pc = ipsec_txn_find(key_pc, 0);
+	return (uc == NULL || uc->count == 0) && (pc == NULL || pc->count == 0);
+}
+
+/* Under ipsec_txn_lock. */
+static void ipsec_set_forget(const char *key_uc, const char *key_pc)
+{
+	ipsec_txn_count_t *c;
+	if((c = ipsec_txn_find(key_uc, 0)) != NULL)
+		ipsec_txn_forget(c);
+	if((c = ipsec_txn_find(key_pc, 0)) != NULL)
+		ipsec_txn_forget(c);
+}
+
+/* OpenMCX, 2026-10-25: TS 33.203 V19.1.0 clause 7.4.2a, "The P-CSCF shall delete any SA whose lifetime is
+ * exceeded", and clause 7.3.1.1, "It shall delete the temporarily stored SA parameters associated with this
+ * registration after a time-out": a temporary set whose lifetime (ipsec_record_set()) is over is deleted, also one
+ * that no contact holds (a re-registration's). Called from the release timer, which polls (not a protocol timer). */
+static void ipsec_expire_temporary_sets(void)
+{
+	uint32_t cursor = 0;
+	spi_set_t r;
+	time_t now = time(NULL);
+
+	while(spi_set_next_temporary(&cursor, NULL, NULL, 0, now, &r)) {
+		LM_INFO("deleting the temporary security associations of port_uc %u: lifetime over\n", r.port_uc);
+		ipsec_destroy_set(&r);
+	}
+}
+
+static int ipsec_destroy_set_when_idle(const spi_set_t *r);
+
+/* Timer (a polling interval, not a protocol timer): deletes the released sets whose transactions have all ended. */
+static void ipsec_release_timer(unsigned int ticks, void *param)
+{
+	ipsec_release_t **r, *ready = NULL, *next;
+
+	lock_get(ipsec_txn_lock);
+	for(r = ipsec_releases; *r;) {
+		if(ipsec_set_idle((*r)->key_uc, (*r)->key_pc)) {
+			ipsec_release_t *done = *r;
+			*r = done->next;
+			ipsec_set_forget(done->key_uc, done->key_pc);
+			done->next = ready;
+			ready = done;
+		} else {
+			r = &(*r)->next;
+		}
+	}
+	lock_release(ipsec_txn_lock);
+	for(; ready; ready = next) {
+		next = ready->next;
+		if(ready->by_set) {
+			LM_INFO("deleting the security associations of port_uc %u (no pending transaction left)\n",
+					ready->set.port_uc);
+			ipsec_destroy_set(&ready->set);
+		} else {
+			LM_INFO("deleting the security associations of %.*s:%d (no pending transaction left)\n",
+					ready->host.len, ready->host.s, ready->port);
+			ipsec_destroy_by_contact(ready->d, &ready->uri, &ready->host, ready->port);
+		}
+		shm_free(ready);
+	}
+	ipsec_expire_temporary_sets();
+}
+
+/* OpenMCX, 2026-10-25: ipsec_destroy_when_idle() for a set known by its record (one no contact holds). */
+static int ipsec_destroy_set_when_idle(const spi_set_t *r)
+{
+	ipsec_release_t *release;
+	ipsec_txn_count_t *c;
+	int idle;
+
+	release = shm_malloc(sizeof(ipsec_release_t));
+	if(release == NULL) {
+		SHM_MEM_ERROR;
+		return IPSEC_CMD_FAIL;
+	}
+	memset(release, 0, sizeof(ipsec_release_t));
+	release->by_set = 1;
+	release->set = *r;
+	ipsec_txn_key(release->key_uc, 'u', &release->set.ue, r->port_uc);
+	ipsec_txn_key(release->key_pc, 'p', &release->set.ue, r->port_pc);
+
+	lock_get(ipsec_txn_lock);
+	if((c = ipsec_txn_find(release->key_uc, 1)) != NULL)
+		c->draining = 1;
+	if((c = ipsec_txn_find(release->key_pc, 1)) != NULL)
+		c->draining = 1;
+	idle = ipsec_set_idle(release->key_uc, release->key_pc);
+	if(idle) {
+		ipsec_set_forget(release->key_uc, release->key_pc);
+	} else {
+		release->next = *ipsec_releases;
+		*ipsec_releases = release;
+	}
+	lock_release(ipsec_txn_lock);
+	if(idle) {
+		ipsec_destroy_set(r);
+		shm_free(release);
+	}
+	return IPSEC_CMD_SUCCESS;
+}
+
+int ipsec_txn_init(void)
+{
+	ipsec_txn_lock = lock_alloc();
+	ipsec_txn_counts = shm_malloc(sizeof(ipsec_txn_count_t *));
+	ipsec_releases = shm_malloc(sizeof(ipsec_release_t *));
+	if(ipsec_txn_lock == NULL || ipsec_txn_counts == NULL || ipsec_releases == NULL) {
+		SHM_MEM_ERROR;
+		return -1;
+	}
+	lock_init(ipsec_txn_lock);
+	*ipsec_txn_counts = NULL;
+	*ipsec_releases = NULL;
+	if(tmb.register_tmcb(0, 0, TMCB_REQUEST_IN, ipsec_txn_in, 0, 0) <= 0) {
+		LM_ERR("cannot register the transaction callback\n");
+		return -1;
+	}
+	if(register_timer(ipsec_release_timer, 0, 1) < 0) {
+		LM_ERR("cannot register the release timer\n");
+		return -1;
+	}
+	return 0;
+}
+
+/* The set of the contact (uri, received_host, received_port) goes as soon as no transaction started on it is
+ * left (TS 33.203 clauses 7.4.2a); no new transaction is counted on it from now on. */
+int ipsec_destroy_when_idle(
+		udomain_t *_d, str *uri, str *received_host, int received_port)
+{
+	pcontact_t *pcontact = NULL;
+	pcontact_info_t search_ci;
+	sip_uri_t contact_uri;
+	ipsec_release_t *release;
+	ipsec_txn_count_t *c;
+	unsigned short port_uc = 0, port_pc = 0;
+	int idle;
+
+	memset(&search_ci, 0, sizeof(struct pcontact_info));
+	if(parse_uri(uri->s, uri->len, &contact_uri) != 0) {
+		LM_WARN("Failed to parse aor [%.*s]\n", uri->len, uri->s);
+		return IPSEC_CMD_FAIL;
+	}
+	search_ci.received_host = *received_host;
+	search_ci.received_port = received_port;
+	search_ci.received_proto = contact_uri.proto ? contact_uri.proto : PROTO_UDP;
+	search_ci.searchflag = SEARCH_RECEIVED;
+	search_ci.via_host = *received_host;
+	search_ci.via_port = received_port;
+	search_ci.via_prot = search_ci.received_proto;
+	search_ci.aor = *uri;
+	search_ci.reg_state = PCONTACT_ANY;
+	if(ul.get_pcontact(_d, &search_ci, &pcontact, 0) != 0) {
+		LM_ERR("Contact doesn't exist\n");
+		return IPSEC_CMD_FAIL;
+	}
+	ul.lock_udomain(_d, &pcontact->via_host, pcontact->via_port, pcontact->via_proto);
+	if(pcontact->security_temp != NULL && pcontact->security_temp->type == SECURITY_IPSEC
+			&& pcontact->security_temp->data.ipsec != NULL) {
+		port_uc = pcontact->security_temp->data.ipsec->port_uc;
+		port_pc = pcontact->security_temp->data.ipsec->port_pc;
+	}
+	ul.unlock_udomain(_d, &pcontact->via_host, pcontact->via_port, pcontact->via_proto);
+	if(port_uc == 0 && port_pc == 0) {
+		LM_ERR("No security parameters found in contact\n");
+		return IPSEC_CMD_FAIL;
+	}
+
+	release = shm_malloc(sizeof(ipsec_release_t) + uri->len + received_host->len);
+	if(release == NULL) {
+		SHM_MEM_ERROR;
+		return IPSEC_CMD_FAIL;
+	}
+	memset(release, 0, sizeof(ipsec_release_t));
+	release->d = _d;
+	release->uri.s = (char *)(release + 1);
+	memcpy(release->uri.s, uri->s, uri->len);
+	release->uri.len = uri->len;
+	release->host.s = release->uri.s + uri->len;
+	memcpy(release->host.s, received_host->s, received_host->len);
+	release->host.len = received_host->len;
+	release->port = received_port;
+	if(ipsec_txn_key_str(release->key_uc, 'u', received_host, port_uc) != 0
+			|| ipsec_txn_key_str(release->key_pc, 'p', received_host, port_pc) != 0) {
+		LM_ERR("bad received host %.*s\n", received_host->len, received_host->s);
+		shm_free(release);
+		return IPSEC_CMD_FAIL;
+	}
+
+	lock_get(ipsec_txn_lock);
+	if((c = ipsec_txn_find(release->key_uc, 1)) != NULL)
+		c->draining = 1;
+	if((c = ipsec_txn_find(release->key_pc, 1)) != NULL)
+		c->draining = 1;
+	idle = ipsec_set_idle(release->key_uc, release->key_pc);
+	if(idle) {
+		ipsec_set_forget(release->key_uc, release->key_pc);
+	} else {
+		release->next = *ipsec_releases;
+		*ipsec_releases = release;
+	}
+	lock_release(ipsec_txn_lock);
+
+	if(idle) {
+		LM_INFO("deleting the security associations of %.*s:%d (no pending transaction)\n",
+				received_host->len, received_host->s, received_port);
+		ipsec_destroy_by_contact(_d, uri, received_host, received_port);
+		shm_free(release);
+	} else {
+		LM_INFO("security associations of %.*s:%d go when their pending transactions end\n",
+				received_host->len, received_host->s, received_port);
+	}
+	return IPSEC_CMD_SUCCESS;
+}
+
+/* OpenMCX, 2026-10-25: TS 33.203 V19.1.0 clause 6.1.5: whether the request came over a set being deleted (the old
+ * set after a later successful authentication, or the set of a failed one), not one of "latest successful
+ * authentication": 1 if so, -1 otherwise. */
+int ipsec_set_released(struct sip_msg *m)
+{
+	char key[IPSEC_TXN_KEY_LEN];
+	ipsec_txn_count_t *c;
+	int released = 0;
+
+	if(!ipsec_protected_port(m->rcv.dst_port))
+		return -1;
+	ipsec_txn_key(key, 'u', &m->rcv.src_ip, m->rcv.src_port);
+	lock_get(ipsec_txn_lock);
+	c = ipsec_txn_find(key, 0);
+	released = c != NULL && c->draining;
+	lock_release(ipsec_txn_lock);
+	return released ? 1 : -1;
+}
+
+/* OpenMCX, 2026-10-25: TS 33.203 V19.1.0 clause 7.1 rule 3: "the pair (UE_IP_address, UE_protected_client_port) ...
+ * has not yet been associated with entries in the "SA_table"": 1 if no set of (received_host, received_port) is
+ * stored, or only the temporary one m came over (the REGISTER answering its own challenge, SM7, repeats its
+ * Security-Client), -1 if one is. The SA_table is the record of the sets (spi_gen.c), which also holds the sets of
+ * a re-registration that no contact holds. */
+int ipsec_sa_pair_free(struct sip_msg *m, udomain_t *_d, str *uri,
+		str *received_host, int received_port)
+{
+	struct ip_addr ue;
+	spi_set_t r;
+
+	if(str2ipxbuf(received_host, &ue) < 0) {
+		LM_ERR("bad address %.*s\n", received_host->len, received_host->s);
+		return -1;
+	}
+	if(!spi_set_find(&ue, received_port, &r)) {
+		return 1;
+	}
+	if(r.temporary && ipsec_protected_port(m->rcv.dst_port) && m->rcv.src_port == received_port
+			&& ip_addr_cmp(&m->rcv.src_ip, &ue)) {
+		return 1;
+	}
+	return -1;
+}
+
+/* OpenMCX, 2026-10-25: the end of a REGISTER transaction gives back an admission not turned into a set. */
+static void ipsec_resv_cb(struct cell *t, int type, struct tmcb_params *ps)
+{
+	spi_set_unreserve(t->hash_index, t->label);
+}
+
+/* OpenMCX, 2026-10-25: TS 33.203 V19.1.0 clause 7.1 rule 3: "Furthermore, the P-CSCF shall check that, for any one
+ * IMPI, no more than six SAs per direction are stored at any one time. If these checks are unsuccessful the
+ * registration is aborted and a suitable error message is sent to the UE." Three sets (IPSEC_MAX_SETS_PER_IMPI).
+ * The challenge of this REGISTER creates one set after deleting the registration SAs of its UE registration (clause
+ * 7.4.2a, ipsec_delete_registration_sets()); counted are the IMPI's sets that stay, over all its contacts (NOTE 13
+ * bounds each contact, rule 3 the IMPI): in use, old ones waiting for their pending transactions, temporary ones of
+ * other UE addresses, the temporary set m came over (it goes only once m's transaction has ended), and the
+ * admissions of other REGISTER transactions. Under the lock of the count, a free place is reserved for m's
+ * transaction (t_newtran() first): ipsec_create() consumes it with the set, the transaction's end gives it back
+ * otherwise. 1 if reserved, -1 if not (1 also when the IMPI is unknown and cannot be checked). */
+int ipsec_impi_reserve(struct sip_msg *m, str *impi)
+{
+	tm_cell_t *t;
+	int ret;
+
+	if(impi == NULL || impi->s == NULL || impi->len <= 0) {
+		LM_WARN("no private user identity: the security associations per IMPI are not checked\n");
+		return 1;
+	}
+	t = tmb.t_gett();
+	if(t == NULL || t == T_UNDEFINED) {
+		LM_ERR("no transaction (t_newtran() first)\n");
+		return -1;
+	}
+	ret = spi_set_reserve(impi, &m->rcv.src_ip, ipsec_protected_port(m->rcv.dst_port) ? m->rcv.src_port : 0,
+			t->hash_index, t->label, IPSEC_MAX_SETS_PER_IMPI);
+	if(ret < 0) {
+		LM_ERR("cannot reserve a set for %.*s\n", impi->len, impi->s);
+		return -1;
+	}
+	if(ret == 0) {
+		LM_WARN("%.*s would hold more than %d SAs per direction: no further set\n", impi->len, impi->s,
+				TS33203_MAX_SAS_PER_DIRECTION);
+		return -1;
+	}
+	if(tmb.register_tmcb(m, t, TMCB_DESTROY, ipsec_resv_cb, 0, 0) <= 0) {
+		LM_ERR("cannot follow the REGISTER transaction\n");
+		spi_set_unreserve(t->hash_index, t->label);
+		return -1;
+	}
+	return 1;
+}
+
+/* OpenMCX, 2026-10-25: TS 33.203 V19.1.0 clause 7.4.2a, after SM12 (the 200 (OK) of a REGISTER over a temporary
+ * set; from the REGISTER's onreply route): the set is completed, its temporary lifetime replaced by the
+ * registration's (the contact's expiry and grace, ipsec_on_expire(), as for any registered contact), and:
+ * "If there are old SAs, but SM1 belonging to the same registration procedure was received unprotected, the P-CSCF
+ * considers error cases happened, and assumes UE does not have those old SAs for use. In this case the P-CSCF shall
+ * remove the old SAs." - the other sets of the UE registration are deleted, the new set is used;
+ * "If SM1 belonging to the same registration procedure was protected with an old valid SA, the P-CSCF keeps this
+ * inbound SA and the corresponding three SAs created during the same registration with the UE active, and continues
+ * to use them. Any other old SAs are deleted." - outbound messages stay on that set until the UE's first message
+ * over the new set (ipsec_switch_on_inbound()) or that set's end. 1 if a temporary set was completed, -1
+ * otherwise. */
+int ipsec_set_completed(struct sip_msg *m)
+{
+	tm_cell_t *t = tmb.t_gett();
+	sip_msg_t *req;
+	spi_set_t y, x, o;
+	uint32_t cursor = 0;
+	int keep = 0;
+
+	if(t == NULL || t == T_UNDEFINED || t->uas.request == NULL) {
+		return -1;
+	}
+	req = t->uas.request;
+	if(!ipsec_protected_port(req->rcv.dst_port)
+			|| !spi_set_complete(&req->rcv.src_ip, req->rcv.src_port, &y)) {
+		return -1;
+	}
+	if(y.parent_uc != 0 && spi_set_find(&y.ue, y.parent_uc, &x) && !x.temporary) {
+		keep = 1;
+	}
+	while(spi_set_next_sibling(&cursor, &y.ue, y.port_uc, &o)) {
+		if(keep && o.port_uc == x.port_uc) {
+			continue;
+		}
+		LM_INFO("deleting the old security associations of port_uc %u (SM12 over port_uc %u)\n", o.port_uc,
+				y.port_uc);
+		ipsec_destroy_set(&o);
+	}
+	if(keep) {
+		spi_set_use_outbound(&x.ue, x.port_uc);
+		spi_set_wait_switch(&y.ue, y.port_uc);
+		LM_INFO("keeping the old security associations of port_uc %u until the UE's first message over port_uc "
+				"%u\n", x.port_uc, y.port_uc);
+	} else {
+		spi_set_use_outbound(&y.ue, y.port_uc);
+	}
+	return 1;
+}
+
+/* OpenMCX, 2026-10-25: TS 33.203 V19.1.0 clause 7.4.2a: "When the old SAs have only a short time left before
+ * expiring or a further SIP message protected with a new inbound SA is successfully received from the UE, the P-CSCF
+ * starts to use the new SAs for outbound messages ... The old SAs are then deleted as soon as all pending SIP
+ * transactions have been completed, or have timed out." msg, a request or response received from the UE: if it came
+ * over the inbound SA of a completed set that waits for this, the set is taken into use for outbound messages and
+ * the set used until now is deleted once its pending transactions are over (ipsec_destroy_set_when_idle()). The
+ * "short time left" trigger is not implemented: the text gives no value for it. */
+static void ipsec_switch_on_inbound(struct sip_msg *msg)
+{
+	spi_set_t y, old;
+
+	if(msg == NULL || msg == FAKED_REPLY || !ipsec_protected_port(msg->rcv.dst_port)) {
+		return;
+	}
+	if(!spi_set_find_inbound(&msg->rcv.src_ip, msg->rcv.src_port, msg->rcv.dst_port, &y) || !y.switch_pending) {
+		return;
+	}
+	if(!spi_set_outbound_of(&y.ue, y.port_uc, &old)) {
+		return;
+	}
+	spi_set_use_outbound(&y.ue, y.port_uc);
+	LM_INFO("the UE's first message over port_uc %u: outbound messages over it\n", y.port_uc);
+	if(old.port_uc != y.port_uc) {
+		ipsec_destroy_set_when_idle(&old);
+	}
+}
+
+/* OpenMCX, 2026-10-25: TS 33.203 V19.1.0 clause 7.1, "UDP case: ... The P-CSCF sends requests and responses
+ * protected with ESP to a UE on the port port_pc", to the UE's port_us, and clauses 7.4.1a/7.4.2a: "If SM1 was
+ * protected, the old SAs shall be used to protect the failure messages": the reply of the transaction of m (created
+ * by t_newtran()), a request received over a set, leaves from that set's port_pc to its port_us, as ipsec_forward()
+ * sends the responses it relays. Over TCP the reply goes on the connection the request came on (TS 24.229 clause
+ * 5.2.2.2 NOTE 3), nothing is changed. 1 on success, -1 otherwise. */
+int ipsec_reply_over_sa(struct sip_msg *m)
+{
+	tm_cell_t *t;
+	spi_set_t r;
+	struct socket_info *sock;
+	str *listen;
+
+	if(!ipsec_protected_port(m->rcv.dst_port)) {
+		return -1;
+	}
+	if(m->rcv.proto != PROTO_UDP) {
+		return 1;
+	}
+	t = tmb.t_gett();
+	if(t == NULL || t == T_UNDEFINED) {
+		LM_ERR("no transaction (t_newtran() first)\n");
+		return -1;
+	}
+	if(!spi_set_find(&m->rcv.src_ip, m->rcv.src_port, &r)) {
+		LM_ERR("no security associations of the request's source\n");
+		return -1;
+	}
+	listen = m->rcv.src_ip.af == AF_INET6 ? &ipsec_listen_addr6 : &ipsec_listen_addr;
+	sock = grep_sock_info(listen, r.port_pc, PROTO_UDP);
+	if(sock == NULL) {
+		LM_ERR("no UDP socket on the protected client port %u\n", r.port_pc);
+		return -1;
+	}
+	init_su(&t->uas.response.dst.to, &m->rcv.src_ip, r.port_us);
+	t->uas.response.dst.send_sock = sock;
+	t->uas.response.dst.proto = PROTO_UDP;
+	return 1;
+}

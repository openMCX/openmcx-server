+	/* OpenMCX, 2026-10-25: TS 33.203 V19.1.0 clause 7.1: "The SPIs selected by the PCSCF shall be different than the
+	 * SPIs sent by the UE": a pair colliding with spi_uc or spi_us is given back and another taken (twice at most,
+	 * the pool cycling through other values). */
+	int tries;
+	for(tries = 0; tries < 3; tries++) {
+		if(acquire_spi(&s->spi_pc, &s->spi_ps, &s->port_pc, &s->port_ps) == 0) {
+			LM_ERR("Error generating client SPI for IPSEC tunnel creation\n");
+			shm_free(s->ck.s);
+			s->ck.s = NULL;
+			s->ck.len = 0;
+			shm_free(s->ik.s);
+			s->ik.s = NULL;
+			s->ik.len = 0;
+			return -1;
+		}
+		if(s->spi_pc != s->spi_uc && s->spi_pc != s->spi_us
+				&& s->spi_ps != s->spi_uc && s->spi_ps != s->spi_us)
+			break;
+		release_spi(s->spi_pc, s->spi_ps, s->port_pc, s->port_ps);
+		s->spi_pc = s->spi_ps = 0;
+	}
+	if(s->spi_pc == 0) {
+		LM_ERR("No P-CSCF SPIs different from the UE's\n");
 		return -1;
 	}
 
+	/* OpenMCX, 2026-10-25: TS 33.203 V19.1.0 clause 7.4.0: "the protected server ports at the UE (port_us) and the
+	 * PCSCF (port_ps) shall remain unchanged, while the protected client ports ... shall change": a new set of a
+	 * re-registration keeps the port_ps of the set in use (current); every protected port is a listening socket
+	 * shared by the UEs, the SAs' selectors telling them apart. */
+	if(current && current->port_ps) {
+		s->port_ps = current->port_ps;
+	}
+
 	return 0;
 }
 

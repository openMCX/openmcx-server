+	sr_SHA256_Update(&ctx, pad, 64);
+	sr_SHA256_Update(&ctx, s, 3 + p0_len);
+	sr_SHA256_Final(inner, &ctx);
+	for(i = 0; i < 64; i++)
+		pad[i] = k[i] ^ 0x5c;

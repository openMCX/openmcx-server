+ * the core SHA-256), for the key expansion of TS 33.203 V19.1.0 annex I; key at most 64 octets. */
+static void ims_kdf(const unsigned char *key, int key_len, unsigned char fc,
+		const char *p0, unsigned char out[32])
+{
+	unsigned char k[64], pad[64], inner[32], s[64];
+	int p0_len = strlen(p0), i;
+	SHA256_CTX ctx;

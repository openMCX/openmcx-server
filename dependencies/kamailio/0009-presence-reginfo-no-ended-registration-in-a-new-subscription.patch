+++ b/src/modules/pua_reginfo/api.h
@@ -0,0 +1,33 @@
+/*
+ * pua_reginfo module - the current registration document of an
+ * address-of-record, for presence_reginfo
+ *
+ * Copyright (C) 2026 OpenMCX
+ *
+ * This file is part of Kamailio, a free SIP server.
+ *
+ * SPDX-License-Identifier: GPL-2.0-or-later

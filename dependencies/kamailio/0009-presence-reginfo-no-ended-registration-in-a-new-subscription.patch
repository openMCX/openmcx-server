 };
 
@@ -104,6 +109,7 @@ static param_export_t params[] = {
 	{"outbound_proxy", PARAM_STR, &outbound_proxy},
 	{"server_address", PARAM_STR, &server_address},
 	{"publish_reginfo", PARAM_INT, &publish_reginfo},
+	{"usrloc_domain", PARAM_STR, &usrloc_domain},
 	{0, 0, 0}
 };
 
@@ -346,13 +352,21 @@ static void rpc_deregister(rpc_t *rpc, void *ctx)
 	record = rpc_record(rpc, ctx, &table, &aor, &domain);
 	if(record == NULL)
 		return;
+	/* One document, every contact terminated with the event, then the
+	 * contacts are removed without one document each: back-to-back PUBLISHes
+	 * carried the same entity tag, the second was refused 412 and sent again
+	 * as an initial publication, which left the presence module two
+	 * presentities of the address-of-record (RFC 3903 section 4.3). */
 	reginfo_event_override =
 			event.s[0] == 'd' ? "deactivated" : "rejected";
+	reginfo_usrloc_cb(record->contacts, UL_CONTACT_DELETE, NULL);
+	reginfo_event_override = NULL;
+	pua_reginfo_update_self_op(1);
 	for(c = record->contacts; c; c = next) {
 		next = c->next;
 		ul.delete_ucontact(record, c);
 	}
-	reginfo_event_override = NULL;
+	pua_reginfo_update_self_op(0);
 	ul.release_urecord(record);
 	ul.unlock_udomain(domain, &aor);
 	rpc->rpl_printf(ctx, "deregistered");
diff --git a/src/modules/pua_reginfo/usrloc_cb.c b/src/modules/pua_reginfo/usrloc_cb.c
index 79e205a..7fb90bd 100644
--- a/src/modules/pua_reginfo/usrloc_cb.c
+++ b/src/modules/pua_reginfo/usrloc_cb.c

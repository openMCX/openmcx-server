+ * Added by OpenMCX on 2026-11-26 (GPL-2.0 section 2(a)).
+ */
+
+#ifndef _PUA_REGINFO_API_H
+#define _PUA_REGINFO_API_H
+
+#include "../../core/str.h"
+
+/* The reginfo document of the contacts the registrar holds for a presentity
+ * URI, every contact "active" with the event "registered" (RFC 3680 section
+ * 4.7.1), the version attribute the placeholder "00000000000" of
+ * presence_reginfo's aggregated bodies; NULL when the AOR has no valid
+ * contact. The body is pkg memory, its text freed with xmlFree(). */
+typedef str *(*reginfo_current_body_f)(str *pres_uri);
+
+typedef struct pua_reginfo_api
+{
+	reginfo_current_body_f current_body;
+} pua_reginfo_api_t;
+
+typedef int (*bind_pua_reginfo_f)(pua_reginfo_api_t *api);
+
+#endif
diff --git a/src/modules/pua_reginfo/pua_reginfo.c b/src/modules/pua_reginfo/pua_reginfo.c
index b713aa2..e51222f 100644
--- a/src/modules/pua_reginfo/pua_reginfo.c
+++ b/src/modules/pua_reginfo/pua_reginfo.c
@@ -22,6 +22,8 @@
  * along with this program; if not, write to the Free Software
  * Foundation, Inc., 51 Franklin Street, Fifth Floor, Boston, MA  02110-1301  USA
  *
+ * Modified by OpenMCX on 2026-11-26 (GPL-2.0 section 2(a)): reginfo.deregister publishes one document for all the

  * Modified by OpenMCX on 2026-10-31 (GPL-2.0 section 2(a)): the reginfo document follows RFC 3680 (a contact added by
@@ -38,6 +40,7 @@
 #include <libxml/parser.h>
 #include "../pua/pua.h"
 #include "../pua/send_publish.h"
+#include "../../core/parser/parse_uri.h"
 
 /*
 Contact: <sip:carsten@10.157.87.36:44733;transport=udp>;expires=600000;+g.oma.sip-im;language="en,fr";+g.3gpp.smsip;+g.oma.sip-im.large-message;audio;+g.3gpp.icsi-ref="urn%3Aurn-7%3A3gpp-application.ims.iari.gsma-vs";+g.3gpp.cs-voice.
@@ -452,3 +455,102 @@ error:
 
 	return;
 }
+
+/*!
+ * \brief The reginfo document of the contacts the registrar holds for the
+ * address-of-record of pres_uri (usrloc domain usrloc_domain), every contact
+ * "active" with the event "registered", the version the placeholder of
+ * presence_reginfo; NULL when it has no valid contact (pua_reginfo/api.h).
+ * TS 24.229 clause 5.4.2.1.2: a NOTIFY has "the state information of all
+ * registered public user identities of the user" (full state); RFC 3680
+ * section 4.7.1: the registration is "active" while a contact is bound.
+ */
+str *reginfo_current_body(str *pres_uri)
+{
+	static const char placeholder[] = "version=\"00000000000\"";
+	struct sip_uri puri;
+	udomain_t *domain = NULL;
+	urecord_t *record = NULL;
+	ucontact_t *c;
+	str aor = {0, 0}, uri = {0, 0};
+	str *body = NULL, *out = NULL;
+	char *version;
+	time_t now = time(0);
+	int valid = 0;
+
+	if(pres_uri == NULL || pres_uri->s == NULL || pres_uri->len <= 0
+			|| parse_uri(pres_uri->s, pres_uri->len, &puri) < 0
+			|| puri.user.len <= 0)
+		return NULL;
+	if(ul.get_udomain(usrloc_domain.s, &domain) < 0)
+		return NULL;
+	aor.len = puri.user.len + 1 + puri.host.len;
+	aor.s = (char *)pkg_malloc(aor.len + 1);
+	uri.s = (char *)pkg_malloc(pres_uri->len + 1);
+	if(aor.s == NULL || uri.s == NULL)
+		goto done;
+	memcpy(aor.s, puri.user.s, puri.user.len);
+	aor.s[puri.user.len] = '@';
+	memcpy(aor.s + puri.user.len + 1, puri.host.s, puri.host.len);
+	aor.s[aor.len] = '\0';
+	memcpy(uri.s, pres_uri->s, pres_uri->len);
+	uri.s[pres_uri->len] = '\0';
+	uri.len = pres_uri->len;
+
+	ul.lock_udomain(domain, &aor);
+	if(ul.get_urecord(domain, &aor, &record) == 0 && record) {
+		for(c = record->contacts; c; c = c->next)
+			if(VALID_CONTACT(c, now))
+				valid++;
+		if(valid > 0) {
+			reginfo_event_override = "registered";
+			body = build_reginfo_full(
+					record, uri, record->contacts, UL_CONTACT_INSERT);
+			reginfo_event_override = NULL;
+		}
+		ul.release_urecord(record);
+	}
+	ul.unlock_udomain(domain, &aor);
+	if(body == NULL || body->s == NULL)
+		goto done;
+
+	/* the version attribute of build_reginfo_full() is "0" */
+	version = strstr(body->s, "version=\"0\"");
+	if(version == NULL)
+		goto done;
+	out = (str *)pkg_malloc(sizeof(str));
+	if(out == NULL)
+		goto done;
+	out->len = body->len + (int)sizeof(placeholder) - 1 - 11;
+	out->s = (char *)xmlMalloc(out->len + 1);
+	if(out->s == NULL) {
+		pkg_free(out);
+		out = NULL;
+		goto done;
+	}
+	memcpy(out->s, body->s, version - body->s);
+	memcpy(out->s + (version - body->s), placeholder, sizeof(placeholder) - 1);
+	memcpy(out->s + (version - body->s) + sizeof(placeholder) - 1,
+			version + 11, body->len - (version - body->s) - 11);
+	out->s[out->len] = '\0';
+
+done:
+	if(body) {
+		if(body->s)
+			xmlFree(body->s);
+		pkg_free(body);
+	}
+	if(aor.s)
+		pkg_free(aor.s);
+	if(uri.s)
+		pkg_free(uri.s);
+	return out;
+}
+
+int bind_pua_reginfo(pua_reginfo_api_t *api)
+{
+	if(api == NULL)
+		return -1;
+	api->current_body = reginfo_current_body;
+	return 0;
+}

@@ -49,6 +51,8 @@ pua_api_t pua;	 /*!< Structure containing pointers to PUA functions*/
 /* Default domain to be added, if none provided. */
 str default_domain = {NULL, 0};
 str outbound_proxy = {NULL, 0};
+/* the usrloc domain (table) of reginfo_current_body() */
+str usrloc_domain = str_init("location");
 str server_address = {NULL, 0};
 
 int publish_reginfo = 1;
@@ -96,6 +100,7 @@ static cmd_export_t cmds[] = {
 		domain_fixup, 0, REQUEST_ROUTE},
 	{"reginfo_disable_publish", (cmd_function)w_reginfo_disable_publish, 0,
 		0, 0, REQUEST_ROUTE},
+	{"bind_pua_reginfo", (cmd_function)bind_pua_reginfo, 1, 0, 0, 0},

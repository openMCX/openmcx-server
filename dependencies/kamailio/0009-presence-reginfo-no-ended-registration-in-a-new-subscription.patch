From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: OpenMCX <noreply@openmcx.invalid>
Date: Thu, 26 Nov 2026 12:00:00 +0100
Subject: [PATCH] presence, pua_reginfo: the first NOTIFY of a new reg event
 subscription has the current registration state

After a network-initiated deregistration (reginfo.deregister, "rejected" or
"deactivated") the presence module kept the terminated document as the
presentity of the address-of-record. When the user registered again, the
UE's SUBSCRIBE (sent as soon as the 200 (OK) to the REGISTER arrived) was
handled before pua_reginfo's PUBLISH of the new contact was committed. The
presence module answered a PUBLISH and sent its NOTIFYs before it ended the
publication's transaction. So the first NOTIFY of the new subscription
carried the old binding, terminated with the event "rejected". Because every
registration of that document was terminated, the NOTIFY also ended the new
subscription (patch 0004, is_final_body).

- presence ps_db_update_presentity(): a new or updated publication is
  committed before its 200 (OK) and before publ_notify(). A subscription
  stored before the watchers are read gets the NOTIFY of the publication.
  One stored after reads the committed publication for its first NOTIFY.
  Before, a SUBSCRIBE handled between the NOTIFYs and the commit read the old
  state and missed the publication's NOTIFY.
- presence ps_db_update_presentity(): once a PUBLISH whose body the event
  declares final (is_final_body: every registration of a reginfo document
  terminated) has been notified, its presentity is removed (database and
  hash table). RFC 3680 section 4.7.1: from "terminated" the registration
  "immediately transitions back to the init state". TS 24.229 clause
  5.4.2.1.2: a NOTIFY carries the state of the registered public user
  identities. The publisher's next PUBLISH with the old entity tag gets 412,
  and pua sends it again as an initial publication (RFC 3903 section 6).
- presence_reginfo: the first document sent to a subscriber, and the
  document when no presentity is stored, has the registrar's current
  contacts (every contact "active", event "registered"), from pua_reginfo's
  new reginfo_current_body (bind_pua_reginfo, pua_reginfo/api.h; parameter
  usrloc_domain, default "location"). TS 24.229 clause 5.4.2.1.2: a NOTIFY
  has "the state information of all registered public user identities of
  the user". The registrar saves the contact before it answers the
  REGISTER, so the first NOTIFY has the new contact even while pua_reginfo's
  PUBLISH of that REGISTER is not yet stored. A final document (every
  registration terminated) is kept as it is: it reports the end of the
  registration.
- pua_reginfo rpc_deregister(): one document with every contact terminated
  and the event, then the contacts are removed without a document each.
  Before, the back-to-back PUBLISHes of a deregistration of several contacts
  carried the same entity tag. The second was refused 412 and sent again as
  an initial publication, which left two presentities of the
  address-of-record.

The modified files carry a notice of the change (GPL-2.0 section 2(a)).
---
diff --git a/src/modules/presence/presentity.c b/src/modules/presence/presentity.c
index ae1b6c6..7925a52 100644
--- a/src/modules/presence/presentity.c
+++ b/src/modules/presence/presentity.c
@@ -19,6 +19,11 @@
  * along with this program; if not, write to the Free Software
  * Foundation, Inc., 51 Franklin Street, Fifth Floor, Boston, MA  02110-1301  USA
  *
+ * Modified by OpenMCX on 2026-11-26 (GPL-2.0 section 2(a)): a PUBLISH whose body the event declares final
+ * (is_final_body) has its presentity removed once its NOTIFYs are sent, so that a later subscription's first NOTIFY
+ * does not carry the ended state (RFC 3680 section 4.7.1); a new or updated publication is committed before its 200 (OK)
+ * and its NOTIFYs (ps_db_commit_publication).
+ *
  */
 
 /*!
@@ -656,6 +661,26 @@ int ps_match_dialog_state(presentity_t *presentity, char *vstate)
 	}
 }
 
+/* The transaction of a new or updated publication ends before the 200 (OK)
+ * and before the NOTIFYs of publ_notify(): a subscription stored before the
+ * watchers are read then gets the NOTIFY of the publication, and one stored
+ * after reads the committed publication for its first NOTIFY. Committed after
+ * them, a SUBSCRIBE handled in between read the state before the publication
+ * and missed its NOTIFY (TS 24.229 clause 5.4.2.1.2: the reg event NOTIFY
+ * after a REGISTER did not have the new registration). *committed is set; the
+ * caller then does not end the transaction again. */
+static int ps_db_commit_publication(int *committed)
+{
+	if(*committed || !pa_dbf.end_transaction)
+		return 0;
+	if(pa_dbf.end_transaction(pa_db) < 0) {
+		LM_ERR("in end_transaction\n");
+		return -1;
+	}
+	*committed = 1;
+	return 0;
+}
+
 static int ps_db_update_presentity(sip_msg_t *msg, presentity_t *presentity,
 		str *body, int new_t, int *sent_reply, char *sphere, str *etag_override,
 		str *ruid, int replace, int skip_notify)
@@ -684,6 +709,7 @@ static int ps_db_update_presentity(sip_msg_t *msg, presentity_t *presentity,
 	char *old_dialog_id = NULL, *dialog_id = NULL;
 	str cur_ruid = {0, 0};
 	str p_ruid = {0, 0};
+	int committed = 0;
 
 	if(sent_reply)
 		*sent_reply = 0;
@@ -880,6 +906,10 @@ static int ps_db_update_presentity(sip_msg_t *msg, presentity_t *presentity,
 			}
 		}
 
+		/* the publication is committed before it is answered and notified:
+		 * see ps_db_commit_publication() */
+		if(ps_db_commit_publication(&committed) < 0)
+			goto error;
 		if(publ_send200ok(msg, presentity->expires, presentity->etag) < 0) {
 			LM_ERR("sending 200OK\n");
 			goto error;
@@ -1307,6 +1337,10 @@ static int ps_db_update_presentity(sip_msg_t *msg, presentity_t *presentity,
 			goto send_412;
 
 		/* send 200OK */
+		/* the publication is committed before it is answered and notified:
+		 * see ps_db_commit_publication() */
+		if(ps_db_commit_publication(&committed) < 0)
+			goto error;
 		if(publ_send200ok(msg, presentity->expires, cur_etag) < 0) {
 			LM_ERR("sending 200OK reply\n");
 			goto error;
@@ -1335,6 +1369,35 @@ send_notify:
 		}
 	}
 
+	/* A body the event declares final (every registration of a reginfo
+	 * document terminated) has been notified to the watchers and ended their
+	 * subscriptions: the publication is then removed, so that the first
+	 * NOTIFY of a later subscription does not carry this ended state (RFC
+	 * 3680 section 4.7.1: from "terminated" the registration "immediately
+	 * transitions back to the init state"; TS 24.229 clause 5.4.2.1.2: the
+	 * NOTIFY carries the state of the registered public user identities). The
+	 * publisher's next PUBLISH with this entity tag gets 412 and is sent again
+	 * as an initial publication (RFC 3903 section 6). */
+	if(body && body->s && body->len > 0 && presentity->event->is_final_body
+			&& presentity->event->is_final_body(body) == 1) {
+		presentity_t ended = *presentity;
+
+		if(cur_etag.s)
+			ended.etag = cur_etag;
+		if(delete_presentity(&ended, p_ruid.s ? &p_ruid : NULL) < 0) {
+			LM_ERR("deleting the ended presentity\n");
+			goto error;
+		}
+		if(publ_cache_mode == PS_PCACHE_HYBRID
+				&& delete_phtable(&pres_uri, presentity->event->evp->type)
+						   < 0) {
+			LM_ERR("deleting the ended presentity from hash table\n");
+			goto error;
+		}
+		LM_DBG("ended presentity %.*s removed\n", presentity->user.len,
+				presentity->user.s);
+	}
+
 done:
 
 	if(pres_enable_dmq > 0 && pres_enable_pres_dmq > 0 && p_ruid.s != NULL) {
@@ -1361,7 +1424,7 @@ done:
 		pres_uri.s = NULL;
 	}
 
-	if(pa_dbf.end_transaction) {
+	if(pa_dbf.end_transaction && !committed) {
 		if(pa_dbf.end_transaction(pa_db) < 0) {
 			LM_ERR("in end_transaction\n");
 			goto error;
diff --git a/src/modules/presence_reginfo/notify_body.c b/src/modules/presence_reginfo/notify_body.c
index 13587e2..9f07e66 100644
--- a/src/modules/presence_reginfo/notify_body.c
+++ b/src/modules/presence_reginfo/notify_body.c
@@ -29,6 +29,9 @@
  * registration is terminated is the final NOTIFY of the subscription (TS 24.229 clause 5.4.2.1.2: "When sending a final
  * NOTIFY request with all <registration> element(s) having their state attribute set to "terminated" ... the S-CSCF
  * shall also terminate the subscription").
+ * Modified by OpenMCX on 2026-11-26 (GPL-2.0 section 2(a)): the first document sent to a subscriber, and a document
+ * when no presentity is stored, has the registrar's current contacts (pua_reginfo's reginfo_current_body): the
+ * stored presentity can lag the registrar (TS 24.229 clause 5.4.2.1.2, full state).
  */
 
 /*! \file
@@ -45,10 +48,35 @@
 #include "../../core/mem/mem.h"
 #include "../presence/hash.h"
 #include "../presence/presence.h"
+#include "../../core/sr_module.h"
+#include "../pua_reginfo/api.h"
 
 
 str *aggregate_xmls(str *pres_user, str *pres_domain, str **body_array, int n);
 
+/* pua_reginfo's current registration document, when that module is loaded */
+static reginfo_current_body_f reginfo_current_body = NULL;
+static int reginfo_current_body_bound = 0;
+
+/*!
+ * \brief The registrar's current document of a presentity URI (RFC 3680
+ * section 4.7.1, TS 24.229 clause 5.4.2.1.2), NULL without pua_reginfo or
+ * without a valid contact
+ */
+static str *reginfo_registrar_body(str *pres_uri)
+{
+	bind_pua_reginfo_f bind;
+	pua_reginfo_api_t api;
+
+	if(!reginfo_current_body_bound) {
+		reginfo_current_body_bound = 1;
+		bind = (bind_pua_reginfo_f)find_export("bind_pua_reginfo", 1, 0);
+		if(bind && bind(&api) == 0)
+			reginfo_current_body = api.current_body;
+	}
+	return reginfo_current_body ? reginfo_current_body(pres_uri) : NULL;
+}
+
 void free_xml_body(char *body)
 {
 	if(body == NULL)
@@ -66,8 +94,19 @@ str *reginfo_agg_nbody(str *pres_user, str *pres_domain, str **body_array,
 	LM_DBG("[pres_user]=%.*s [pres_domain]= %.*s, [n]=%d\n", pres_user->len,
 			pres_user->s, pres_domain->len, pres_domain->s, n);
 
-	if(body_array == NULL) {
-		return NULL;
+	if(body_array == NULL || n == 0) {
+		/* no stored presentity (none yet, or the ended one removed): the
+		 * registrar's contacts, if it has any */
+		char uri_buf[512];
+		str pres_uri;
+
+		pres_uri.len = snprintf(uri_buf, sizeof(uri_buf), "sip:%.*s@%.*s",
+				pres_user->len, pres_user->s, pres_domain->len,
+				pres_domain->s);
+		if(pres_uri.len <= 0 || pres_uri.len >= (int)sizeof(uri_buf))
+			return NULL;
+		pres_uri.s = uri_buf;
+		return reginfo_registrar_body(&pres_uri);
 	}
 
 	n_body = aggregate_xmls(pres_user, pres_domain, body_array, n);
@@ -238,7 +277,7 @@ error:
 	return NULL;
 }
 
-str *reginfo_body_setversion(subs_t *subs, str *body)
+static str *reginfo_body_setversion_doc(subs_t *subs, str *body)
 {
 	char *version_start = 0;
 	char version[MAX_INT_LEN + 2]; /* +2 because of trailing " and \0 */
@@ -350,3 +389,25 @@ int reginfo_is_final_body(str *body)
 	xmlFreeDoc(doc);
 	return registrations > 0 && registrations == terminated;
 }
+
+/*!
+ * \brief The document for one subscriber, its version set (RFC 3680 section
+ * 5.1). The first document sent to the subscriber is the registrar's state
+ * (full state, TS 24.229 clause 5.4.2.1.2): the stored presentity can still be
+ * the one before a REGISTER whose PUBLISH is not yet stored. A final document
+ * (every registration terminated) is kept: it reports the end of the
+ * registration.
+ */
+str *reginfo_body_setversion(subs_t *subs, str *body)
+{
+	str *current = NULL, *versioned;
+
+	if(subs->version <= 1 && body && !reginfo_is_final_body(body))
+		current = reginfo_registrar_body(&subs->pres_uri);
+	if(current == NULL)
+		return reginfo_body_setversion_doc(subs, body);
+	versioned = reginfo_body_setversion_doc(subs, current);
+	free_xml_body(current->s);
+	pkg_free(current);
+	return versioned;
+}

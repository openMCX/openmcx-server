+					   == 0) {
 		if(max_nonce_reuse > 0 && av->status == AUTH_VECTOR_SENT) {
 			/* first use of a reusable vector */
 			/* set the vector's new timeout */
@@ -1152,7 +1184,7 @@ int ims_authenticate(struct sip_msg *msg, str *prealm, int is_proxy_auth)
 		}
 		ret = AUTH_OK;
 
-		if(add_authinfo_hdr

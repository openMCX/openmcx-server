@@ -178,7 +194,7 @@ static inline int ims_auth_hexbin(
 			LM_ERR("invalid char in hex value (%s)\n", fname);
 			return -1;
 		}
-		if((r % 2) == 1) {
+		if((i % 2) == 1) {
 			obin[j] = r;
 			r = 0;
 			j++;
@@ -203,7 +219,7 @@ int ims_auth_data_set(str *pk, str *pop, str *pop_c, str *pamf)
 	if(ret < 0) {
 		return -1;
 	}
-	if(ret == 1) {
+	if(ret == 0) {
 		_ims_auth_data.flags |= IMS_AUTH_FLAG_OPC_SET;
 	}
 
@@ -907,8 +923,10 @@ int ims_authenticate(struct sip_msg *msg, str *prealm, int is_proxy_auth)
 	unsigned int aud_hash = 0;
 	str realm;
 	str private_identity, public_identity, username;
-	str nonce, response16, nc, cnonce, qop_str = {0, 0}, auts = {0, 0}, body,
-									   *next_nonce = &empty_s;

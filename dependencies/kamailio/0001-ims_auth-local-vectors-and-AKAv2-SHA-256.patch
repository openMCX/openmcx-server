@@ -1296,6 +1328,7 @@ auth_vector *get_auth_vector(str private_identity, str public_identity,
 		av = av->next;
 	}
 	if(ims_auth_av_mode == 1 && status == AUTH_VECTOR_UNUSED) {
+		sqn_increment(aud->sqn);
 		if(_ims_auth_data.flags & IMS_AUTH_FLAG_OPC_SET) {
 			av = auth_vector_make_local(_ims_auth_data.k, _ims_auth_data.op_c,
 					1, _ims_auth_data.amf, aud->sqn);
@@ -1304,12 +1337,14 @@ auth_vector *get_auth_vector(str private_identity, str public_identity,
 					_ims_auth_data.amf, aud->sqn);
 		}
 		if(av) {
-			sqn_increment(aud->sqn);
 			av->next = aud->head;
 			if(aud->head) {
 				aud->head->prev = av;
-				aud->head = av;
+			} else {
+				aud->tail = av;
 			}
+			aud->head = av;
+			*hash = aud->hash;
 			return av;
 		}
 	}
@@ -1596,6 +1631,7 @@ auth_userdata *new_auth_userdata(str private_identity, str public_identity)
 		LM_ERR("error allocating mem\n");
 		goto done;
 	}
+	memset(x, 0, sizeof(auth_userdata));
 
 	x->private_identity.len = private_identity.len;
 	x->private_identity.s = shm_malloc(private_identity.len);
@@ -1851,6 +1887,11 @@ int pack_challenge(
 			/* AKA */
 			ck_len = bin_to_base16(av->ck.s, 16, ck);
 			ik_len = bin_to_base16(av->ik.s, 16, ik);
+			if(aka_v2_sha256 && av->type == AUTH_AKAV1_MD5
+					&& !pack_challenge_aka(msg, auth_prefix, realm, av,
+							&S_AKAv2_SHA256, ck, ck_len, ik, ik_len, qop)) {
+				goto error;
+			}
 			x.len = S_Authorization_AKA.len + auth_prefix->len + realm.len
 					+ av->authenticate.len + algorithm_types[av->type].len
 					+ ck_len + ik_len + qop.len;
@@ -1910,6 +1951,108 @@ error:
 	return 0;
 }
 
+/**
+ * Adds a WWW-Authenticate header field of the vector with the given algorithm: TS 33.203
+ * clause 6.1.1, the S-CSCF offers "AKAv2-SHA-256" first, then "AKAv1-MD5", with one
+ * vector (the same nonce).
+ */
+static int pack_challenge_aka(struct sip_msg *msg, str *auth_prefix, str realm,
+		auth_vector *av, str *algorithm, char *ck, int ck_len, char *ik,
+		int ik_len, str qop)
+{
+	str x = {0, 0};
+
+	x.len = S_Authorization_AKA.len + auth_prefix->len + realm.len
+			+ av->authenticate.len + algorithm->len + ck_len + ik_len + qop.len;
+	x.s = pkg_malloc(x.len);
+	if(!x.s) {
+		LM_ERR("Error allocating %d bytes\n", x.len);
+		return 0;
+	}
+	sprintf(x.s, S_Authorization_AKA.s, auth_prefix->len, auth_prefix->s,
+			realm.len, realm.s, av->authenticate.len, av->authenticate.s,
+			algorithm->len, algorithm->s, ck_len, ck, ik_len, ik, qop.len, qop.s);
+	x.len = strlen(x.s);
+	if(ims_add_header_rpl(msg, &x)) {
+		pkg_free(x.s);
+		return 1;
+	}
+	pkg_free(x.s);
+	return 0;
+}
+
+/**
+ * HTTP Digest AKAv2 with SHA-256 (RFC 4169 section 3, TS 33.203 clause 6.1.1): the
+ * password is base64(HMAC-SHA-256(RES || IK || CK, "http-digest-akav2-password")) and
+ * the response the SHA-256 digest of RFC 7616 section 3.4.1 (qop "auth" or
+ * "auth-int"), as lower-case hex in expected (65 bytes).
+ */
+static void calc_akav2_sha256_response(str *username, str *realm,
+		auth_vector *av, str *nonce, str *nc, str *cnonce, str *qop,
+		int auth_int, str *method, str *uri, str *body, char *expected)
+{
+	static const char label[] = "http-digest-akav2-password";
+	unsigned char key[64], pad[64], inner[32], digest[32];
+	char password[48], ha1[65], ha2[65], hbody[65];
+	SHA256_CTX ctx;
+	int key_len = 0, password_len, i;
+
+	/* HMAC-SHA-256 (RFC 2104) keyed with RES || IK || CK */
+	memset(key, 0, sizeof(key));
+	memcpy(key, av->authorization.s, av->authorization.len);
+	key_len = av->authorization.len;
+	memcpy(key + key_len, av->ik.s, 16);
+	memcpy(key + key_len + 16, av->ck.s, 16);
+	for(i = 0; i < 64; i++)
+		pad[i] = key[i] ^ 0x36;
+	sr_SHA256_Init(&ctx);
+	sr_SHA256_Update(&ctx, pad, 64);
+	sr_SHA256_Update(&ctx, (const uint8_t *)label, sizeof(label) - 1);
+	sr_SHA256_Final(inner, &ctx);
+	for(i = 0; i < 64; i++)
+		pad[i] = key[i] ^ 0x5c;
+	sr_SHA256_Init(&ctx);
+	sr_SHA256_Update(&ctx, pad, 64);
+	sr_SHA256_Update(&ctx, inner, 32);
+	sr_SHA256_Final(digest, &ctx);
+	password_len = bin_to_base64((char *)digest, 32, password);
+
+#define AKAV2_SHA256(out, ...)                                              \
+	do {                                                                    \
+		str parts[] = {__VA_ARGS__};                                        \
+		unsigned int p;                                                     \
+		sr_SHA256_Init(&ctx);                                               \
+		for(p = 0; p < sizeof(parts) / sizeof(parts[0]); p++) {             \
+			if(p)                                                           \
+				sr_SHA256_Update(&ctx, (const uint8_t *)":", 1);            \
+			sr_SHA256_Update(                                               \
+					&ctx, (const uint8_t *)parts[p].s, parts[p].len);       \
+		}                                                                   \
+		sr_SHA256_Final(digest, &ctx);                                      \
+		bin_to_base16((char *)digest, 32, out);                             \
+		out[64] = '\0';                                                     \
+	} while(0)
+
+	AKAV2_SHA256(ha1, *username, *realm, ((str){password, password_len}));
+	if(auth_int) {
+		sr_SHA256_Init(&ctx);
+		sr_SHA256_Update(&ctx, (const uint8_t *)body->s, body->len);
+		sr_SHA256_Final(digest, &ctx);
+		bin_to_base16((char *)digest, 32, hbody);
+		hbody[64] = '\0';
+		AKAV2_SHA256(ha2, *method, *uri, ((str){hbody, 64}));
+	} else {
+		AKAV2_SHA256(ha2, *method, *uri);
+	}
+	if(qop->len) {
+		AKAV2_SHA256(expected, ((str){ha1, 64}), *nonce, *nc, *cnonce, *qop,
+				((str){ha2, 64}));
+	} else {
+		AKAV2_SHA256(expected, ((str){ha1, 64}), *nonce, ((str){ha2, 64}));
+	}
+#undef AKAV2_SHA256
+}
+
 /**
  * Adds the Authentication-Info header for, based on the credentials sent by a successful REGISTER.
  * @param msg - SIP message to add the header to

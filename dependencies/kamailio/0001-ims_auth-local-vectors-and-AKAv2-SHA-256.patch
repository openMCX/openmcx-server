+++ b/src/modules/ims_auth/auth_vector.c
@@ -1,4 +1,8 @@
 /*
+ * Modified by OpenMCX on 2026-10-23 (GPL-2.0 section 2(a)): a fresh SQN per vector
+ * (SEQ and IND, TS 33.102 annex C.1.1.2 and C.1.2), and the resynchronisation's RAND
+ * decoded from the nonce and its MAC-S with the all-zero AMF (TS 33.102 clause 6.3.3).
+ *
  * Copyright (C) 2024 Dragos Vingarzan (neatpath.net)
  *
  * This file is part of Kamailio, a free SIP server.
@@ -23,6 +27,7 @@
 #include "auth_vector.h"
 
 #include "milenage.h"
+#include "conversion.h"
 
 #include "../../core/mem/shm_mem.h"
 
@@ -86,11 +91,13 @@ int auth_vector_resync_local(uint8_t sqnMSout[6], auth_vector *av,
 		uint8_t amf[2])
 {
 	uint8_t rand[16];
+	uint8_t authenticate[64];
 	uint8_t op_c[16];
 	uint8_t ak[6];
 	uint8_t sqnMS[6];
 	uint8_t mac_s[8];
 	uint8_t xmac_s[8];
+	uint8_t amf_star[2] = {0, 0};
 
 	int i = 0;
 
@@ -100,13 +107,16 @@ int auth_vector_resync_local(uint8_t sqnMSout[6], auth_vector *av,
 		return -1;
 	}
 
-	// Extract RAND from the sent authenticate
-	if(av->authenticate.len < 16 + 6 + 2 + 8) {
+	// Extract RAND from the sent authenticate, the base64 nonce of RAND || AUTN
+	if(av->authenticate.len > 4 * sizeof(authenticate) / 3
+			|| base64_to_bin(av->authenticate.s, av->authenticate.len,
+					   (char *)authenticate)
+					   < 16 + 6 + 2 + 8) {
 		LM_ERR("auth_vector authenticate len %d is too short\n",
 				av->authenticate.len);
 		return -1;
 	}
-	memcpy(rand, av->authenticate.s, 16);
+	memcpy(rand, authenticate, 16);
 
 	// Compute OPc from K and OP, if not already provided
 	if(opIsOPc == 0)
@@ -123,7 +133,7 @@ int auth_vector_resync_local(uint8_t sqnMSout[6], auth_vector *av,
 	memcpy(mac_s, auts + 6, 8);
 
 	// Compute XMAC-S
-	f1star(xmac_s, k, op_c, rand, sqnMS, amf);
+	f1star(xmac_s, k, op_c, rand, sqnMS, amf_star);
 
 	// Check if MAC-S == XMAC-S
 	if(memcmp(mac_s, xmac_s, 8) != 0) {
@@ -137,15 +147,20 @@ int auth_vector_resync_local(uint8_t sqnMSout[6], auth_vector *av,
 	return 0;
 }
 
+// The next fresh SQN = SEQ || IND (5-bit IND): SEQ + 1 and the next IND
+// (TS 33.102 annex C.1.1.2 and C.1.2), so that each vector is fresh for the USIM.
 void sqn_increment(uint8_t sqn[6])
 {
-	int i = 0;
+	uint64_t value = 0;
+	uint64_t seq, ind;
+	int i;
+	for(i = 0; i < 6; i++)
+		value = (value << 8) | sqn[i];
+	seq = ((value >> 5) + 1) & ((1ULL << 43) - 1);
+	ind = ((value & 0x1F) + 1) & 0x1F;
+	value = (seq << 5) | ind;
 	for(i = 5; i >= 0; i--) {
-		if(sqn[i] == 0xFF) {
-			sqn[i] = 0;
-		} else {
-			sqn[i]++;
-			return;
-		}
+		sqn[i] = value & 0xFF;
+		value >>= 8;
 	}
 }

 /* authentication vectors mode: 0 - diameter/hss; 1 - local */
 int ims_auth_av_mode = 0;
 
+/* 1: offer HTTP Digest AKAv2-SHA-256 before AKAv1-MD5 (TS 33.203 clause 6.1.1) */

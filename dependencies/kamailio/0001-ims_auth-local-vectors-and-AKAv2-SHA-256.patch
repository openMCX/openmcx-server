+	akav2 = aka_v2_sha256 && alg.len == S_AKAv2_SHA256.len
+			&& strncasecmp(alg.s, S_AKAv2_SHA256.s, alg.len) == 0;
 
 	/* first, look for an already used vector (if nonce reuse is enabled) */
 	if(max_nonce_reuse > 0) {
@@ -1061,6 +1082,15 @@ int ims_authenticate(struct sip_msg *msg, str *prealm, int is_proxy_auth)
 
 	switch(av->type) {
 		case AUTH_AKAV1_MD5:
+			if(akav2) {
+				calc_akav2_sha256_response(&username, &realm, av, &nonce, &nc,

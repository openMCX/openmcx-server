+
 static int w_ims_auth_data_set(
 		sip_msg_t *msg, char *_k, char *_op, char *_op_c, char *_amf);
 static int w_ims_auth_data_reset(sip_msg_t *msg, char *_p1, char *_p2);
@@ -182,6 +188,7 @@ static param_export_t params[] = {{"name", PARAM_STR, &scscf_name_str},
 	{"av_request_at_once", PARAM_INT, &av_request_at_once},
 	{"av_request_at_sync", PARAM_INT, &av_request_at_sync},
 	{"av_mode", PARAM_INT, &ims_auth_av_mode},
+	{"aka_v2_sha256", PARAM_INT, &aka_v2_sha256},
 	{"registration_default_algorithm", PARAM_STR, &registration_default_algorithm},
 	{"registration_qop", PARAM_STR, &registration_qop},
 	{"invite_qop", PARAM_STR, &invite_qop},
@@ -427,7 +434,8 @@ static int w_ims_auth_data_set(
 	}
 
 
-	return ims_auth_data_set(&k, &op, &op_c, &amf);
+	/* 0 would end the script: 1 on success, -1 on error */
+	return ims_auth_data_set(&k, &op, &op_c, &amf) == 0 ? 1 : -1;
 }
 
 static int w_ims_auth_data_reset(sip_msg_t *msg, char *_p1, char *_p2)
diff --git a/src/modules/ims_auth/milenage.c b/src/modules/ims_auth/milenage.c
index da8e9fb..f713445 100644
--- a/src/modules/ims_auth/milenage.c
+++ b/src/modules/ims_auth/milenage.c
@@ -1,3 +1,7 @@
+/*
+ * Modified by OpenMCX on 2026-10-23 (GPL-2.0 section 2(a)): RAND from the kernel's
+ * random source, a fresh one per vector (TS 33.102 clause 6.3.2).

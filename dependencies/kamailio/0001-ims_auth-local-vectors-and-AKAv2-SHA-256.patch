@@ -967,7 +985,7 @@ int ims_authenticate(struct sip_msg *msg, str *prealm, int is_proxy_auth)
 	}
 
 	if(!get_nonce_response(msg, &username, realm, &nonce, &response16, &qop,
-			   &qop_str, &nc, &cnonce, &uri, is_proxy_auth)
+			   &qop_str, &nc, &cnonce, &uri, &alg, is_proxy_auth)
 			|| !nonce.len || !response16.len) {
 		LM_DBG("Nonce or response missing: nonce len [%i], response16 "
 			   "len[%i]\n",
@@ -979,6 +997,9 @@ int ims_authenticate(struct sip_msg *msg, str *prealm, int is_proxy_auth)
 		body = ims_get_body(msg);
 		calc_H(&body, hbody);

+/* A reg event subscription to make again (TS 24.229 clause 5.2.3), copied out of its expired record. */
+typedef struct reg_resubscribe
+{
+	str pres_uri, watcher_uri, contact, outbound_proxy, extra_headers, id;
+	int event, flag;
+	unsigned int expires;
+	void *cb_param;
+	struct reg_resubscribe *next;
+} reg_resubscribe_t;
+
+static reg_resubscribe_t *reg_resubscribe_copy(ua_pres_t *p)
+{
+	reg_resubscribe_t *r;
+	int size = sizeof(reg_resubscribe_t) + p->pres_uri->len + p->watcher_uri->len + p->contact.len + p->id.len
+			   + (p->outbound_proxy ? p->outbound_proxy->len : 0)
+			   + (p->extra_headers ? p->extra_headers->len : 0);
+	char *at;
+
+	r = (reg_resubscribe_t *)pkg_malloc(size);
+	if(r == NULL) {
+		PKG_MEM_ERROR;
+		return NULL;
+	}
+	memset(r, 0, size);
+	at = (char *)r + sizeof(reg_resubscribe_t);
+#define REG_COPY(field, src)                    \
+	do {                                        \
+		r->field.s = at;                        \
+		memcpy(at, (src).s, (src).len);         \
+		r->field.len = (src).len;               \
+		at += (src).len;                        \
+	} while(0)
+	REG_COPY(pres_uri, *p->pres_uri);
+	REG_COPY(watcher_uri, *p->watcher_uri);
+	REG_COPY(contact, p->contact);
+	if(p->id.s)
+		REG_COPY(id, p->id);
+	if(p->outbound_proxy && p->outbound_proxy->s)
+		REG_COPY(outbound_proxy, *p->outbound_proxy);
+	if(p->extra_headers && p->extra_headers->s)
+		REG_COPY(extra_headers, *p->extra_headers);
+#undef REG_COPY
+	r->event = p->event;
+	r->flag = p->flag;
+	r->expires = p->reg_requested;
+	r->cb_param = p->cb_param;
+	return r;
+}
+
+/* TS 24.229 clause 5.2.3: after its last known expiry a new initial subscription; sent with no hash lock held. */
+static void reg_resubscribe_send(reg_resubscribe_t *list)
+{
+	reg_resubscribe_t *r;
+	subs_info_t subs;
+
+	while(list) {
+		r = list;
+		list = list->next;
+		memset(&subs, 0, sizeof(subs_info_t));
+		subs.pres_uri = &r->pres_uri;
+		subs.watcher_uri = &r->watcher_uri;
+		subs.contact = &r->contact;
+		subs.id = r->id;
+		if(r->outbound_proxy.s)
+			subs.outbound_proxy = &r->outbound_proxy;
+		if(r->extra_headers.s)
+			subs.extra_headers = &r->extra_headers;
+		subs.event = r->event;
+		subs.source_flag = r->flag;
+		subs.flag = INSERT_TYPE;
+		subs.expires = r->expires;
+		subs.cb_param = r->cb_param;
+		LM_INFO("reg event subscription to %.*s expired after a failed refresh: subscribing again\n",
+				r->pres_uri.len, r->pres_uri.s);
+		if(send_subscribe(&subs) < 0)
+			LM_ERR("while sending the new reg event SUBSCRIBE\n");
+		pkg_free(r);
+	}
+}
+
+/* TS 24.229 clause 5.2.3: a reg event subscription is refreshed "600 seconds before the expiration time if the initial
+ * subscription was for greater than 1200 seconds, or when half of the time has expired if the initial subscription was
+ * for 1200 seconds or less" (the duration granted; refresh_before until it is known, e.g. after a restore). */
+static int refresh_lead(ua_pres_t *p)
+{
+	if(p->reg_requested && p->reg_granted)
+		return p->reg_granted > 1200 ? 600 : (int)(p->reg_granted / 2);
+	return refresh_before >= 0 ? refresh_before : update_period;
+}
+
 static void hashT_clean(unsigned int ticks, void *param)
 {
 	int i;
 	time_t now;
 	ua_pres_t *p = NULL, *q = NULL;
+	reg_resubscribe_t *again = NULL, *r;
 
 	if(dbmode == PUA_DB_ONLY) {
 		clean_puadb(update_period, min_expires);
@@ -634,13 +729,28 @@ static void hashT_clean(unsigned int ticks, void *param)
 		p = HashT->p_records[i].entity->next;
 		while(p) {
 			print_ua_pres(p);
-			if(p->expires - (refresh_before >= 0 ? refresh_before : update_period)
-					< now) {
+			if(p->reg_requested && p->reg_refresh_failed) {
+				/* TS 24.229 clause 5.2.3: valid "for the duration of the most recently known "Expires" value",
+				 * no further refresh; then a new initial subscription */
+				if(p->expires < now) {
+					q = p->next;
+					if((r = reg_resubscribe_copy(p)) != NULL) {
+						r->next = again;
+						again = r;
+					}
+					delete_htable(p, i);
+					p = q;
+				} else
+					p = p->next;
+				continue;
+			}
+			if(p->expires - refresh_lead(p) < now) {
 				if((p->desired_expires > p->expires + min_expires)
 						|| (p->desired_expires == 0)) {
 					if(update_pua(p) < 0) {
 						LM_ERR("while updating record\n");
 						lock_release(&HashT->p_records[i].lock);
+						reg_resubscribe_send(again);
 						return;
 					}
 					p = p->next;
@@ -659,6 +769,7 @@ static void hashT_clean(unsigned int ticks, void *param)
 		}
 		lock_release(&HashT->p_records[i].lock);
 	}
+	reg_resubscribe_send(again);
 }
 
 int update_pua(ua_pres_t *p)
@@ -670,7 +781,10 @@ int update_pua(ua_pres_t *p)
 	int ret_code = 0;
 	dlg_t *td = NULL;
 
-	if(p->desired_expires == 0)
+	if(p->reg_requested)
+		/* TS 24.229 clause 5.2.3: the refresh asks for the subscription's duration again */
+		expires = p->reg_requested;
+	else if(p->desired_expires == 0)
 		expires = pua_default_expires;
 	else
 		expires = p->desired_expires - (int)time(NULL);

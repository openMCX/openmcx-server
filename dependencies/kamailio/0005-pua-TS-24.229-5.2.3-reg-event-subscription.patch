 {
 	struct sip_msg *msg = NULL;
@@ -307,6 +331,13 @@ void subs_cback_func(struct cell *t, int cb_type, struct tmcb_params *ps)
 		goto error;
 	}
 
+	if(msg == FAKED_REPLY && hentity->reg_requested && hentity->to_tag.len > 0) {
+		/* TS 24.229 clause 5.2.3: no answer to a refresh is a non-481 failure */
+		LM_INFO("reg event refresh unanswered: valid until its expiry\n");
+		reg_refresh_failed(hentity, hash_code);
+		goto done;
+	}
+
 	if(msg == FAKED_REPLY) {
 		struct hdr_field *callid = NULL, *from = NULL;
 		struct to_body FROM = {0};
@@ -423,6 +454,13 @@ void subs_cback_func(struct cell *t, int cb_type, struct tmcb_params *ps)
 		hentity->to_tag = pto->tag_value;
 	}
 
+	if(ps->code >= 300 && hentity->reg_requested && ps->code != 481) {
+		/* TS 24.229 clause 5.2.3: a refresh failed with a non-481 response */
+		LM_INFO("reg event refresh failed with %d: valid until its expiry\n", ps->code);
+		reg_refresh_failed(hentity, hash_code);
+		goto done;
+	}
+
 	if(ps->code
 			>= 300) { /* if an error code and a stored dialog delete it and try to send
 		   a subscription with type= INSERT_TYPE, else return*/
@@ -448,10 +486,15 @@ void subs_cback_func(struct cell *t, int cb_type, struct tmcb_params *ps)
 		subs.watcher_uri = hentity->watcher_uri;
 		subs.contact = &hentity->contact;
 
-		if(hentity->remote_contact.s)
+		/* a new initial reg event SUBSCRIBE goes to the default public user identity (TS 24.229 clause 5.2.3 item a)),

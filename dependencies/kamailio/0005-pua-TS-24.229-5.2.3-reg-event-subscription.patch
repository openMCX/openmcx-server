 	if(subs->id.s) {
 		CONT_COPY(hentity, hentity->id, subs->id);
@@ -856,6 +920,11 @@ ua_pres_t *subs_cbparam_indlg(ua_pres_t *subs, int expires, int ua_flag)
 		hentity->desired_expires = 0;
 	else

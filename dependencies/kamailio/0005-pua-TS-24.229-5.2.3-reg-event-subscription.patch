+			presentity->reg_granted = lexpire;
+			presentity->reg_refresh_failed = 0;
+		}
 		lock_release(&HashT->p_records[hash_code].lock);
 	}
 }
 
+/* TS 24.229 clause 5.2.3: "If a SUBSCRIBE request to refresh a subscription fails with a non-481 response, the P-CSCF
+ * shall still consider the original subscription valid for the duration of the most recently known "Expires" value":
+ * the record stays, and hashT_clean makes a new initial subscription once it expires. */
+static void reg_refresh_failed(ua_pres_t *dialog, int hash_code)
+{
+	ua_pres_t *presentity;
+
+	if(dbmode == PUA_DB_ONLY)
+		return;
+	lock_get(&HashT->p_records[hash_code].lock);
+	presentity = get_dialog(dialog, hash_code);
+	if(presentity != NULL)
+		presentity->reg_refresh_failed = 1;
+	lock_release(&HashT->p_records[hash_code].lock);
+}
+

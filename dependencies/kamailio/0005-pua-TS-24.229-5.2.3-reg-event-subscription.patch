 			subs.remote_target = &hentity->remote_contact;
 
-		if(hentity->desired_expires == 0)
+		if(hentity->reg_requested)
+			/* TS 24.229 clause 5.2.3, a 481: "start a new initial subscription" */
+			subs.expires = hentity->reg_requested;
+		else if(hentity->desired_expires == 0)
 			subs.expires = -1;
 		else if(hentity->desired_expires < (int)time(NULL))
 			subs.expires = 0;
@@ -529,6 +572,8 @@ void subs_cback_func(struct cell *t, int cb_type, struct tmcb_params *ps)
 
 	if(hentity->extra_headers)
 		size += sizeof(str) + hentity->extra_headers->len * sizeof(char);
+	if(hentity->reg_requested && hentity->outbound_proxy && hentity->outbound_proxy->s)
+		size += sizeof(str) + hentity->outbound_proxy->len * sizeof(char);
 
 	presentity = (ua_pres_t *)shm_malloc(size);
 	if(presentity == NULL) {
@@ -599,6 +644,17 @@ void subs_cback_func(struct cell *t, int cb_type, struct tmcb_params *ps)
 		size += hentity->extra_headers->len;

# This computer's IPv4 address on the Wi-Fi, which the phones reach (as in tutorial 1).
HOST_IP=
# openMCX images from Docker Hub (empty prefix: locally built images).
OPENMCX_IMAGE_PREFIX=openmcx/
OPENMCX_TAG=v1
ADMIN_TAG=v1
KAMAILIO_TAG=6.1.4-2
# OAI: the patched PCF, SMF and UPF built from openMCX/oai-mcx-setup (scripts/build-images.sh full), the other core
# functions and the gNB and nr-UE from Docker Hub.
PCF_IMG=oai-pcf:mcx-n5
SMF_IMG=oai-smf:mcx-n5
UPF_IMG=oai-upf:mcx-n5
CN_TAG=v2.2.1
RAN_TAG=2026.w39
